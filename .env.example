# =============================================================================
# CONFIGURAÇÃO DO AMBIENTE — copie este arquivo para .env e preencha os valores
# =============================================================================
#
# MÚLTIPLOS AMBIENTES NO MESMO SERVIDOR
# Para rodar teste e produção no mesmo servidor, crie uma pasta por ambiente,
# defina COMPOSE_PROJECT_NAME diferente em cada .env e use portas diferentes.
#
# Exemplo:
#   /srv/pharmazap-test/  → COMPOSE_PROJECT_NAME=pharmazap-test  API_HOST_PORT=6001  WEB_HOST_PORT=9080
#   /srv/pharmazap-prod/  → COMPOSE_PROJECT_NAME=pharmazap-prod  API_HOST_PORT=5001  WEB_HOST_PORT=8080

# Nome do projeto Docker Compose (prefixo dos containers — mude por ambiente)
COMPOSE_PROJECT_NAME=pharmazap-test

# =============================================================================
# PORTAS DO HOST (mude por ambiente para evitar conflito)
# =============================================================================
# Porta externa em que a API ficará acessível no host (HTTPS)
API_HOST_PORT=6001
# Porta externa em que a API ficará acessível no host (HTTP — necessária para webhook da Meta/WhatsApp)
API_HTTP_HOST_PORT=6000
# Porta externa em que o Web ficará acessível no host
WEB_HOST_PORT=9080

# =============================================================================
# BANCO DE DADOS PostgreSQL
# =============================================================================
POSTGRES_USER=pharmazap
POSTGRES_PASSWORD=<senha-segura-aqui>
# Senha do PostgreSQL dedicado ao Evolution Go (WhatsApp não oficial)
EVOGO_POSTGRES_PASSWORD=<senha-forte-aqui>
# Nome do banco — deve corresponder exatamente ao nome criado no PostgreSQL (case-sensitive no Linux)
POSTGRES_DB=pharmazaptest

# Host do PostgreSQL.
# - PostgreSQL instalado localmente no host (recomendado para este ambiente):
#   POSTGRES_HOST=host.docker.internal
#   O serviço api no docker-compose.yml já inclui extra_hosts: host.docker.internal:host-gateway
# - Se usar outro host remoto, informe o IP ou hostname aqui.
POSTGRES_HOST=host.docker.internal
# Porta do PostgreSQL (padrão: 5432)
POSTGRES_PORT=5432

# =============================================================================
# AMBIENTE ASP.NET CORE
# =============================================================================
# Valores válidos: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET=<chave-secreta-minimo-32-caracteres>
JWT_ISSUER=http://<IP_DA_VM>:6001
JWT_AUDIENCE=http://<IP_DA_VM>:9080
# ATENÇÃO: Após configurar SSL/HTTPS com domínio, substituir http:// por https://

# =============================================================================
# CORS — Origens adicionais (acesso por IP sem DNS configurado)
# =============================================================================
# Use estas variáveis para permitir acesso ao sistema via IP direto ou domínios
# extras, sem precisar alterar o código-fonte.
#
# Exemplo para acesso via IP direto (sem DNS):
#   CORS_ADDITIONAL_ORIGIN_0=http://<IP_DA_VM>:9080
#   CORS_ADDITIONAL_ORIGIN_1=http://<IP_DA_VM>:6001

# =============================================================================
# WhatsApp (Meta Business API)
# =============================================================================
WHATSAPP_TOKEN=<token-da-meta>
WHATSAPP_PHONE_NUMBER_ID=<id-do-numero>
WHATSAPP_VERIFY_TOKEN=<token-de-verificacao-webhook>

# =============================================================================
# URLs da aplicação (usadas internamente pela API e nos links gerados)
# =============================================================================
API_BASE_URL=http://<IP_DA_VM>:6001
WEB_BASE_URL=http://<IP_DA_VM>:9080
WEBHOOK_BASE_URL=http://<IP_DA_VM>:6001
