@using PharmazapPlus.Web.Services

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">

    <!-- Farmácia Header -->
    <FluentCard Style="padding: 1.25rem; background: var(--accent-fill-rest);">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
            <FluentIcon Icon="@(Icons.Regular.Size24.Building)" Color="Color.Fill" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">
                    @Data.Farmacia.Nome
                </FluentLabel>
                <FluentLabel Typo="Typography.Body">
                    Período: @Data.Periodo.Inicio.ToString("dd/MM/yyyy") — @Data.Periodo.Fim.ToString("dd/MM/yyyy")
                </FluentLabel>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <!-- Summary Cards -->
    <FluentGrid Spacing="3" Justify="JustifyContent.FlexStart">
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.Chat)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Total Atendimentos</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@Data.Resumo.TotalAtendimentos</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.CheckmarkCircle)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Taxa de Conversão</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@($"{Data.Resumo.TaxaConversao:F1}%")</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.Clock)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Tempo Médio (min)</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@($"{Data.Resumo.TempoMedioSegundos / 60.0:F1}")</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.PeopleCommunity)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Clientes Ativos</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@Data.Resumo.TotalClientes</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.People)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Atendentes Ativos</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@Data.Resumo.TotalAtendentes</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>

    <!-- Attendant Performance Table -->
    <FluentCard Style="padding: 1.5rem;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size20.People)" Color="Color.Accent" />
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Desempenho dos Atendentes</FluentLabel>
                <FluentBadge Appearance="Appearance.Neutral">@Data.Atendentes.Count atendentes</FluentBadge>
            </FluentStack>

            @if (Data.Atendentes.Any())
            {
                <FluentDataGrid Items="@Data.Atendentes.AsQueryable()" ResizableColumns="true" Style="width: 100%;">
                    <TemplateColumn Title="Atendente">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                            <FluentLabel Weight="FontWeight.Bold">@context.Nome</FluentLabel>
                            @if (!context.Ativo)
                            {
                                <FluentBadge Appearance="Appearance.Neutral">Inativo</FluentBadge>
                            }
                        </FluentStack>
                    </TemplateColumn>
                    <PropertyColumn Property="@(a => a.TotalAtendimentos)" Title="Total" Sortable="true" Align="Align.Center" />
                    <PropertyColumn Property="@(a => a.AtendimentosFinalizados)" Title="Finalizados" Sortable="true" Align="Align.Center" />
                    <PropertyColumn Property="@(a => a.AtendimentosEmAndamento)" Title="Em Andamento" Sortable="true" Align="Align.Center" />
                    <TemplateColumn Title="Conversão" Align="Align.Center">
                        <FluentBadge Appearance="@GetTaxaBadgeAppearance(context.TaxaConversao)">
                            @($"{context.TaxaConversao:F1}%")
                        </FluentBadge>
                    </TemplateColumn>
                    <TemplateColumn Title="Tempo Médio" Align="Align.Center">
                        @($"{context.TempoMedioSegundos / 60.0:F1} min")
                    </TemplateColumn>
                </FluentDataGrid>
            }
            else
            {
                <FluentLabel Style="color: var(--neutral-foreground-hint);">Nenhum atendente encontrado no período.</FluentLabel>
            }
        </FluentStack>
    </FluentCard>

    <!-- Trend Section -->
    @if (Data.TendenciaAtendimentos.Any())
    {
        <FluentCard Style="padding: 1.5rem;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <FluentIcon Icon="@(Icons.Regular.Size20.ChartMultiple)" Color="Color.Accent" />
                    <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Tendência de Atendimentos</FluentLabel>
                </FluentStack>
                <FluentDataGrid Items="@Data.TendenciaAtendimentos.AsQueryable()" Style="width: 100%;">
                    <PropertyColumn Property="@(t => t.Data)" Title="Data" />
                    <PropertyColumn Property="@(t => t.Quantidade)" Title="Atendimentos" Align="Align.Center" />
                    <TemplateColumn Title="Barra">
                        @{
                            var max = Data.TendenciaAtendimentos.Max(t => t.Quantidade);
                            var pct = max > 0 ? (double)context.Quantidade / max * 100 : 0;
                        }
                        <div style="background: var(--accent-fill-rest); height: 12px; border-radius: 4px; width: @($"{pct:F0}%"); min-width: 4px;"></div>
                    </TemplateColumn>
                </FluentDataGrid>
            </FluentStack>
        </FluentCard>
    }

</FluentStack>

@code {
    [Parameter, EditorRequired]
    public RelatorioAdministradorData Data { get; set; } = default!;

    private static Appearance GetTaxaBadgeAppearance(double taxa) =>
        taxa >= 70 ? Appearance.Accent : taxa >= 40 ? Appearance.Neutral : Appearance.Lightweight;
}
