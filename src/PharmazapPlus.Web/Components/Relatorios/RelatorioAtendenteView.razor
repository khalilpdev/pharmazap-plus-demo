@using PharmazapPlus.Web.Services

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">

    <!-- Summary Cards -->
    <FluentGrid Spacing="3" Justify="JustifyContent.FlexStart">
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.Chat)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Meus Atendimentos</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@Data.Resumo.TotalAtendimentos</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.CheckmarkCircle)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Finalizados</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@Data.Resumo.AtendimentosFinalizados</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.ArrowSync)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Em Andamento</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@Data.Resumo.AtendimentosEmAndamento</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.AlertBadge)" Color="Color.Warning" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Pendentes na Fila</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--warning-fill-rest);">@Data.Resumo.AtendimentosPendentes</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard Style="padding: 1.25rem; height: 100%;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentIcon Icon="@(Icons.Regular.Size20.Clock)" Color="Color.Accent" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Tempo Médio</FluentLabel>
                    </FluentStack>
                    <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@($"{Data.Resumo.TempoMedioSegundos / 60.0:F1} min")</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>

    <!-- Attendance History Table -->
    <FluentCard Style="padding: 1.5rem;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size20.History)" Color="Color.Accent" />
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Histórico de Atendimentos</FluentLabel>
                <FluentBadge Appearance="Appearance.Neutral">@Data.Historico.Count registros</FluentBadge>
            </FluentStack>

            @if (Data.Historico.Any())
            {
                <FluentDataGrid Items="@_paginatedHistorico" Pagination="@_pagination" ResizableColumns="true" Style="width: 100%;">
                    <PropertyColumn Property="@(h => h.Id)" Title="ID" Sortable="true" Align="Align.Center" />
                    <PropertyColumn Property="@(h => h.ClienteNome)" Title="Cliente" Sortable="true" />
                    <PropertyColumn Property="@(h => h.Canal)" Title="Canal" Sortable="true" Align="Align.Center" />
                    <TemplateColumn Title="Início">
                        @context.DataInicio.ToLocalTime().ToString(Consts.Formato.DataHora)
                    </TemplateColumn>
                    <TemplateColumn Title="Fim">
                        @(context.DataFim.HasValue ? context.DataFim.Value.ToLocalTime().ToString(Consts.Formato.DataHora) : "—")
                    </TemplateColumn>
                    <TemplateColumn Title="Status" Align="Align.Center">
                        <FluentBadge Appearance="@GetStatusBadgeAppearance(context.Status)">
                            @context.Status
                        </FluentBadge>
                    </TemplateColumn>
                    <TemplateColumn Title="Duração" Align="Align.Center">
                        @(context.DuracaoSegundos.HasValue ? $"{context.DuracaoSegundos.Value / 60.0:F1} min" : "—")
                    </TemplateColumn>
                </FluentDataGrid>
                <FluentPaginator State="@_pagination" />
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalGap="8" Style="padding: 1.5rem; text-align: center;">
                    <FluentIcon Icon="@(Icons.Regular.Size24.History)" Style="color: var(--neutral-foreground-hint);" />
                    <FluentLabel Style="color: var(--neutral-foreground-hint);">Nenhum atendimento encontrado no período.</FluentLabel>
                </FluentStack>
            }
        </FluentStack>
    </FluentCard>

</FluentStack>

@code {
    [Parameter, EditorRequired]
    public RelatorioAtendenteData Data { get; set; } = default!;

    private PaginationState _pagination = new() { ItemsPerPage = 10 };

    private IQueryable<RelatorioHistoricoItem> _paginatedHistorico =>
        Data.Historico.AsQueryable();

    private static Appearance GetStatusBadgeAppearance(string status) => status switch
    {
        "Finalizado" => Appearance.Accent,
        "EmAndamento" => Appearance.Neutral,
        _ => Appearance.Lightweight
    };
}
