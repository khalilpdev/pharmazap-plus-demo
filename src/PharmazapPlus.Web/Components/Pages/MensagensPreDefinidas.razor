@page "/mensagens-pre-definidas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = $"{UserRoles.Administrador},{UserRoles.Gestor}")]

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<MensagensPreDefinidas> Logger
@inject IPharmazapApiService PharmazapApiService
@inject IToastService ToastService

<PageTitle>Mensagens Pré-Definidas - Pharmazap Plus</PageTitle>

<div style="display: flex; flex-direction: column; height: 100%; overflow: hidden;">
    @if (CurrentUser != null)
    {
        <div style="flex-shrink: 0; width: 100%;">
            <FluentCard Style="padding: 1rem 2rem; border-radius: 0; width: 100%;">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="width: 100%;">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                                 HorizontalGap="12" Style="flex: 1; min-width: 0;">
                        <FluentIcon Icon="@(Icons.Regular.Size32.ChatMultiple)" Color="Color.Accent" />
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="min-width: 0;">
                            <FluentLabel Typo="Typography.PageTitle" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Mensagens Pré-Definidas</FluentLabel>
                            <FluentLabel Typo="Typography.Body">Gerencie as mensagens rápidas disponíveis para os atendentes</FluentLabel>
                        </FluentStack>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-left: auto; flex-shrink: 0; width: auto;">
                        <FluentButton Appearance="Appearance.Accent" @onclick="ShowNovaMensagem">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Add)" Slot="start" Color="Color.Fill" />
                            Nova Mensagem
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </div>

        <div style="flex: 1; min-height: 0; overflow-y: auto; padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- Filtros -->
            <FluentCard Style="padding: 1.5rem; width: 100%; position: relative; z-index: 10; overflow: visible;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                             VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                    <FluentTextField @bind-Value="@SearchQuery"
                                    Placeholder="Buscar por título ou texto..."
                                    Style="flex: 1;"
                                    Autocomplete="off"
                                    @onkeydown="HandleSearchKeyDown">
                        <FluentIcon Icon="@(Icons.Regular.Size16.Search)" Slot="start" />
                    </FluentTextField>

                    <FluentSelect TOption="string"
                                 Value="@_filterStatus"
                                 ValueChanged="@(v => { _filterStatus = v; StateHasChanged(); })"
                                 Style="min-width: 180px; position: relative; z-index: 10; overflow: visible;">
                        <FluentOption TOption="string" Value="all">Todos</FluentOption>
                        <FluentOption TOption="string" Value="active">Ativos</FluentOption>
                        <FluentOption TOption="string" Value="inactive">Inativos</FluentOption>
                    </FluentSelect>

                    <FluentButton Appearance="Appearance.Outline" @onclick="ClearFilters">
                        <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" Slot="start" />
                        Limpar
                    </FluentButton>
                </FluentStack>
            </FluentCard>

            <!-- Estatísticas -->
            <FluentCard Style="padding: 1.5rem; width: 100%; position: relative; z-index: 1;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32" Wrap="true">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
                                 VerticalAlignment="VerticalAlignment.Center" Style="width: auto;">
                        <FluentIcon Icon="@(Icons.Regular.Size24.ChatMultiple)" Color="Color.Accent" />
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="width: auto;">
                            <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--accent-fill-rest);">@_mensagens.Count</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Total</FluentLabel>
                        </FluentStack>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
                                 VerticalAlignment="VerticalAlignment.Center" Style="width: auto;">
                        <FluentIcon Icon="@(Icons.Regular.Size24.Checkmark)" Color="Color.Success" />
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="width: auto;">
                            <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--colorStatusSuccessForeground3);">@_mensagens.Count(m => m.Ativo)</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Ativas</FluentLabel>
                        </FluentStack>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
                                 VerticalAlignment="VerticalAlignment.Center" Style="width: auto;">
                        <FluentIcon Icon="@(Icons.Regular.Size24.Prohibited)" Style="color: var(--neutral-foreground-hint);" />
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="width: auto;">
                            <FluentLabel Style="font-size: 2rem; font-weight: 700; color: var(--neutral-foreground-hint);">@_mensagens.Count(m => !m.Ativo)</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Inativas</FluentLabel>
                        </FluentStack>
                    </FluentStack>
                </FluentStack>
            </FluentCard>

            <!-- Lista -->
            <FluentCard Style="padding: 1.5rem; width: 100%; position: relative; z-index: 1;">
                @if (_isLoading)
                {
                    <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 3rem;">
                        <FluentProgressRing />
                    </FluentStack>
                }
                else if (!FilteredMensagens.Any())
                {
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                                 VerticalGap="12" Style="padding: 3rem;">
                        <FluentIcon Icon="@(Icons.Regular.Size48.Chat)" Style="color: var(--neutral-foreground-hint);" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                            @(string.IsNullOrEmpty(SearchQuery) && _filterStatus == "all"
                                ? "Nenhuma mensagem pré-definida cadastrada. Clique em \"Nova Mensagem\" para começar."
                                : "Nenhuma mensagem encontrada com os filtros aplicados.")
                        </FluentLabel>
                    </FluentStack>
                }
                else
                {
                    <FluentDataGrid Items="@FilteredMensagens.AsQueryable()" Style="width: 100%;">
                        <PropertyColumn Title="Ordem" Property="@(m => m.Ordem)" Sortable="true" Style="width: 80px;" />
                        <PropertyColumn Title="Título" Property="@(m => m.Titulo)" Sortable="true" />
                        <TemplateColumn Title="Texto" Style="max-width: 400px;">
                            <FluentLabel Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; max-width: 380px;"
                                         Title="@context.Texto">
                                @context.Texto
                            </FluentLabel>
                        </TemplateColumn>
                        <TemplateColumn Title="Status" Style="width: 100px;">
                            @if (context.Ativo)
                            {
                                <FluentBadge Appearance="Appearance.Accent">Ativo</FluentBadge>
                            }
                            else
                            {
                                <FluentBadge>Inativo</FluentBadge>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Ações" Style="width: 140px;">
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                                <FluentButton Appearance="Appearance.Outline"
                                              Title="Editar"
                                              @onclick="@(() => ShowEditarMensagem(context))">
                                    <FluentIcon Icon="@(Icons.Regular.Size16.Edit)" />
                                </FluentButton>

                                @if (context.Ativo)
                                {
                                    <FluentButton Appearance="Appearance.Outline"
                                                  Title="Inativar"
                                                  @onclick="@(() => InativarMensagem(context))">
                                        <FluentIcon Icon="@(Icons.Regular.Size16.Prohibited)" />
                                    </FluentButton>
                                }
                                else
                                {
                                    <FluentButton Appearance="Appearance.Outline"
                                                  Title="Ativar"
                                                  @onclick="@(() => AtivarMensagem(context))">
                                        <FluentIcon Icon="@(Icons.Regular.Size16.Checkmark)" />
                                    </FluentButton>
                                }
                            </FluentStack>
                        </TemplateColumn>
                    </FluentDataGrid>
                }
            </FluentCard>
        </div>
    }
</div>

<MensagemPreDefinidaFormDialog Visible="@_showFormDialog"
                               VisibleChanged="@OnFormDialogVisibleChanged"
                               Mensagem="@_editingMensagem"
                               OnSave="@HandleFormSave" />

@code {
    private UserInfo? CurrentUser;
    private List<MensagemPreDefinidaDto> _mensagens = new();
    private bool _isLoading = true;
    private string SearchQuery = "";
    private string _filterStatus = "all";

    private bool _showFormDialog = false;
    private MensagemPreDefinidaDto? _editingMensagem;

    private IEnumerable<MensagemPreDefinidaDto> FilteredMensagens => _mensagens
        .Where(m =>
        {
            if (_filterStatus == "active" && !m.Ativo) return false;
            if (_filterStatus == "inactive" && m.Ativo) return false;
            if (!string.IsNullOrEmpty(SearchQuery))
            {
                var q = SearchQuery.ToLowerInvariant();
                if (!m.Titulo.ToLowerInvariant().Contains(q) && !m.Texto.ToLowerInvariant().Contains(q))
                    return false;
            }
            return true;
        });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentUser = await AuthService.GetUserInfo();
            await LoadMensagens();
            StateHasChanged();
        }
    }

    private async Task LoadMensagens()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            _mensagens = await PharmazapApiService.GetMensagensPreDefinidasAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading mensagens pré-definidas");
            ToastService.ShowError("Erro ao carregar mensagens pré-definidas.");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowNovaMensagem()
    {
        _editingMensagem = null;
        _showFormDialog = true;
    }

    private void ShowEditarMensagem(MensagemPreDefinidaDto mensagem)
    {
        _editingMensagem = mensagem;
        _showFormDialog = true;
    }

    private async Task HandleFormSave((bool IsNew, CreateMensagemPreDefinidaDto? Create, UpdateMensagemPreDefinidaDto? Update) args)
    {
        if (args.IsNew && args.Create != null)
        {
            var (success, message) = await PharmazapApiService.CreateMensagemPreDefinidaAsync(args.Create);
            if (success)
            {
                _showFormDialog = false;
                _editingMensagem = null;
                await LoadMensagens();
                ToastService.ShowSuccess("Mensagem pré-definida criada com sucesso.");
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        else if (!args.IsNew && args.Update != null && _editingMensagem != null)
        {
            var (success, message) = await PharmazapApiService.UpdateMensagemPreDefinidaAsync(_editingMensagem.Id, args.Update);
            if (success)
            {
                _showFormDialog = false;
                _editingMensagem = null;
                await LoadMensagens();
                ToastService.ShowSuccess("Mensagem pré-definida atualizada com sucesso.");
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
    }

    private async Task InativarMensagem(MensagemPreDefinidaDto mensagem)
    {
        var (success, message) = await PharmazapApiService.InativarMensagemPreDefinidaAsync(mensagem.Id);
        if (success)
        {
            await LoadMensagens();
            ToastService.ShowSuccess("Mensagem pré-definida inativada.");
        }
        else
        {
            ToastService.ShowError(message);
        }
    }

    private async Task AtivarMensagem(MensagemPreDefinidaDto mensagem)
    {
        var (success, message) = await PharmazapApiService.AtivarMensagemPreDefinidaAsync(mensagem.Id);
        if (success)
        {
            await LoadMensagens();
            ToastService.ShowSuccess("Mensagem pré-definida ativada.");
        }
        else
        {
            ToastService.ShowError(message);
        }
    }

    private void OnFormDialogVisibleChanged(bool visible)
    {
        _showFormDialog = visible;
        if (!visible) _editingMensagem = null;
    }

    private void ClearFilters()
    {
        SearchQuery = "";
        _filterStatus = "all";
        StateHasChanged();
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClearFilters();
    }
}
