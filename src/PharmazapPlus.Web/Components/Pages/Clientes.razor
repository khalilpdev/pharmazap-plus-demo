    private async Task HandleFormSave((bool IsNew, CreateClienteDto? Create, UpdateClienteDto? Update) args)
    {
        _showFormDialog = false;

        if (args.IsNew && args.Create != null)
        {
            var (success, message) = await PharmazapApiService.CreateClienteAsync(args.Create);
            if (success)
            {
                ToastService.ShowSuccess("Cliente criado com sucesso!");
                await LoadClientes();
            }
            else
            {
                ToastService.ShowError($"Erro ao criar cliente: {message}");
            }
        }
        else if (!args.IsNew && args.Update != null && _editingCliente != null)
        {
            var (success, message) = await PharmazapApiService.UpdateClienteAsync(_editingCliente.Id, args.Update);
            if (success)
            {
                ToastService.ShowSuccess("Cliente atualizado com sucesso!");
                await LoadClientes();
            }
            else
            {
                ToastService.ShowError($"Erro ao atualizar cliente: {message}");
            }
        }

        _editingCliente = null;
    }

    private void ConfirmDeleteCliente(Cliente cliente)
    {
        var activeAtendimentos = cliente.Atendimentos?
            .Count(a => a.StatusEnum == AtendimentoStatusEnum.Pendente ||
                       a.StatusEnum == AtendimentoStatusEnum.EmAndamento) ?? 0;

        if (activeAtendimentos > 0)
        {
            _confirmTitle = "Inativar Cliente";
            _confirmMessage = $"O cliente {cliente.Nome} possui {activeAtendimentos} atendimento(s) ativo(s). " +
                            "Ao inativar, não receberá novas mensagens automaticamente. " +
                            "O cliente precisará ser reativado manualmente se entrar em contato.";
        }
        else
        {
            _confirmTitle = "Inativar Cliente";
            _confirmMessage = $"Tem certeza que deseja inativar o cliente {cliente.Nome}? Esta ação pode ser desfeita posteriormente.";
        }

        _confirmAction = async () =>
        {
            var (success, message) = await PharmazapApiService.DeleteClienteAsync(cliente.Id);
            if (success)
            {
                ToastService.ShowSuccess(message);
                await LoadClientes();
            }
            else
            {
                ToastService.ShowError(message);
            }
        };
        _showConfirmDialog = true;
        StateHasChanged();
    }

    private async Task ExecuteConfirm()
    {
        _showConfirmDialog = false;
        if (_confirmAction != null)
            await _confirmAction();
        _confirmAction = null;
    }

    private void CancelConfirm()
    {
        _showConfirmDialog = false;
        _confirmAction = null;
    }

    private async Task ShowComprasDialog(Cliente cliente)
    {
        _comprasCliente = cliente;
        _comprasList = new();
        _showComprasDialog = true;
        _isLoadingCompras = true;
        StateHasChanged();

        try
        {
            var atendimentos = await PharmazapApiService.GetAtendimentosClienteAsync(cliente.Id);
            _comprasList = atendimentos.Where(a => a.ValorVenda.HasValue && a.ValorVenda.Value > 0).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading compras for cliente {ClienteId}", cliente.Id);
            ToastService.ShowError("Erro ao carregar compras do cliente.");
        }
        finally
        {
            _isLoadingCompras = false;
            StateHasChanged();
        }
    }

    private void CloseComprasDialog()
    {
        _showComprasDialog = false;
        _comprasCliente = null;
        _comprasList = new();
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            StateHasChanged();
        }
    }
}

