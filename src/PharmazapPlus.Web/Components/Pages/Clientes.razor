    private int GetTotalClientesFiltrados()
    {
        var filtered = ClientesList.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            filtered = filtered.Where(c =>
                (c.Nome?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.Email?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.WhatsAppId?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.Telefone?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (!string.IsNullOrWhiteSpace(FilterCity))
        {
            filtered = filtered.Where(c => c.Cidade?.Contains(FilterCity, StringComparison.OrdinalIgnoreCase) ?? false);
        }

        if (!string.IsNullOrWhiteSpace(FilterState))
        {
            filtered = filtered.Where(c => string.Equals(c.Estado, FilterState, StringComparison.OrdinalIgnoreCase));
        }

        if (FilterUsoContinuo)
        {
            filtered = filtered.Where(c => c.UsoContinuo);
        }

        if (FilterStatus != "all")
        {
            filtered = FilterStatus switch
            {
                // Considera Status (enum) E Ativo (bool) - clienteAtivo se Ativo=true OU Status=Ativo
                "active" => filtered.Where(c => c.Ativo || c.Status == ClienteStatus.Ativo),
                // Cliente inativo: Ativo=false OU Status=Inativo/Bloqueado/Potencial
                "inactive" => filtered.Where(c => !c.Ativo || c.Status == ClienteStatus.Inativo || c.Status == ClienteStatus.Bloqueado || c.Status == ClienteStatus.Potencial),
                "new" => filtered.Where(c => c.DataCadastro >= DateTime.Now.AddDays(-30)),
                _ => filtered
            };
        }

        if (FilterPerfil != "all" && Enum.TryParse<ClientePerfilCompraEnum>(FilterPerfil, out var perfilFiltro))
        {
            filtered = filtered.Where(c => c.PerfilCompra == perfilFiltro);
        }

        return filtered.Count();
    }

    private int TotalPages => (int)Math.Ceiling((double)GetTotalClientesFiltrados() / PageSize);

    // Statistics
    private int TotalClientes => ClientesList.Count;
    private int ClientesNovos => ClientesList.Count(c => c.DataCadastro >= DateTime.Now.AddDays(-30));
    private int ClientesAtivos => ClientesList.Count(c => c.Status == ClienteStatus.Ativo);
    private int ClientesUsoContinuo => ClientesList.Count(c => c.UsoContinuo);
    private int ClientesFidelizados => ClientesList.Count(c => c.PerfilCompra == ClientePerfilCompraEnum.Fidelizado);
    private int ClientesProspectos => ClientesList.Count(c => c.PerfilCompra == ClientePerfilCompraEnum.Prospecto);

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("🔵 OnInitializedAsync START - _initialized: {Init}", _initialized);

        if (_initialized) 
        {
            Logger.LogWarning("⚠️ OnInitializedAsync - Already initialized, returning early");
            return;
        }
        _initialized = true;

        try
        {
            Logger.LogInformation("🟡 Getting CurrentUser...");
            CurrentUser = await AuthService.GetUserInfo();

            if (CurrentUser == null)
            {
                Logger.LogWarning("🔴 CurrentUser is null in OnInitializedAsync");
                Navigation.NavigateTo("/login", true);
                return;
            }

            Logger.LogInformation("🟢 CurrentUser found: {UserId} ({Role})", CurrentUser.Id, CurrentUser.Role);
            Logger.LogInformation("🟡 Calling LoadClientes...");
            await LoadClientes();
            Logger.LogInformation("🟢 OnInitializedAsync completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "🔴 Error initializing clientes page: {Message}", ex.Message);
            Navigation.NavigateTo("/login", true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Logger.LogInformation("🔵 OnAfterRenderAsync - firstRender: {First}, _initialized: {Init}", firstRender, _initialized);

        if (!firstRender) return;

        try
        {
            if (!_initialized)
            {
                Logger.LogWarning("⚠️ OnAfterRenderAsync - _initialized is false, initializing now");
                CurrentUser = await AuthService.GetUserInfo();

                if (CurrentUser == null)
                {
                    Navigation.NavigateTo("/login", true);
                    return;
                }

                await LoadClientes();
                _initialized = true;
                await InvokeAsync(StateHasChanged);
                Logger.LogInformation("🟢 OnAfterRenderAsync initialization completed");
            }
            else
            {
                Logger.LogInformation("ℹ️ OnAfterRenderAsync - Already initialized, ClientesList: {Count}", ClientesList.Count);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "🔴 Error in OnAfterRenderAsync: {Message}", ex.Message);
        }
    }

    private async Task LoadClientes()
    {
        Logger.LogInformation("🔵 LoadClientes START - IsLoadingClientes: {Loading}, ClientesList.Count: {Count}", 
            IsLoadingClientes, ClientesList.Count);

        IsLoadingClientes = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("🟡 About to call PharmazapApiService.GetClientesAsync()");
            ClientesList = await PharmazapApiService.GetClientesAsync();

            Logger.LogInformation("🟢 GetClientesAsync completed. Returned: {Count} clientes", ClientesList.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "🔴 Error loading clientes: {Message}", ex.Message);
            ToastService.ShowError($"Erro ao carregar clientes: {ex.Message}");
        }
        finally
        {
            IsLoadingClientes = false;
            Logger.LogInformation("🟣 LoadClientes FINALLY - StateHasChanged called");
            StateHasChanged();
        }
    }

