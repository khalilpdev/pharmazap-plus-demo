@page "/clientes/{ClienteId:int}/historico"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]

@inject IPharmazapApiService PharmazapApiService
@inject IToastService ToastService
@inject ILogger<ClienteHistorico> Logger
@inject NavigationManager Navigation

<PageTitle>Histórico do Cliente - Pharmazap Plus</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Style="height: 100%; overflow: hidden;">
    <FluentCard Style="padding: 1rem 1.5rem; border-radius: 0;">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10" Style="width: 100%;">
            <FluentButton Appearance="Appearance.Outline" @onclick="VoltarParaMensagens" Title="Voltar">
                <FluentIcon Icon="@(Icons.Regular.Size16.ArrowLeft)" Slot="start" />
                Voltar
            </FluentButton>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="min-width: 0;">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">
                    Histórico completo de atendimentos
                </FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                    @TituloCliente
                </FluentLabel>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <div style="flex: 1; min-height: 0; overflow-y: auto; padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
        @if (_isLoading)
        {
            <FluentCard Style="padding: 1rem;">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10">
                    <FluentProgressRing />
                    <FluentLabel>Carregando histórico do cliente...</FluentLabel>
                </FluentStack>
            </FluentCard>
        }
        else
        {
            <FluentCard Style="padding: 1rem;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Style="flex-wrap: wrap;">
                    <FluentLabel><strong>Pendentes:</strong> @_pendentes.Count</FluentLabel>
                    <FluentLabel><strong>Em andamento:</strong> @_emAndamento.Count</FluentLabel>
                    <FluentLabel><strong>Finalizados:</strong> @_finalizados.Count</FluentLabel>
                    <FluentLabel><strong>Total:</strong> @_atendimentos.Count</FluentLabel>
                </FluentStack>
            </FluentCard>

            <FluentCard Style="padding: 1rem;">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Pendentes</FluentLabel>
                @if (_pendentes.Count == 0)
                {
                    <FluentLabel Style="color: var(--neutral-foreground-hint);">Nenhum atendimento pendente.</FluentLabel>
                }
                else
                {
                    @foreach (var atendimento in _pendentes)
                    {
                        <div class="history-row">
                            <span>#@atendimento.Id</span>
                            <span>Início: @atendimento.DataInicio.ToString("dd/MM/yyyy HH:mm")</span>
                            <span>Atendente: @GetAtendenteNome(atendimento)</span>
                        </div>
                    }
                }
            </FluentCard>

            <FluentCard Style="padding: 1rem;">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Em andamento</FluentLabel>
                @if (_emAndamento.Count == 0)
                {
                    <FluentLabel Style="color: var(--neutral-foreground-hint);">Nenhum atendimento em andamento.</FluentLabel>
                }
                else
                {
                    @foreach (var atendimento in _emAndamento)
                    {
                        <div class="history-row">
                            <span>#@atendimento.Id</span>
                            <span>Início: @atendimento.DataInicio.ToString("dd/MM/yyyy HH:mm")</span>
                            <span>Atendente: @GetAtendenteNome(atendimento)</span>
                        </div>
                    }
                }
            </FluentCard>

            <FluentCard Style="padding: 1rem;">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Finalizados (agrupados por motivo)</FluentLabel>
                @if (_finalizados.Count == 0)
                {
                    <FluentLabel Style="color: var(--neutral-foreground-hint);">Nenhum atendimento finalizado.</FluentLabel>
                }
                else
                {
                    @foreach (var grupo in FinalizadosPorMotivo)
                    {
                        <div class="history-group-title">@grupo.Key</div>
                        @foreach (var atendimento in grupo.OrderByDescending(a => a.DataFim ?? a.DataInicio))
                        {
                            <div class="history-row">
                                <span>#@atendimento.Id</span>
                                <span>Data: @(atendimento.DataFim ?? atendimento.DataInicio).ToString("dd/MM/yyyy HH:mm")</span>
                                <span>Valor da venda: @FormatarValorVenda(atendimento.ValorVenda)</span>
                            </div>
                        }
                    }
                }
            </FluentCard>
        }
    </div>
</FluentStack>

@code {
    [Parameter] public int ClienteId { get; set; }
    [SupplyParameterFromQuery(Name = "nome")] public string? Nome { get; set; }

    private bool _isLoading = true;
    private List<AtendimentoCompraDto> _atendimentos = new();
    private List<AtendimentoCompraDto> _pendentes = new();
    private List<AtendimentoCompraDto> _emAndamento = new();
    private List<AtendimentoCompraDto> _finalizados = new();

    private string TituloCliente =>
        string.IsNullOrWhiteSpace(Nome)
            ? $"Cliente #{ClienteId}"
            : $"{Nome} (ID #{ClienteId})";

    private IEnumerable<IGrouping<string, AtendimentoCompraDto>> FinalizadosPorMotivo =>
        _finalizados
            .GroupBy(GetComentarioAvaliacao)
            .OrderBy(g => g.Key);

    protected override async Task OnParametersSetAsync()
    {
        await CarregarHistorico();
    }

    private async Task CarregarHistorico()
    {
        _isLoading = true;
        try
        {
            _atendimentos = await PharmazapApiService.GetAtendimentosClienteAsync(ClienteId);
            _pendentes = _atendimentos
                .Where(a => ParseStatus(a.Status) == AtendimentoStatusEnum.Pendente)
                .OrderByDescending(a => a.DataInicio)
                .ToList();
            _emAndamento = _atendimentos
                .Where(a => ParseStatus(a.Status) == AtendimentoStatusEnum.EmAndamento)
                .OrderByDescending(a => a.DataInicio)
                .ToList();
            _finalizados = _atendimentos
                .Where(a => ParseStatus(a.Status) == AtendimentoStatusEnum.Finalizado)
                .OrderByDescending(a => a.DataFim ?? a.DataInicio)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar histórico do cliente {ClienteId}", ClienteId);
            ToastService.ShowError("Não foi possível carregar o histórico do cliente.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static AtendimentoStatusEnum ParseStatus(string? status) =>
        Enum.TryParse<AtendimentoStatusEnum>(status, true, out var parsed)
            ? parsed
            : AtendimentoStatusEnum.Pendente;

    private static string GetComentarioAvaliacao(AtendimentoCompraDto atendimento) =>
        string.IsNullOrWhiteSpace(atendimento.ComentarioAvaliacao)
            ? "Sem motivo informado"
            : atendimento.ComentarioAvaliacao.Trim();

    private static string GetAtendenteNome(AtendimentoCompraDto atendimento) =>
        string.IsNullOrWhiteSpace(atendimento.Atendente?.Nome)
            ? "Não atribuído"
            : atendimento.Atendente.Nome!;

    private static string FormatarValorVenda(decimal? valorVenda) =>
        valorVenda.HasValue
            ? valorVenda.Value.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))
            : "-";

    private void VoltarParaMensagens()
    {
        Navigation.NavigateTo("/messages");
    }
}

<style>
    .history-row {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--neutral-stroke-rest);
        font-size: 0.875rem;
    }

    .history-group-title {
        margin-top: 0.75rem;
        margin-bottom: 0.25rem;
        font-weight: 700;
        color: var(--neutral-foreground-rest);
    }
</style>
