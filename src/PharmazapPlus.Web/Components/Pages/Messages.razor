    private async Task ReativarClienteECriarAtendimento()
    {
        if (_reativarClienteId <= 0) return;

        var result = await PharmazapApiService.ReativarClienteAsync(_reativarClienteId);
        if (result.Success)
        {
            ToastService.ShowSuccess("Cliente reativado com sucesso!");
            await LoadAtendimentos();
        }
        else
        {
            ToastService.ShowError($"Erro ao reativar cliente: {result.Message}");
        }
        StateHasChanged();
    }

