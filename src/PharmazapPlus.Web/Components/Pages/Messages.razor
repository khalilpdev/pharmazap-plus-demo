    private void ShowBloqueDialog(Atendimento atendimento)
    {
        _bloqueAtendimento = atendimento;
        _showBloqueDialog = true;
        StateHasChanged();
    }

    private async Task HandleBloqueRemetente(BloqueRemetenteDialog.BloqueRemetenteRequest request)
    {
        if (_bloqueAtendimento == null) return;

        try
        {
            // Chama o endpoint da API para bloquear
            var (success, message) = await PharmazapApiService.BloqueRemetenteAsync(
                _bloqueAtendimento.Id,
                request.Escopo,
                request.Motivo);

            if (success)
            {
                ToastService.ShowSuccess("Remetente bloqueado com sucesso");
                _showBloqueDialog = false;
                _bloqueAtendimento = null;
                await LoadAtendimentos();
            }
            else
            {
                ToastService.ShowError($"Erro ao bloquear: {message}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error blocking sender {AtendimentoId}", _bloqueAtendimento?.Id);
            ToastService.ShowError($"Erro ao bloquear remetente: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
