@page "/tests"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = UserRoles.Administrador)]

@using System.Diagnostics
@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Forms

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<Tests> Logger
@inject IPharmazapApiService PharmazapApiService
@inject IChannelService ChannelService
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject IToastService ToastService

@implements IDisposable

<PageTitle>Diagnóstico - Pharmazap Plus</PageTitle>

<div style="display: flex; flex-direction: column; height: 100%; overflow: hidden;">
    @if (CurrentUser != null)
    {
        <!-- Header -->
        <div style="flex-shrink: 0; width: 100%;">
            <FluentCard Style="padding: 1rem 2rem; border-radius: 0; width: 100%;">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="width: 100%;">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                                 HorizontalGap="12" Style="flex: 1; min-width: 0;">
                        <FluentIcon Icon="@(Icons.Regular.Size32.Beaker)" Color="Color.Accent" />
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="min-width: 0;">
                            <FluentLabel Typo="Typography.PageTitle" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Diagnóstico e Testes</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">Ferramentas de diagnóstico rápido — visível apenas para Administradores</FluentLabel>
                        </FluentStack>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </div>

        <!-- Content -->
        <div style="flex: 1; min-height: 0; overflow-y: auto; padding: 2rem; box-sizing: border-box;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="margin-bottom: 1.5rem;">
                <FluentLabel Typo="Typography.Subject" Style="font-weight: 700;">Logs do cadastro de canais</FluentLabel>
                <FluentLabel Style="color: var(--neutral-foreground-hint);">
                    Abra o painel para ver apenas os logs das integrações cadastradas nesta farmácia.
                </FluentLabel>
                <ChannelLogsPanel />
            </FluentStack>

            <FluentGrid Spacing="4" Justify="JustifyContent.FlexStart" Style="width: 100%; box-sizing: border-box;">

                <!-- Card 1: Mock WhatsApp / Instagram -->
                <FluentGridItem xs="12" sm="6" lg="4">
                    <FluentCard Style="padding: 1.5rem; height: 100%; display: flex; flex-direction: column; gap: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="flex: 1;">
                            <FluentIcon Icon="@(Icons.Regular.Size32.ChatBubblesQuestion)" Color="Color.Accent" />
                            <FluentLabel Typo="Typography.Subject" Style="font-weight: 600;">Envio de Mensagem Mock</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); flex: 1;">
                                Simula o recebimento de uma mensagem de um cliente ou grupo via WhatsApp ou Instagram, criando um atendimento pendente.
                            </FluentLabel>
                        </FluentStack>
                        <FluentButton Appearance="Appearance.Accent" @onclick="OpenMockWhatsAppDialog" Style="width: 100%; white-space: normal; height: auto; min-height: 2.25rem;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.ChatBubblesQuestion)" Slot="start" Color="Color.Fill" />
                            WhatsApp - Simular Mensagem de um cliente
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Accent" @onclick="OpenMockInstagramDialog" Style="width: 100%; white-space: normal; height: auto; min-height: 2.25rem; margin-top: 0.5rem;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Camera)" Slot="start" Color="Color.Fill" />
                            Instagram - Simular Mensagem de um cliente
                        </FluentButton>
                    </FluentCard>
                </FluentGridItem>

                <!-- Card 2: API Health -->
                <FluentGridItem xs="12" sm="6" lg="4">
                    <FluentCard Style="padding: 1.5rem; height: 100%; display: flex; flex-direction: column; gap: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="flex: 1;">
                            <FluentIcon Icon="@(Icons.Regular.Size32.Cloud)" Color="Color.Accent" />
                            <FluentLabel Typo="Typography.Subject" Style="font-weight: 600;">Status da API</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); flex: 1;">
                                Verifica se a API está online, consulta o health check e informações do sistema.
                            </FluentLabel>
                        </FluentStack>
                        <FluentButton Appearance="Appearance.Accent" @onclick="OpenApiHealthDialog" Style="width: 100%; white-space: normal; height: auto; min-height: 2.25rem;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.ArrowSync)" Slot="start" Color="Color.Fill" />
                            Testar Status da API e Conexão de Banco de Dados
                        </FluentButton>
                    </FluentCard>
                </FluentGridItem>

                <!-- Card 3: Queue Stats -->
                <FluentGridItem xs="12" sm="6" lg="4">
                    <FluentCard Style="padding: 1.5rem; height: 100%; display: flex; flex-direction: column; gap: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="flex: 1;">
                            <FluentIcon Icon="@(Icons.Regular.Size32.Settings)" Color="Color.Accent" />
                            <FluentLabel Typo="Typography.Subject" Style="font-weight: 600;">Fila de Mensagens (Redis)</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); flex: 1;">
                                Consulta as contagens das filas Redis (novas mensagens, notificações, agendamentos).
                            </FluentLabel>
                        </FluentStack>
                        <FluentButton Appearance="Appearance.Accent" @onclick="OpenQueueStatsDialog" Style="width: 100%; white-space: normal; height: auto; min-height: 2.25rem;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.ArrowSort)" Slot="start" Color="Color.Fill" />
                            Verificar Fila de Mensagens (Redis)
                        </FluentButton>
                    </FluentCard>
                </FluentGridItem>

                <!-- Card 4: Dashboard Stats -->
                <FluentGridItem xs="12" sm="6" lg="4">
                    <FluentCard Style="padding: 1.5rem; height: 100%; display: flex; flex-direction: column; gap: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="flex: 1;">
                            <FluentIcon Icon="@(Icons.Regular.Size32.DataBarVertical)" Color="Color.Accent" />
                            <FluentLabel Typo="Typography.Subject" Style="font-weight: 600;">Dashboard Stats</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); flex: 1;">
                                Busca as estatísticas do dashboard para o usuário Administrador autenticado.
                            </FluentLabel>
                        </FluentStack>
                        <FluentButton Appearance="Appearance.Accent" @onclick="OpenDashboardStatsDialog" Style="width: 100%; white-space: normal; height: auto; min-height: 2.25rem;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.DataBarVertical)" Slot="start" Color="Color.Fill" />
                            Testar Dashboard Stats (Administrador)
                        </FluentButton>
                    </FluentCard>
                </FluentGridItem>

                <!-- Card 5: Evolution API -->
                <FluentGridItem xs="12" sm="6" lg="4">
                    <FluentCard Style="padding: 1.5rem; height: 100%; display: flex; flex-direction: column; gap: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="flex: 1;">
                            <FluentIcon Icon="@(Icons.Regular.Size32.PlugConnected)" Color="Color.Accent" />
                            <FluentLabel Typo="Typography.Subject" Style="font-weight: 600;">Evolution API (Não-Oficial)</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); flex: 1;">
                                Testa a conectividade com a Evolution API não-oficial. Informe a URL e a API Key para verificar se o servidor está acessível.
                            </FluentLabel>
                        </FluentStack>
                        <FluentButton Appearance="Appearance.Accent" @onclick="OpenEvolutionDialog" Style="width: 100%; white-space: normal; height: auto; min-height: 2.25rem;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.PlugConnected)" Slot="start" Color="Color.Fill" />
                            Testar Conexão com Evolution API
                        </FluentButton>
                    </FluentCard>
                </FluentGridItem>

            </FluentGrid>
        </div>
    }
    else if (_isLoading)
    {
        <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
            <FluentProgressRing />
        </div>
    }
</div>

<!-- =============================== -->
<!-- Dialog 1: Mock WhatsApp Message -->
<!-- =============================== -->
<FluentDialog Modal="true" Hidden="@(!_showMockWhatsAppDialog)" TrapFocus="true"
              @ondialogdismiss="CloseMockWhatsAppDialog"
              Style="width: 520px;">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.ChatBubblesQuestion)" />
                <FluentLabel Typo="Typography.Subject">Testar Envio de Mensagem Mock WhatsApp</FluentLabel>
            </FluentStack>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseMockWhatsAppDialog" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="padding: 0.5rem 0;">
            <div>
                <FluentLabel Style="display: block; margin-bottom: 4px;">Número de telefone (From)</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom">
                    <FluentTextField Value="+55"
                                     ReadOnly="true"
                                     Style="width: 64px; flex-shrink: 0;"
                                     Autocomplete="off" />
                    <FluentTextField Value="@_mockPhoneNumber"
                                     ValueChanged="@(v => _mockPhoneNumber = v.MaskTelefoneInput())"
                                     Immediate="true"
                                     Placeholder="(62) 99123-6501"
                                     MaxLength="16"
                                     Style="flex: 1;"
                                     Autocomplete="off" />
                </FluentStack>
            </div>
            @if (CurrentUser?.IsAdministrador == false)
            {
                <FluentTextField @bind-Value="_mockFarmaciaIdStr"
                                 Label="FarmaciaId"
                                 Placeholder="1"
                                 Style="width: 100%;"
                                 Autocomplete="off" />
            }
            <FluentTextField @bind-Value="_mockText"
                             Label="Texto da mensagem"
                             Placeholder="Olá, preciso renovar minha receita"
                             Style="width: 100%;"
                             Autocomplete="off" />
            <FluentLabel Style="display: block; margin-top: 4px; font-size: 0.8rem; color: var(--neutral-foreground-hint);">
                Se precisar de dados mock, atualize o .env e contate o administrador.
            </FluentLabel>

            <FluentCheckbox @bind-Value="@_mockIsGroup">
                Simular recebimento de grupo do WhatsApp (Evolution Go)
            </FluentCheckbox>

            @if (_isMockLoading)
            {
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <FluentProgressRing Style="width: 20px; height: 20px;" />
                    <FluentLabel>Enviando mensagem mock...</FluentLabel>
                </FluentStack>
            }
            else if (_mockResult != null)
            {
                @if (_mockResult.Success)
                {
                    <FluentCard Style="padding: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentBadge Appearance="Appearance.Accent">✅ Mensagem simulada com sucesso</FluentBadge>
                            <FluentLabel>Atendimento ID: <strong>@_mockResult.AtendimentoId</strong></FluentLabel>
                            <FluentLabel>Novo Atendimento: <strong>@(_mockResult.NovoAtendimento ? "Sim" : "Não")</strong></FluentLabel>
                            <FluentLabel>Status: <strong>@_mockResult.Status</strong></FluentLabel>
                        </FluentStack>
                    </FluentCard>
                }
                else
                {
                    <FluentCard Style="padding: 1rem; background: var(--error-fill-rest, #f8d7da);">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentBadge Appearance="Appearance.Neutral">❌ Erro ao enviar mensagem</FluentBadge>
                            <FluentLabel Style="margin-top: 0.5rem; color: var(--error-foreground, #721c24); font-weight: 600;">@_mockResult.ErrorMessage</FluentLabel>
                            
                            @if (_mockResult.Details != null)
                            {
                                <FluentDivider Style="margin: 0.5rem 0;"/>
                                <FluentLabel Typo="Typography.Body" Style="color: var(--error-foreground, #721c24); font-weight: 600;">Detalhes do Erro:</FluentLabel>
                                
                                @if (!string.IsNullOrEmpty(_mockResult.Details.InnerException))
                                {
                                    <FluentLabel Style="color: var(--error-foreground, #721c24); font-family: monospace; font-size: 0.85rem; white-space: pre-wrap; word-break: break-word;">
                                        <strong>Inner Exception:</strong> @_mockResult.Details.InnerException
                                    </FluentLabel>
                                }
                                
                                @if (_mockResult.Details.StackTrace != null && _mockResult.Details.StackTrace.Length > 0)
                                {
                                    <FluentLabel Style="color: var(--error-foreground, #721c24); font-weight: 600; margin-top: 0.5rem;">Stack Trace (primeiras linhas):</FluentLabel>
                                    <FluentLabel Style="color: var(--error-foreground, #721c24); font-family: monospace; font-size: 0.75rem; white-space: pre-wrap; word-break: break-word;">
                                        @string.Join("\n", _mockResult.Details.StackTrace.Take(3))
                                    </FluentLabel>
                                }
                            }
                        </FluentStack>
                    </FluentCard>
                }
            }
            else if (_mockErrorMessage != null)
            {
                <FluentCard Style="padding: 1rem; background: var(--error-fill-rest, #f8d7da);">
                    <FluentBadge Appearance="Appearance.Neutral">❌ Erro</FluentBadge>
                    <FluentLabel Style="margin-top: 0.5rem; color: var(--error-foreground, #721c24); font-weight: 600;">@_mockErrorMessage</FluentLabel>
                </FluentCard>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" @onclick="CloseMockWhatsAppDialog">
            Fechar
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      @onclick="SendMockWhatsAppMessage"
                      Disabled="@(_isMockLoading || string.IsNullOrWhiteSpace(_mockPhoneNumber) || string.IsNullOrWhiteSpace(_mockText))">
            @if (_isMockLoading)
            {
                <FluentProgressRing Style="width: 16px; height: 16px;" />
                <span style="margin-left: 0.5rem;">Enviando...</span>
            }
            else
            {
                <FluentIcon Icon="@(Icons.Regular.Size16.Send)" Slot="start" Color="Color.Fill" />
                <span>Enviar Mock</span>
            }
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- ========================= -->
<!-- Dialog 2: API Health      -->
<!-- ========================= -->
<FluentDialog Modal="true" Hidden="@(!_showApiHealthDialog)" TrapFocus="true"
              @ondialogdismiss="CloseApiHealthDialog"
              Style="width: 560px;">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.ArrowSync)" />
                <FluentLabel Typo="Typography.Subject">Status da API e Banco de Dados</FluentLabel>
            </FluentStack>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseApiHealthDialog" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="padding: 0.5rem 0;">
            @if (_isHealthLoading)
            {
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <FluentProgressRing Style="width: 20px; height: 20px;" />
                    <FluentLabel>Verificando status da API...</FluentLabel>
                </FluentStack>
            }
            else if (_healthResult != null)
            {
                <!-- Health Check Result -->
                <FluentCard Style="padding: 1rem;">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                            @if (_healthResult.IsOnline)
                            {
                                <FluentBadge Appearance="Appearance.Accent">✅ API Online</FluentBadge>
                            }
                            else
                            {
                                <FluentBadge Appearance="Appearance.Neutral" Style="background: var(--error-fill-rest);">❌ API Offline</FluentBadge>
                            }
                            <FluentLabel Style="color: var(--neutral-foreground-hint);">HTTP @_healthResult.HttpStatusCode — @_healthResult.ResponseTimeMs ms</FluentLabel>
                        </FluentStack>

                        @if (!string.IsNullOrEmpty(_healthResult.HealthJson))
                        {
                            <FluentLabel Style="font-weight: 600; margin-top: 0.5rem;">/health</FluentLabel>
                            <pre style="font-size: 0.78rem; background: var(--neutral-fill-layer-rest); padding: 0.75rem; border-radius: 4px; overflow-x: auto; white-space: pre-wrap; word-break: break-all;">@_healthResult.HealthJson</pre>
                        }
                    </FluentStack>
                </FluentCard>

                @if (_systemInfoResult != null)
                {
                    <FluentCard Style="padding: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentLabel Style="font-weight: 600;">/system/info</FluentLabel>
                            @if (_systemInfoResult.IsOnline)
                            {
                                <FluentBadge Appearance="Appearance.Accent">✅ Disponível — @_systemInfoResult.ResponseTimeMs ms</FluentBadge>
                            }
                            else
                            {
                                <FluentBadge Appearance="Appearance.Neutral" Style="background: var(--error-fill-rest);">❌ Indisponível — HTTP @_systemInfoResult.HttpStatusCode</FluentBadge>
                            }
                            @if (!string.IsNullOrEmpty(_systemInfoResult.InfoJson))
                            {
                                <pre style="font-size: 0.78rem; background: var(--neutral-fill-layer-rest); padding: 0.75rem; border-radius: 4px; overflow-x: auto; white-space: pre-wrap; word-break: break-all;">@_systemInfoResult.InfoJson</pre>
                            }
                        </FluentStack>
                    </FluentCard>
                }
            }
            else if (_healthErrorMessage != null)
            {
                <FluentCard Style="padding: 1rem; background: var(--error-fill-rest, #f8d7da);">
                    <FluentBadge Appearance="Appearance.Neutral">❌ Erro ao consultar</FluentBadge>
                    <FluentLabel Style="margin-top: 0.5rem; color: var(--neutral-foreground-rest);">@_healthErrorMessage</FluentLabel>
                </FluentCard>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" @onclick="CloseApiHealthDialog">
            Fechar
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent" @onclick="LoadApiHealth" Disabled="@_isHealthLoading">
            @if (_isHealthLoading)
            {
                <FluentProgressRing Style="width: 16px; height: 16px;" />
                <span style="margin-left: 0.5rem;">Verificando...</span>
            }
            else
            {
                <FluentIcon Icon="@(Icons.Regular.Size16.ArrowClockwise)" Slot="start" Color="Color.Fill" />
                <span>Testar novamente</span>
            }
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- =========================== -->
<!-- Dialog 3: Queue Stats       -->
<!-- =========================== -->
<FluentDialog Modal="true" Hidden="@(!_showQueueStatsDialog)" TrapFocus="true"
              @ondialogdismiss="CloseQueueStatsDialog"
              Style="width: 480px;">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.ArrowSort)" />
                <FluentLabel Typo="Typography.Subject">Fila de Mensagens (Redis)</FluentLabel>
            </FluentStack>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseQueueStatsDialog" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="padding: 0.5rem 0;">
            @if (_isQueueLoading)
            {
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <FluentProgressRing Style="width: 20px; height: 20px;" />
                    <FluentLabel>Consultando filas Redis...</FluentLabel>
                </FluentStack>
            }
            else if (_queueStats != null)
            {
                <FluentCard Style="padding: 1rem;">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        <FluentBadge Appearance="Appearance.Accent">✅ Redis Disponível</FluentBadge>

                        @foreach (var (name, count) in GetQueueItems())
                        {
                            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                                         HorizontalGap="12" Style="justify-content: space-between;">
                                <FluentLabel>@name</FluentLabel>
                                @if (count > 50)
                                {
                                    <FluentBadge Appearance="Appearance.Accent" Style="background: var(--error-fill-rest);">@count itens</FluentBadge>
                                }
                                else if (count > 10)
                                {
                                    <FluentBadge Appearance="Appearance.Neutral" Style="background: var(--warning-fill-rest);">@count itens</FluentBadge>
                                }
                                else
                                {
                                    <FluentBadge Appearance="Appearance.Accent">@count itens</FluentBadge>
                                }
                            </FluentStack>
                        }

                        <FluentLabel Style="font-size: 0.8rem; color: var(--neutral-foreground-hint); margin-top: 0.5rem;">
                            Consultado em: @_queueStats.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                        </FluentLabel>
                    </FluentStack>
                </FluentCard>
            }
            else if (_queueErrorMessage != null)
            {
                <FluentCard Style="padding: 1rem; background: var(--error-fill-rest, #f8d7da);">
                    <FluentBadge Appearance="Appearance.Neutral">❌ Redis Indisponível ou Erro</FluentBadge>
                    <FluentLabel Style="margin-top: 0.5rem; color: var(--neutral-foreground-rest);">@_queueErrorMessage</FluentLabel>
                </FluentCard>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" @onclick="CloseQueueStatsDialog">
            Fechar
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent" @onclick="LoadQueueStats" Disabled="@_isQueueLoading">
            @if (_isQueueLoading)
            {
                <FluentProgressRing Style="width: 16px; height: 16px;" />
                <span style="margin-left: 0.5rem;">Atualizando...</span>
            }
            else
            {
                <FluentIcon Icon="@(Icons.Regular.Size16.ArrowClockwise)" Slot="start" Color="Color.Fill" />
                <span>Atualizar</span>
            }
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- ============================= -->
<!-- Dialog 4: Dashboard Stats     -->
<!-- ============================= -->
<FluentDialog Modal="true" Hidden="@(!_showDashboardStatsDialog)" TrapFocus="true"
              @ondialogdismiss="CloseDashboardStatsDialog"
              Style="width: 520px;">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.DataBarVertical)" />
                <FluentLabel Typo="Typography.Subject">Dashboard Stats (Administrador)</FluentLabel>
            </FluentStack>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseDashboardStatsDialog" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
