<FluentDialog Modal="true" Hidden="@(!_showEvolutionDialog)" TrapFocus="true"
              @ondialogdismiss="CloseEvolutionDialog"
              Style="width: 540px;">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.PlugConnected)" />
                <FluentLabel Typo="Typography.Subject">Testar Conexão com Evolution API</FluentLabel>
            </FluentStack>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseEvolutionDialog" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="padding: 0.5rem 0;">

            @* Channel selector *@
            <div Style="overflow: visible; position: relative; z-index: 30;">
                @if (_isLoadingEvolutionChannels)
                {
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                        <FluentProgressRing Style="width: 16px; height: 16px;" />
                        <FluentLabel>Carregando canais...</FluentLabel>
                    </FluentStack>
                }
                else if (!_whatsappNaoOficialChannels.Any())
                {
                    <FluentMessageBar Intent="@MessageIntent.Warning">
                        Nenhum canal WhatsApp Não Oficial configurado e ativo. Configure um canal em
                        <a href="/channels" @onclick="CloseEvolutionDialog">Canais de Integração</a> primeiro.
                    </FluentMessageBar>
                }
                else
                {
                    <FluentSelect TOption="string"
                                  Label="Instância (Canal WhatsApp Não Oficial)"
                                  Value="@(_selectedEvolutionChannelId?.ToString() ?? "")"
                                  ValueChanged="OnEvolutionChannelChanged"
                                  Style="width: 100%; position: relative; z-index: 30; overflow: visible;">
                        @if (_whatsappNaoOficialChannels.Count > 1)
                        {
                            <FluentOption Value="">Selecione uma instância...</FluentOption>
                        }
                        @foreach (var ch in _whatsappNaoOficialChannels)
                        {
                            <FluentOption Value="@ch.Id.ToString()">@ch.Name</FluentOption>
                        }
                    </FluentSelect>
                }
            </div>

            @if (_selectedEvolutionChannelId.HasValue && !string.IsNullOrWhiteSpace(_evolutionInstanceName))
            {
                <FluentLabel Typo="Typography.Body">
                    Instância: <strong>@_evolutionInstanceName</strong>
                </FluentLabel>
            }

            <FluentTextField Value="@_evolutionApiKey"
                             Label="API Key (oculta)"
                             TextFieldType="TextFieldType.Password"
                             ReadOnly="true"
                             Style="width: 100%;"
                             Autocomplete="off" />

            <div>
                <FluentLabel Style="display: block; margin-bottom: 4px;">Número de destino</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Bottom">
                    <FluentTextField Value="+55"
                                     ReadOnly="true"
                                     Style="width: 64px; flex-shrink: 0;"
                                     Autocomplete="off" />
                    <FluentTextField Value="@_evolutionDestinationPhone"
                                     ValueChanged="OnEvolutionDestinationChanged"
                                     Immediate="true"
                                     Placeholder="(62) 99880-8389"
                                     MaxLength="16"
                                     Style="flex: 1;"
                                     Autocomplete="off" />
                </FluentStack>
                <FluentLabel Style="display: block; margin-top: 4px; font-size: 0.8rem; color: var(--neutral-foreground-hint);">
                    Ex.: (62) 99880-8389 será enviado como 5562998808389.
                </FluentLabel>
                @if (!string.IsNullOrWhiteSpace(_evolutionDestinationError))
                {
                    <FluentLabel Style="display: block; margin-top: 4px; font-size: 0.8rem; color: var(--error-foreground);">
                        @_evolutionDestinationError
                    </FluentLabel>
                }
            </div>

            <FluentTextField @bind-Value="_evolutionTextToSend"
                             Label="Texto para envio"
                             Placeholder="Mensagem de teste"
                             Style="width: 100%;"
                             Autocomplete="off" />

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                <FluentLabel>Foto para envio</FluentLabel>
                <InputFile OnChange="HandleEvolutionPhotoSelected" accept="image/*" />
                @if (!string.IsNullOrWhiteSpace(_evolutionPhotoFileName))
                {
                    <FluentLabel Typo="Typography.Body">Arquivo selecionado: @_evolutionPhotoFileName</FluentLabel>
                }
            </FluentStack>

            @if (_isEvolutionLoading)
            {
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <FluentProgressRing Style="width: 20px; height: 20px;" />
                    <FluentLabel>Testando conexão com a Evolution API...</FluentLabel>
                </FluentStack>
            }
            else if (_evolutionResult != null)
            {
                @if (_evolutionSuccess)
                {
                    <FluentCard Style="padding: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentBadge Appearance="Appearance.Accent">✅ Conexão estabelecida com sucesso!</FluentBadge>
                            <FluentLabel Style="color: var(--neutral-foreground-rest); white-space: pre-wrap; word-break: break-word;">@_evolutionResult</FluentLabel>
                        </FluentStack>
                    </FluentCard>
                }
                else
                {
                    <FluentCard Style="padding: 1rem; background: var(--error-fill-rest, #f8d7da);">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentBadge Appearance="Appearance.Neutral">❌ Falha na conexão</FluentBadge>
                            <FluentLabel Style="color: var(--error-foreground, #721c24); font-weight: 600; white-space: pre-wrap; word-break: break-word;">@_evolutionResult</FluentLabel>
                        </FluentStack>
                    </FluentCard>
                }
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" @onclick="CloseEvolutionDialog">
            Fechar
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      @onclick="SendEvolutionText"
                      Disabled="@(_isEvolutionLoading || !_selectedEvolutionChannelId.HasValue || string.IsNullOrWhiteSpace(_evolutionTextToSend) || string.IsNullOrWhiteSpace(_evolutionDestinationPhone) || !_evolutionDestinationPhone.IsValidTelefone())">
            <FluentIcon Icon="@(Icons.Regular.Size16.Send)" Slot="start" Color="Color.Fill" />
            <span>Enviar texto</span>
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      @onclick="SendEvolutionPhoto"
                      Disabled="@(_isEvolutionLoading || !_selectedEvolutionChannelId.HasValue || _evolutionPhotoFile is null || string.IsNullOrWhiteSpace(_evolutionDestinationPhone) || !_evolutionDestinationPhone.IsValidTelefone())">
            <FluentIcon Icon="@(Icons.Regular.Size16.Image)" Slot="start" Color="Color.Fill" />
            <span>Enviar foto</span>
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      @onclick="TestEvolutionConnection"
                      Disabled="@(_isEvolutionLoading || string.IsNullOrWhiteSpace(_evolutionUrl) || string.IsNullOrWhiteSpace(_evolutionApiKey))">
            @if (_isEvolutionLoading)
            {
                <FluentProgressRing Style="width: 16px; height: 16px;" />
                <span style="margin-left: 0.5rem;">Testando...</span>
            }
            else
            {
                <FluentIcon Icon="@(Icons.Regular.Size16.PlugConnected)" Slot="start" Color="Color.Fill" />
                <span>Testar Conexão</span>
            }
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private bool _isLoading = true;
    private bool _disposed = false;
    private UserInfo? CurrentUser { get; set; }
    
    private const int ErrorToastTimeout = 8000; // 8 segundos
    private const string EvolutionDefaultInstanceName = "farmacia01";
    private const string EvolutionDefaultPhoneDigits = "62998808389"; // sem prefixo 55 (campo +55 é separado na UI)
    private const string EvolutionDefaultImageMimeType = "image/jpeg";

    // ── Dialog 1: Mock WhatsApp ──
    private bool _showMockWhatsAppDialog = false;
    private bool _isMockLoading = false;
    private string _mockPhoneNumber = "(62) 99123-6501";
    private string _mockFarmaciaIdStr = "1";
    private string _mockText = "teste";
    private bool _mockIsGroup;
    private MockWhatsAppResult? _mockResult;
    private string? _mockErrorMessage;

    // ── Dialog 5: Mock Instagram ──
    private bool _showMockInstagramDialog = false;
    private bool _isMockInstagramLoading = false;
    private string _mockInstagramFrom = "mock-ig-user-123";
    private string _mockInstagramFarmaciaIdStr = "1";
    private string _mockInstagramText = "teste";
    private MockWhatsAppResult? _mockInstagramResult;
    private string? _mockInstagramErrorMessage;

    // ── Dialog 2: API Health ──
    private bool _showApiHealthDialog = false;
    private bool _isHealthLoading = false;
    private ApiEndpointResult? _healthResult;
    private ApiEndpointResult? _systemInfoResult;
    private string? _healthErrorMessage;

    // ── Dialog 3: Queue Stats ──
    private bool _showQueueStatsDialog = false;
    private bool _isQueueLoading = false;
    private QueueStats? _queueStats;
    private string? _queueErrorMessage;

    // ── Dialog 4: Dashboard Stats ──
    private bool _showDashboardStatsDialog = false;
    private bool _isDashboardLoading = false;
    private DashboardStats? _dashboardStats;
    private string? _dashboardErrorMessage;

    // ── Dialog 6: Evolution API ──
    private bool _showEvolutionDialog = false;
    private bool _isEvolutionLoading = false;
    private bool _isLoadingEvolutionChannels = false;
    private List<ChannelListItem> _whatsappNaoOficialChannels = new();
    private int? _selectedEvolutionChannelId;
    private string _evolutionUrl = "";
    private string _evolutionApiKey = "";
    private string _evolutionInstanceName = EvolutionDefaultInstanceName;
    private string _evolutionDestinationPhone = EvolutionDefaultPhoneDigits;
    private string? _evolutionDestinationError;
    private string _evolutionTextToSend = "Mensagem de teste";
    private IBrowserFile? _evolutionPhotoFile;
    private string? _evolutionPhotoFileName;
    private string? _evolutionResult;
    private bool _evolutionSuccess = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            CurrentUser = await AuthService.GetUserInfo();
            if (CurrentUser == null)
            {
                Navigation.NavigateTo("/login");
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading user info on Tests page");
        }
        finally
        {
            _isLoading = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    // ══════════════════════════════
    // Dialog 1 — Mock WhatsApp
    // ══════════════════════════════

    private void OpenMockWhatsAppDialog()
    {
        _mockResult = null;
        _mockErrorMessage = null;
        if (CurrentUser?.IsAdministrador == true && !string.IsNullOrEmpty(CurrentUser.FarmaciaId))
            _mockFarmaciaIdStr = CurrentUser.FarmaciaId;
        _showMockWhatsAppDialog = true;
    }

    private void CloseMockWhatsAppDialog()
    {
        _showMockWhatsAppDialog = false;
        _mockResult = null;
        _mockErrorMessage = null;
    }

    private async Task SendMockWhatsAppMessage()
    {
        if (_isMockLoading) return;
        _mockResult = null;
        _mockErrorMessage = null;

        if (!int.TryParse(_mockFarmaciaIdStr, out int farmaciaId))
        {
            _mockErrorMessage = "FarmaciaId deve ser um número inteiro válido.";
            return;
        }

        var phoneDigits = new string(_mockPhoneNumber.Where(char.IsDigit).ToArray());
        if (phoneDigits.Length < 10)
        {
            _mockErrorMessage = "Informe um número de telefone válido com DDD.";
            return;
        }
        var fromNumber = "55" + phoneDigits;

        _isMockLoading = true;
        if (!_disposed) StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("PharmazapApi");
            var token = AuthService.CurrentUser?.Token;
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var payload = new
            {
                FarmaciaId = farmaciaId,
                From = fromNumber,
                Text = _mockText.Trim(),
                IsGroup = _mockIsGroup
            };
            var json = JsonSerializer.Serialize(payload);
            var content = new StringContent(json, Encoding.UTF8, "application/json");
            var response = await client.PostAsync("api/whatsapp/mock/mensagem", content);
            var responseBody = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(responseBody);
                var root = doc.RootElement;
                _mockResult = new MockWhatsAppResult
                {
                    Success = root.TryGetProperty("success", out var s) && s.GetBoolean(),
                    AtendimentoId = root.TryGetProperty("atendimentoId", out var aid) ? aid.GetInt32() : 0,
                    NovoAtendimento = root.TryGetProperty("novoAtendimento", out var na) && na.GetBoolean(),
                    Status = root.TryGetProperty("status", out var st) ? st.GetString() ?? "" : ""
                };
            }
            else
            {
                string errorMsg = "Erro desconhecido.";
                ErrorDetails? details = null;
                try
                {
                    using var doc = JsonDocument.Parse(responseBody);
                    if (doc.RootElement.TryGetProperty("error", out var err))
                        errorMsg = err.GetString() ?? errorMsg;
                    else if (doc.RootElement.TryGetProperty("message", out var msg))
                        errorMsg = msg.GetString() ?? errorMsg;
                    
                    // Capturar detalhes do erro se disponíveis
                    if (doc.RootElement.TryGetProperty("details", out var detailsObj))
                    {
                        details = new ErrorDetails
                        {
                            Message = detailsObj.TryGetProperty("message", out var m) ? m.GetString() : null,
                            InnerException = detailsObj.TryGetProperty("innerException", out var ie) ? ie.GetString() : null,
                            StackTrace = detailsObj.TryGetProperty("stackTrace", out var st) && st.ValueKind == JsonValueKind.Array
                                ? st.EnumerateArray().Select(x => x.GetString() ?? "").ToArray()
                                : null
                        };
                    }
                }
                catch { }
                _mockResult = new MockWhatsAppResult
                {
                    Success = false,
                    ErrorMessage = $"HTTP {(int)response.StatusCode}: {errorMsg}",
                    Details = details
                };
                
                // Exibir toast de erro
                ToastService.ShowError(errorMsg);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error calling mock WhatsApp endpoint");
            _mockErrorMessage = $"Exceção: {ex.Message}";
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isMockLoading = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

