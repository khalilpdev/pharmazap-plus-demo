<FluentDialog Modal="true" Hidden="@(!_showMockInstagramDialog)" TrapFocus="true"
              @ondialogdismiss="CloseMockInstagramDialog"
              Style="width: 520px;">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.Camera)" />
                <FluentLabel Typo="Typography.Subject">Testar Envio de Mensagem Mock Instagram</FluentLabel>
            </FluentStack>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseMockInstagramDialog" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="padding: 0.5rem 0;">
            <div>
                <FluentTextField @bind-Value="_mockInstagramFrom"
                                Label="Instagram ID (From)"
                                Placeholder="mock-ig-user-123"
                                Style="width: 100%;"
                                Autocomplete="off" />
            </div>
            @if (CurrentUser?.IsAdministrador == false)
            {
                <FluentTextField @bind-Value="_mockInstagramFarmaciaIdStr"
                                Label="FarmaciaId"
                                Placeholder="1"
                                Style="width: 100%;"
                                Autocomplete="off" />
            }
            <FluentTextField @bind-Value="_mockInstagramText"
                             Label="Texto da mensagem"
                             Placeholder="Olá, preciso renovar minha receita"
                             Style="width: 100%;"
                             Autocomplete="off" />

            @if (_isMockInstagramLoading)
            {
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <FluentProgressRing Style="width: 20px; height: 20px;" />
                    <FluentLabel>Enviando mensagem mock...</FluentLabel>
                </FluentStack>
            }
            else if (_mockInstagramResult != null)
            {
                @if (_mockInstagramResult.Success)
                {
                    <FluentCard Style="padding: 1rem;">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentBadge Appearance="Appearance.Accent">✅ Mensagem simulada com sucesso</FluentBadge>
                            <FluentLabel>Atendimento ID: <strong>@_mockInstagramResult.AtendimentoId</strong></FluentLabel>
                            <FluentLabel>Novo Atendimento: <strong>@(_mockInstagramResult.NovoAtendimento ? "Sim" : "Não")</strong></FluentLabel>
                            <FluentLabel>Status: <strong>@_mockInstagramResult.Status</strong></FluentLabel>
                        </FluentStack>
                    </FluentCard>
                }
                else
                {
                    <FluentCard Style="padding: 1rem; background: var(--error-fill-rest, #f8d7da);">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentBadge Appearance="Appearance.Neutral">❌ Erro ao enviar mensagem</FluentBadge>
                            <FluentLabel Style="margin-top: 0.5rem; color: var(--error-foreground, #721c24); font-weight: 600;">@_mockInstagramResult.ErrorMessage</FluentLabel>

                            @if (_mockInstagramResult.Details != null)
                            {
                                <FluentDivider Style="margin: 0.5rem 0;"/>
                                <FluentLabel Typo="Typography.Body" Style="color: var(--error-foreground, #721c24); font-weight: 600;">Detalhes do Erro:</FluentLabel>

                                @if (!string.IsNullOrEmpty(_mockInstagramResult.Details.InnerException))
                                {
                                    <FluentLabel Style="color: var(--error-foreground, #721c24); font-family: monospace; font-size: 0.85rem; white-space: pre-wrap; word-break: break-word;">
                                        <strong>Inner Exception:</strong> @_mockInstagramResult.Details.InnerException
                                    </FluentLabel>
                                }

                                @if (_mockInstagramResult.Details.StackTrace != null && _mockInstagramResult.Details.StackTrace.Length > 0)
                                {
                                    <FluentLabel Style="color: var(--error-foreground, #721c24); font-weight: 600; margin-top: 0.5rem;">Stack Trace (primeiras linhas):</FluentLabel>
                                    <FluentLabel Style="color: var(--error-foreground, #721c24); font-family: monospace; font-size: 0.75rem; white-space: pre-wrap; word-break: break-word;">
                                        @string.Join("\n", _mockInstagramResult.Details.StackTrace.Take(3))
                                    </FluentLabel>
                                }
                            }
                        </FluentStack>
                    </FluentCard>
                }
            }
            else if (_mockInstagramErrorMessage != null)
            {
                <FluentCard Style="padding: 1rem; background: var(--error-fill-rest, #f8d7da);">
                    <FluentBadge Appearance="Appearance.Neutral">❌ Erro</FluentBadge>
                    <FluentLabel Style="margin-top: 0.5rem; color: var(--error-foreground, #721c24); font-weight: 600;">@_mockInstagramErrorMessage</FluentLabel>
                </FluentCard>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" @onclick="CloseMockInstagramDialog">
            Fechar
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      @onclick="SendMockInstagramMessage"
                      Disabled="@(_isMockInstagramLoading || string.IsNullOrWhiteSpace(_mockInstagramFrom) || string.IsNullOrWhiteSpace(_mockInstagramText))">
            @if (_isMockInstagramLoading)
            {
                <FluentProgressRing Style="width: 16px; height: 16px;" />
                <span style="margin-left: 0.5rem;">Enviando...</span>
            }
            else
            {
                <FluentIcon Icon="@(Icons.Regular.Size16.Send)" Slot="start" Color="Color.Fill" />
                <span>Enviar Mock</span>
            }
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

