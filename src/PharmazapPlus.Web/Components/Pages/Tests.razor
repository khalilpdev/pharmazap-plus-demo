    private bool ValidateEvolutionDestinationPhone()
    {
        if (string.IsNullOrWhiteSpace(_evolutionDestinationPhone))
        {
            _evolutionDestinationError = "Informe um número com DDD.";
            return false;
        }

        if (!_evolutionDestinationPhone.IsValidTelefone())
        {
            _evolutionDestinationError = "Informe um número válido com DDD, como (62) 99880-8389.";
            return false;
        }

        _evolutionDestinationError = null;
        return true;
    }

    private void HandleEvolutionPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || string.IsNullOrWhiteSpace(file.ContentType) || !file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _evolutionPhotoFile = null;
            _evolutionPhotoFileName = null;
            ToastService.ShowError("Selecione um arquivo de imagem válido.");
            return;
        }

        _evolutionPhotoFile = file;
        _evolutionPhotoFileName = _evolutionPhotoFile.Name;
    }

    private async Task SendEvolutionText()
    {
        if (_isEvolutionLoading) return;

        _evolutionResult = null;
        _evolutionSuccess = false;
        _isEvolutionLoading = true;
        if (!_disposed) StateHasChanged();

        try
        {
            if (!ValidateEvolutionDestinationPhone())
            {
                ToastService.ShowError(_evolutionDestinationError ?? "Informe um número válido com DDD.");
                return;
            }

            var client = HttpClientFactory.CreateClient("PharmazapApi");
            var token = AuthService.CurrentUser?.Token;
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var to = _evolutionDestinationPhone.SanitizeDigits(11);
            var payload = new
            {
                To = to,
                Text = _evolutionTextToSend.Trim()
            };

            var response = await client.PostAsJsonAsync("api/whatsapp/send/text", payload);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _evolutionSuccess = true;
                _evolutionResult = $"Texto enviado para 55{to} com sucesso.\n\n{TryPrettyPrintJson(body)}";
                ToastService.ShowSuccess("Texto enviado com sucesso.");
            }
            else
            {
                _evolutionSuccess = false;
                _evolutionResult = $"Falha ao enviar texto.\nHTTP {(int)response.StatusCode} {response.ReasonPhrase}\n\n{body}";
                ToastService.ShowError("Falha ao enviar texto.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending text message from Tests page");
            _evolutionSuccess = false;
            _evolutionResult = $"Erro ao enviar texto: {ex.Message}";
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isEvolutionLoading = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendEvolutionPhoto()
    {
        if (_isEvolutionLoading || _evolutionPhotoFile is null) return;

        _evolutionResult = null;
        _evolutionSuccess = false;
        _isEvolutionLoading = true;
        if (!_disposed) StateHasChanged();

        try
        {
            if (!ValidateEvolutionDestinationPhone())
            {
                ToastService.ShowError(_evolutionDestinationError ?? "Informe um número válido com DDD.");
                return;
            }

            var client = HttpClientFactory.CreateClient("PharmazapApi");
            var token = AuthService.CurrentUser?.Token;
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var to = _evolutionDestinationPhone.SanitizeDigits(11);
            await using var stream = _evolutionPhotoFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var streamContent = new StreamContent(stream);
            var contentType = string.IsNullOrWhiteSpace(_evolutionPhotoFile.ContentType)
                ? EvolutionDefaultImageMimeType
                : _evolutionPhotoFile.ContentType;
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(contentType);

            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(to), "To");
            form.Add(new StringContent("image"), "MediaType");
            var caption = _evolutionTextToSend.Trim();
            if (!string.IsNullOrWhiteSpace(caption))
                form.Add(new StringContent(caption), "Caption");
            form.Add(streamContent, "MediaFile", _evolutionPhotoFile.Name);

            var response = await client.PostAsync("api/whatsapp/send/media", form);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _evolutionSuccess = true;
                _evolutionResult = $"Foto enviada para 55{to} com sucesso.\n\n{TryPrettyPrintJson(body)}";
                ToastService.ShowSuccess("Foto enviada com sucesso.");
            }
            else
            {
                _evolutionSuccess = false;
                _evolutionResult = $"Falha ao enviar foto.\nHTTP {(int)response.StatusCode} {response.ReasonPhrase}\n\n{body}";
                ToastService.ShowError("Falha ao enviar foto.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending photo message from Tests page");
            _evolutionSuccess = false;
            _evolutionResult = $"Erro ao enviar foto: {ex.Message}";
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isEvolutionLoading = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task TestEvolutionConnection()
    {
        if (_isEvolutionLoading) return;
        _evolutionResult = null;
        _evolutionSuccess = false;
        _isEvolutionLoading = true;
        if (!_disposed) StateHasChanged();

        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.DefaultRequestHeaders.Add("apikey", _evolutionApiKey.Trim());
            client.Timeout = TimeSpan.FromSeconds(15);

            var url = _evolutionUrl.TrimEnd('/') + "/instance/fetchInstances";
            var response = await client.GetAsync(url);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _evolutionSuccess = true;
                var prettyBody = TryPrettyPrintJson(body);
                _evolutionResult = $"HTTP {(int)response.StatusCode} — A Evolution API respondeu com sucesso.\n\n{prettyBody}";
                ToastService.ShowSuccess("Evolution API online!");
            }
            else
            {
                _evolutionSuccess = false;
                _evolutionResult = $"HTTP {(int)response.StatusCode} {response.ReasonPhrase}\n\n{body}";
                ToastService.ShowError($"Falha: HTTP {(int)response.StatusCode}");
            }
        }
        catch (TaskCanceledException)
        {
            _evolutionSuccess = false;
            _evolutionResult = "Tempo limite excedido (15 s). Verifique se a URL está correta e acessível.";
            ToastService.ShowError("Timeout ao conectar à Evolution API.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error testing Evolution API connection");
            _evolutionSuccess = false;
            _evolutionResult = $"Erro: {ex.Message}";
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isEvolutionLoading = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadEvolutionChannelsAsync()
    {
        _isLoadingEvolutionChannels = true;
        if (!_disposed) StateHasChanged();
        try
        {
            var (success, channels, _) = await ChannelService.GetChannelsAsync();
            if (success)
            {
                _whatsappNaoOficialChannels = channels
                    .Where(c => c.Type == (int)ChannelType.WhatsApp && !c.IsOfficial && c.Configured)
                    .ToList();

                // Auto-select when only one channel available
                if (_whatsappNaoOficialChannels.Count == 1)
                {
                    var only = _whatsappNaoOficialChannels.Single();
                    _selectedEvolutionChannelId = only.Id;
                    await LoadEvolutionDefaultsFromChannelAsync(only.Id);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load WhatsApp Non-Official channels.");
        }
        finally
        {
            _isLoadingEvolutionChannels = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnEvolutionChannelChanged(string? value)
    {
        _evolutionUrl = "";
        _evolutionApiKey = "";
        _evolutionInstanceName = EvolutionDefaultInstanceName;

        if (int.TryParse(value, out var id))
        {
            _selectedEvolutionChannelId = id;
            await LoadEvolutionDefaultsFromChannelAsync(id);
        }
        else
        {
            _selectedEvolutionChannelId = null;
        }
        if (!_disposed) StateHasChanged();
    }

    private async Task LoadEvolutionDefaultsFromChannelAsync(int channelId)
    {
        try
        {
            var (success, channel, message) = await ChannelService.GetChannelByIdAsync(channelId);
            if (!success || channel == null)
            {
                if (!string.IsNullOrWhiteSpace(message))
                    Logger.LogDebug("Evolution API channel load failed: {Message}", message);
                return;
            }

            if (!string.IsNullOrWhiteSpace(channel.ApiUrl))
                _evolutionUrl = channel.ApiUrl;

            if (!string.IsNullOrWhiteSpace(channel.ApiKey))
                _evolutionApiKey = channel.ApiKey;
            else if (!string.IsNullOrWhiteSpace(Configuration["GLOBAL_API_KEY"]))
                _evolutionApiKey = Configuration["GLOBAL_API_KEY"]!;

            _evolutionInstanceName = (!string.IsNullOrWhiteSpace(channel.InstanceName) ? channel.InstanceName : null)
                ?? (!string.IsNullOrWhiteSpace(channel.Name) ? channel.Name : null)
                ?? EvolutionDefaultInstanceName;
        }
        catch (Exception ex)
        {
            var farmaciaId = CurrentUser?.FarmaciaId ?? "unknown";
            Logger.LogWarning(ex, "Could not load Evolution API configuration for channel {ChannelId}, FarmaciaId {FarmaciaId}.", channelId, farmaciaId);
        }
    }

    private static string TryPrettyPrintJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return json;
        try
        {
            var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

