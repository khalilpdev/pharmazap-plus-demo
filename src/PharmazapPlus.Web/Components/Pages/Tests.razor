    private async Task LoadApiHealth()
    {
        if (_isHealthLoading) return;
        _isHealthLoading = true;
        _healthResult = null;
        _systemInfoResult = null;
        _healthErrorMessage = null;
        if (!_disposed) StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("PharmazapApi");

            // GET /health
            var swHealth = Stopwatch.StartNew();
            try
            {
                var healthResponse = await client.GetAsync("health");
                swHealth.Stop();
                var healthBody = await healthResponse.Content.ReadAsStringAsync();
                string prettyJson = TryPrettyPrintJson(healthBody);
                _healthResult = new ApiEndpointResult
                {
                    IsOnline = healthResponse.IsSuccessStatusCode,
                    HttpStatusCode = (int)healthResponse.StatusCode,
                    ResponseTimeMs = (int)swHealth.ElapsedMilliseconds,
                    HealthJson = prettyJson
                };
            }
            catch (Exception ex)
            {
                swHealth.Stop();
                _healthResult = new ApiEndpointResult
                {
                    IsOnline = false,
                    HttpStatusCode = 0,
                    ResponseTimeMs = (int)swHealth.ElapsedMilliseconds,
                    HealthJson = null
                };
                Logger.LogWarning(ex, "Error calling /health endpoint");
            }

            // GET /system/info
            var swInfo = Stopwatch.StartNew();
            try
            {
                var infoResponse = await client.GetAsync("system/info");
                swInfo.Stop();
                var infoBody = await infoResponse.Content.ReadAsStringAsync();
                string prettyJson = TryPrettyPrintJson(infoBody);
                _systemInfoResult = new ApiEndpointResult
                {
                    IsOnline = infoResponse.IsSuccessStatusCode,
                    HttpStatusCode = (int)infoResponse.StatusCode,
                    ResponseTimeMs = (int)swInfo.ElapsedMilliseconds,
                    InfoJson = prettyJson
                };
            }
            catch (Exception ex)
            {
                swInfo.Stop();
                _systemInfoResult = new ApiEndpointResult
                {
                    IsOnline = false,
                    HttpStatusCode = 0,
                    ResponseTimeMs = (int)swInfo.ElapsedMilliseconds,
                    InfoJson = null
                };
                Logger.LogWarning(ex, "Error calling /system/info endpoint");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading API health");
            _healthErrorMessage = $"Erro inesperado: {ex.Message}";
        }
        finally
        {
            _isHealthLoading = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

