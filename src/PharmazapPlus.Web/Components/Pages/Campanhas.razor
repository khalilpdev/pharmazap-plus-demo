    }

    private async Task ExecutarExcluir()
    {
        if (_campanhaSelecionada == null) return;
        var (success, message) = await PharmazapApiService.DeleteCampanhaAsync(_campanhaSelecionada.Id);
        if (success)
        {
            ToastService.ShowSuccess("Campanha excluída com sucesso!");
            _showConfirmExcluir = false;
            await LoadCampanhas();
        }
        else
        {
            ToastService.ShowError(message ?? "Erro ao excluir campanha");
        }
    }

    // ── Cancelar ─────────────────────────────────────────────────────────

    private void ConfirmarCancelar(Campanha campanha)
    {
        _campanhaSelecionada = campanha;
        _showConfirmCancelar = true;
    }

    private void CloseConfirmCancelar()
    {
        _showConfirmCancelar = false;
        StateHasChanged();
    }

    private async Task ExecutarCancelar()
    {
        if (_campanhaSelecionada == null) return;
        var (success, message) = await PharmazapApiService.CancelarCampanhaAsync(_campanhaSelecionada.Id);
        if (success)
