            ToastService.ShowError(message ?? "Erro ao cancelar campanha");
        }
    }

    // ── Helpers ─────────────────────────────────────────────────────────

    private RenderFragment GetStatusBadge(Campanha campanha) => campanha.Status switch
    {
        CampanhaStatusEnum.Rascunho   => @<FluentBadge Appearance="Appearance.Neutral">Rascunho</FluentBadge>,
        CampanhaStatusEnum.Agendada   => @<FluentBadge Appearance="Appearance.Accent">Agendada</FluentBadge>,
        CampanhaStatusEnum.Executando => @<FluentBadge Appearance="Appearance.Accent">Executando...</FluentBadge>,
        CampanhaStatusEnum.Concluida  => @<FluentBadge Appearance="Appearance.Neutral" Style="background: #107C10; color: white;">Concluída</FluentBadge>,
        CampanhaStatusEnum.Cancelada  => @<FluentBadge Appearance="Appearance.Neutral">Cancelada</FluentBadge>,
        CampanhaStatusEnum.ComErro    => @<FluentBadge Appearance="Appearance.Neutral" Style="background: var(--error-foreground, #D13438); color: white;">Com Erro</FluentBadge>,
        _                             => @<FluentBadge Appearance="Appearance.Neutral">@campanha.Status</FluentBadge>
    };

    public void Dispose() => _disposed = true;
}
