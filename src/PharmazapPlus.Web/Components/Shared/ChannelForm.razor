<FluentDialog Modal="true" Hidden="@(!_showInstanceConfirmDialog)" TrapFocus="true"
              @ondialogdismiss="CancelInstanceCreate"
              Style="max-width: 480px; width: 95%; background: var(--neutral-layer-1); color: var(--neutral-foreground-rest);">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.Warning)" />
                <FluentLabel Typo="Typography.Subject">Instância não encontrada</FluentLabel>
            </FluentStack>
            <div style="margin-left: auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CancelInstanceCreate" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding: 0.5rem 0;">
            <FluentMessageBar Intent="@MessageIntent.Warning" Style="width: 100%;">
                A instância <strong>@GetInstanceDisplayValue(Model.InstanceName)</strong> não foi encontrada na Evolution Go.
            </FluentMessageBar>
            <FluentLabel>
                Deseja criar a instância agora? Ela será criada com todas as permissões de mensagens e mídias necessárias para o funcionamento do PharmazapPlus.
            </FluentLabel>
            <FluentLabel Style="font-size: 0.85em; color: var(--neutral-foreground-hint);">
                Se recusar, o canal não será salvo.
            </FluentLabel>
