    private void OnTypeChanged(string? value)
    {
        _selectedType = value ?? "1";
        if (int.TryParse(_selectedType, out var typeValue) && Enum.IsDefined(typeof(ChannelType), typeValue))
        {
            Model.Type = (ChannelType)typeValue;
        }

        if (Model.Type == ChannelType.Instagram)
        {
            Model.IsOfficial = true;
            _isOfficial = "true";
            ResetMetaWizard();
        }
        else if (Model.Type == ChannelType.WhatsApp && !Model.IsOfficial)
        {
            EnsureNonOfficialDefaults();
        }

        if (Model.Type != ChannelType.WhatsApp || Model.IsOfficial)
        {
            ResetInstanceOptions();
        }

    }

    private void OnOfficialChanged(string? value)
    {
        _isOfficial = value ?? "true";
        Model.IsOfficial = bool.TryParse(_isOfficial, out var parsed) && parsed;

        if (Model.IsOfficial)
        {
            ResetInstanceOptions();
            if (Model.Type == ChannelType.WhatsApp)
            {
                ResetMetaWizard();
            }
        }
        else if (Model.Type == ChannelType.WhatsApp)
        {
            EnsureNonOfficialDefaults();
        }
    }

    private async Task BeginMetaOAuthAsync()
    {
        if (ChannelService == null)
        {
            await JSRuntime.InvokeVoidAsync("metaOAuthInterop.closePendingPopup");
            return;
        }

        _metaOAuthInProgress = true;
        _metaOAuthMessage = null;
        StateHasChanged();

        try
        {
            if (UsesOwnMetaConfig)
            {
                if (string.IsNullOrWhiteSpace(Model.MetaAppId))
                {
                    const string appIdMessage = "Informe o Meta App ID do app da farmácia antes de conectar.";
                    await JSRuntime.InvokeVoidAsync("metaOAuthInterop.showPendingPopupError", appIdMessage);
                    _metaOAuthMessageIntent = MessageIntent.Warning;
                    _metaOAuthMessage = appIdMessage;
                    ToastService.ShowWarning(appIdMessage);
                    return;
                }

                if (string.IsNullOrWhiteSpace(Model.MetaAppSecret) && !Model.HasPersistedMetaAppSecret)
                {
                    const string appSecretMessage = "Informe o Meta App Secret do app da farmácia antes de conectar.";
                    await JSRuntime.InvokeVoidAsync("metaOAuthInterop.showPendingPopupError", appSecretMessage);
                    _metaOAuthMessageIntent = MessageIntent.Warning;
                    _metaOAuthMessage = appSecretMessage;
                    ToastService.ShowWarning(appSecretMessage);
                    return;
                }
            }

            var result = await ChannelService.StartMetaOAuthAsync(
                IsInstagramWizard ? ChannelType.Instagram : ChannelType.WhatsApp,
                Model.MetaConfigSource,
                Model.MetaAppMode,
                Model.MetaAppId,
                Model.MetaAppSecret,
                ChannelId);

            if (!result.Success || string.IsNullOrWhiteSpace(result.AuthorizationUrl))
            {
                var friendlyMessage = NormalizeMetaOAuthStartMessage(result.Error ?? result.Message);
                await JSRuntime.InvokeVoidAsync("metaOAuthInterop.showPendingPopupError", friendlyMessage);
                _metaOAuthMessageIntent = MessageIntent.Warning;
                _metaOAuthMessage = friendlyMessage;
                ToastService.ShowWarning(_metaOAuthMessage);
                return;
            }

            _metaOAuthMessageIntent = MessageIntent.Info;
            _metaOAuthMessage = result.Message ?? "A janela do Facebook foi aberta. Faça login, escolha a conta da farmácia e autorize o acesso para continuar.";
            await JSRuntime.InvokeVoidAsync("metaOAuthInterop.openPopup", result.AuthorizationUrl);
            ToastService.ShowInfo(_metaOAuthMessage);
        }
        finally
        {
            _metaOAuthInProgress = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task HandleMetaOAuthMessage(string payloadJson)
    {
        MetaOAuthPopupResult? result;
        try
        {
            result = JsonSerializer.Deserialize<MetaOAuthPopupResult>(payloadJson, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
        }
        catch
        {
            _metaOAuthMessageIntent = MessageIntent.Warning;
            _metaOAuthMessage = "Recebemos uma resposta inválida da Meta.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (result == null)
        {
            _metaOAuthMessageIntent = MessageIntent.Warning;
            _metaOAuthMessage = "Recebemos uma resposta vazia da Meta.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!result.Success)
        {
            _metaOAuthMessageIntent = MessageIntent.Warning;
            _metaOAuthMessage = string.IsNullOrWhiteSpace(result.Message)
                ? "A conexão com a Meta não foi concluída."
                : result.Message;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.IsNullOrWhiteSpace(result.AccessToken))
            Model.AccessToken = result.AccessToken;

        if (IsInstagramWizard)
        {
            if (!string.IsNullOrWhiteSpace(result.InstagramBusinessId))
                Model.InstagramBusinessId = result.InstagramBusinessId;
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(result.PhoneNumberId))
                Model.PhoneNumberId = result.PhoneNumberId;

            if (!string.IsNullOrWhiteSpace(result.BusinessAccountId))
                Model.BusinessAccountId = result.BusinessAccountId;
            else if (!string.IsNullOrWhiteSpace(result.WhatsAppBusinessAccountId))
                Model.BusinessAccountId = result.WhatsAppBusinessAccountId;
        }

        Model.IsOfficial = true;
        _isOfficial = "true";
        _metaWizardStep = 1;
        _metaOAuthMessageIntent = MessageIntent.Success;
        _metaOAuthMessage = string.IsNullOrWhiteSpace(result.Message)
            ? "Conexão com a Meta concluída."
            : result.Message;
        ToastService.ShowSuccess(_metaOAuthMessage);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RegisterMetaOAuthListenerAsync()
    {
        if (_metaOAuthListenerRegistered || string.IsNullOrWhiteSpace(_apiOrigin))
            return;

        _metaOAuthDotNetRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("metaOAuthInterop.register", _metaOAuthDotNetRef, _apiOrigin);
        _metaOAuthListenerRegistered = true;
    }

    private static string? TryGetOrigin(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return null;

        return Uri.TryCreate(url, UriKind.Absolute, out var uri)
            ? uri.GetLeftPart(UriPartial.Authority)
            : null;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_metaOAuthListenerRegistered)
            {
                await JSRuntime.InvokeVoidAsync("metaOAuthInterop.unregister");
            }
        }
        catch
        {
        }
        finally
        {
            _metaOAuthDotNetRef?.Dispose();
        }
    }

