            {
                <FluentMessageBar Intent="@MessageIntent.Error" Style="width: 100%;">
                    @_instanceExistsDialogError
                </FluentMessageBar>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" @onclick="ContinueWithExistingInstanceAsync" Disabled="@_recreatingExistingInstance">
            Usar instância existente
        </FluentButton>
        <FluentButton Appearance="Appearance.Outline" @onclick="RecreateExistingInstanceAsync" Disabled="@_recreatingExistingInstance">
            @if (_recreatingExistingInstance)
            {
                <FluentProgressRing Style="width: 14px; height: 14px; margin-right: 6px;" />
            }
            Remover e recriar
        </FluentButton>
        <FluentButton Appearance="Appearance.Neutral" @onclick="CancelRecreateExistingInstance" Disabled="@_recreatingExistingInstance">
            Cancelar
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog Modal="true" Hidden="@(!_showHelpDialog)" TrapFocus="true"
              @ondialogdismiss="CloseHelpDialog"
              Style="max-width: 680px; width: 95%; background: var(--neutral-layer-1); color: var(--neutral-foreground-rest);">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.QuestionCircle)" />
                <FluentLabel Typo="Typography.Subject">@_helpDialogTitle</FluentLabel>
            </FluentStack>
            <div style="margin-left: auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseHelpDialog" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding: 0.5rem 0;">
            <FluentLabel Style="line-height: 1.5;">@_helpDialogDescription</FluentLabel>
