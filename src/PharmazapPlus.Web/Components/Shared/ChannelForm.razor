            {
                <FluentMessageBar Intent="@MessageIntent.Error" Style="width: 100%;">
                    @_instanceCreateError
                </FluentMessageBar>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmAndCreateInstance" Disabled="@_instanceCreating">
            @if (_instanceCreating)
            {
                <FluentProgressRing Style="width: 14px; height: 14px; margin-right: 6px;" />
            }
            Criar instância e salvar
        </FluentButton>
        <FluentButton Appearance="Appearance.Neutral" @onclick="CancelInstanceCreate" Disabled="@_instanceCreating">
            Cancelar
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    [Parameter, EditorRequired] public ChannelCreateRequest Model { get; set; } = new();
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public EventCallback<ChannelCreateRequest> OnValidSubmit { get; set; }
    [Parameter] public IChannelService? ChannelService { get; set; }
    [Parameter] public string? CurrentFarmaciaId { get; set; }
    [Parameter] public string? CurrentFarmaciaNome { get; set; }
    [Parameter] public int? ChannelId { get; set; }

    private bool IsAccessTokenRequired => Model.Type == ChannelType.WhatsApp && Model.IsOfficial;
    private bool IsIntegrationSelectorDisabled => Model.Type == ChannelType.Instagram;
    private string SelectedFarmaciaValue => string.IsNullOrWhiteSpace(CurrentFarmaciaId) ? "__current__" : CurrentFarmaciaId!;
    private string SelectedFarmaciaLabel => string.IsNullOrWhiteSpace(CurrentFarmaciaNome)
        ? (string.IsNullOrWhiteSpace(CurrentFarmaciaId) ? "Farmácia atual" : $"Farmácia #{CurrentFarmaciaId}")
        : (string.IsNullOrWhiteSpace(CurrentFarmaciaId) ? CurrentFarmaciaNome! : $"{CurrentFarmaciaNome} (ID {CurrentFarmaciaId})");
    private string _nonOfficialEvolutionApiUrl = "http://localhost:8080";

    private enum HelpTopic
    {
        MetaAppId,
        MetaAppSecret,
        PhoneNumberId,
        BusinessAccountId,
        InstagramBusinessId,
        AccessToken,
        ApiUrl,
        ApiKey,
        InstanceName
    }

    private string _selectedType = "1";
    private string _isOfficial = "true";
    private string _metaConfigSource = ((int)MetaConfigSource.Own).ToString();
    private bool _showHelpDialog;
    private string _helpDialogTitle = string.Empty;
    private string _helpDialogDescription = string.Empty;
    private string _helpDialogTip = string.Empty;
    private List<string> _helpDialogSteps = new();
    private readonly string[] MetaWizardSteps = ["Conectar", "Confirmar dados", "Salvar canal"];
    private string _metaWizardMode = ((int)MetaAppMode.Production).ToString();
    private int _metaWizardStep;
    private const string MetaAppDashboardUrl = "https://developers.facebook.com/apps/";
    private bool ShowMetaWizard => Model.Type == ChannelType.Instagram || (Model.Type == ChannelType.WhatsApp && Model.IsOfficial);
    private string MetaChannelLabel => Model.Type == ChannelType.Instagram ? "Instagram" : "WhatsApp";
    private bool IsInstagramWizard => Model.Type == ChannelType.Instagram;
    private bool UsesOwnMetaConfig => Model.MetaConfigSource == MetaConfigSource.Own;
    private bool UsesCentralMetaConfig => Model.MetaConfigSource == MetaConfigSource.PharmazapCentral;
    private bool HasImportedMetaCredentials => IsInstagramWizard
        ? !string.IsNullOrWhiteSpace(Model.InstagramBusinessId) || !string.IsNullOrWhiteSpace(Model.AccessToken)
        : !string.IsNullOrWhiteSpace(Model.PhoneNumberId) || !string.IsNullOrWhiteSpace(Model.BusinessAccountId) || !string.IsNullOrWhiteSpace(Model.AccessToken);
    private MessageIntent MetaCredentialsMessageIntent => HasImportedMetaCredentials ? MessageIntent.Success : MessageIntent.Info;
    private string MetaCredentialsMessage => HasImportedMetaCredentials
        ? "Dados trazidos da Meta. Confira as informações abaixo e ajuste apenas se necessário antes de salvar."
        : "Se a conexão não preencher tudo automaticamente, você ainda pode informar os dados manualmente abaixo.";
    private MessageIntent MetaStepMessageIntent => _metaWizardStep == 1
        ? MetaCredentialsMessageIntent
        : MessageIntent.Info;
    private string MetaStepMessage => _metaWizardStep == 1
        ? MetaCredentialsMessage
        : MetaWizardReviewMessage;
    private string MetaWizardIntroMessage => UsesOwnMetaConfig
        ? IsInstagramWizard
            ? "Use o App ID e o App Secret do app Meta da farmácia para conectar o Instagram profissional com o próprio aplicativo do cliente."
            : "Use o App ID e o App Secret do app Meta da farmácia para conectar o WhatsApp Business com o próprio aplicativo do cliente."
        : IsInstagramWizard
            ? "Entre com o Facebook da farmácia para localizar a conta profissional do Instagram e preencher os campos automaticamente."
            : "Entre com o Facebook da farmácia para localizar o número e a conta do WhatsApp Business e preencher os campos automaticamente.";
    private string MetaWizardReviewMessage => IsInstagramWizard
        ? "Antes de salvar, confirme se a conta do Instagram encontrada pertence à farmácia correta e se a permissão de mensagens está liberada."
        : "Antes de salvar, confirme se o número e a conta do WhatsApp Business encontrados pertencem à farmácia correta.";
    private bool _metaOAuthInProgress;
    private string? _metaOAuthMessage;
    private MessageIntent _metaOAuthMessageIntent = MessageIntent.Info;
    private string? _apiOrigin;
    private DotNetObjectReference<ChannelForm>? _metaOAuthDotNetRef;
    private bool _metaOAuthListenerRegistered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // On edit, if the user has an existing instance name (e.g., landed on
            // /channels/edit/{id}), auto-run the status validation once so the Save
            // button is enabled when the instance is already connected — avoiding
            // forcing them to re-scan the QR Code for routine edits.
            await TryAutoValidateInstanceStatusAsync();
            return;
        }

        _apiOrigin = TryGetOrigin(Configuration["Application:ApiUrl"]);
        await RegisterMetaOAuthListenerAsync();
        await TryAutoValidateInstanceStatusAsync();
    }

    private async Task TryAutoValidateInstanceStatusAsync()
    {
        if (!ChannelId.HasValue) return;
        if (!RequiresInstanceConnection) return;
        if (_instanceConnected) return;
        if (_validatingInstanceStatus) return;
        if (string.IsNullOrWhiteSpace(Model.InstanceName)) return;

        var instanceName = Model.InstanceName;
        if (string.Equals(instanceName, _lastAutoValidatedInstanceName, StringComparison.Ordinal))
            return;

        _lastAutoValidatedInstanceName = instanceName;
        await ValidateInstanceStatusAsync();
    }

    protected override void OnParametersSet()
    {
        var configuredNonOfficialApiUrl = Configuration["WhatsApp:NonOfficialApiUrl"];
        if (!string.IsNullOrWhiteSpace(configuredNonOfficialApiUrl))
            _nonOfficialEvolutionApiUrl = configuredNonOfficialApiUrl.Trim();

        _selectedType = ((int)Model.Type).ToString();
        _isOfficial = Model.IsOfficial ? "true" : "false";

        if (Model.Type == ChannelType.Instagram)
        {
            Model.IsOfficial = true;
            _isOfficial = "true";
        }

        if (Model.Type != ChannelType.WhatsApp || Model.IsOfficial)
        {
            ResetInstanceOptions();
        }
        else
        {
            EnsureNonOfficialDefaults();
            Model.InstanceName = SanitizeInstanceIdentifier(Model.InstanceName);
        }

        EnsureMetaConfigSource();
        EnsureMetaAppMode();

        if (!ShowMetaWizard)
        {
            ResetMetaWizard();
        }
        else if (_metaWizardStep >= MetaWizardSteps.Length)
        {
            ResetMetaWizard();
        }
    }

    // --- Instance confirm dialog state ---
    private bool _showInstanceConfirmDialog;
    private bool _instanceValidating;
    private bool _instanceCreating;
    private string? _instanceCreateError;
    private string? _instanceOptionsMessage;
    private MessageIntent _instanceOptionsMessageIntent = MessageIntent.Info;
    private bool _showQrCodeDialog;
    private bool _loadingQrCode;
    private string? _qrCodeImageUrl;
    private string? _qrCodeImageDataUrl;
    private string? _qrCodeError;
    // Pairing code mode state
    private bool _qrDialogUsePairingCode;
    private string _pairingCodePhone = "";
    private bool _loadingPairingCode;
    private string? _pairingCode;
    private string? _pairingCodeError;
    private bool _showInstanceExistsDialog;
    private bool _recreatingExistingInstance;
    private string? _instanceExistsDialogError;
    private bool _validatingInstanceStatus;
    private string? _instanceStatusMessage;
    private MessageIntent _instanceStatusMessageIntent = MessageIntent.Info;
    private string? _instanceValidationError;
    // Set to true only after "Validar status" confirms the Evolution instance is connected
    // (OPEN/CONNECTED). Used to gate the Save button in the non-official WhatsApp flow so
    // channels cannot be persisted before the QR Code has been scanned and validated.
    private bool _instanceConnected;
    // Tracks the last instance name for which an auto-validation was performed on the edit
    // screen. Avoids re-triggering the auto-validation on every render.
    private string? _lastAutoValidatedInstanceName;
    private bool CanGenerateQrCode =>
        ChannelService != null &&
        Model.Type == ChannelType.WhatsApp &&
        !Model.IsOfficial &&
        !string.IsNullOrWhiteSpace(Model.InstanceName);
    private bool CanReloadInstanceOptions =>
        ChannelService != null &&
        Model.Type == ChannelType.WhatsApp &&
        !Model.IsOfficial &&
        !string.IsNullOrWhiteSpace(Model.InstanceName);
    // Non-official WhatsApp channels can only be saved after the Evolution instance has been
    // validated as connected (QR Code scanned successfully). Other channel types skip this gate.
    private bool RequiresInstanceConnection =>
        Model.Type == ChannelType.WhatsApp && !Model.IsOfficial;
    private bool CanSubmitNonOfficialWhatsApp =>
        !RequiresInstanceConnection || _instanceConnected;
    private Task HandleSubmit() => ValidateAndSubmitAsync();

    private async Task ValidateAndSubmitAsync()
    {
        // For non-official WhatsApp channels, the Evolution instance must be validated
        // as connected (QR Code scanned) before saving. This mirrors the button disabled
        // state and prevents accidental submissions via Enter key.
        if (RequiresInstanceConnection && !_instanceConnected)
        {
            _instanceStatusMessageIntent = MessageIntent.Warning;
            _instanceStatusMessage = "Gere o QR Code, escaneie no WhatsApp e clique em \"Validar status\" para confirmar a conexão antes de salvar.";
            ToastService.ShowWarning(_instanceStatusMessage);
            StateHasChanged();
            return;
        }

        // For non-official WhatsApp channels, validate that the Evolution Go instance exists
        // before allowing the channel to be saved.
        if (Model.Type == ChannelType.WhatsApp && !Model.IsOfficial && ChannelService != null &&
            !string.IsNullOrWhiteSpace(Model.InstanceName) &&
            CanReloadInstanceOptions)
        {
            EnsureNonOfficialDefaults();
            _instanceValidating = true;
            _instanceCreateError = null;
            StateHasChanged();

            InstanceInfoResult info;
            try
            {
                info = await ChannelService.CheckInstanceExistsAsync(
                    Model.InstanceName,
                    Model.ApiUrl ?? string.Empty,
                    string.Empty);
            }
            finally
            {
                _instanceValidating = false;
                StateHasChanged();
            }

            if (!info.Success)
            {
                // Cannot reach Evolution Go — let the backend handle the error during save
                await OnValidSubmit.InvokeAsync(Model);
                return;
            }

            if (!info.Exists)
            {
                _instanceOptionsMessageIntent = MessageIntent.Warning;
                _instanceOptionsMessage = "Instância não encontrada na Evolution. Você pode criar agora e continuar.";
                // Show confirmation dialog to offer creating the instance
                _showInstanceConfirmDialog = true;
                StateHasChanged();
                return;
            }

            // Block save on new channel registration if the Evolution instance is already
            // connected. This prevents a new canal from hijacking an instance that is
            // actively paired with another number. Editing an existing channel is allowed
            // since it already owns the instance.
            if (!ChannelId.HasValue && IsEvolutionStatusConnected(info.Status))
            {
                _instanceValidationError = "Esta instância já está conectada a outro número de WhatsApp. " +
                    "Para usar este identificador, remova o QR Code do outro número primeiro.";
                _instanceStatusMessageIntent = MessageIntent.Error;
                _instanceStatusMessage = _instanceValidationError;
                ToastService.ShowError(_instanceValidationError);
                StateHasChanged();
                return;
            }

            _instanceOptionsMessageIntent = MessageIntent.Success;
            _instanceOptionsMessage = IsEvolutionStatusConnected(info.Status)
                ? "Instância encontrada e conectada. Pronto para salvar o canal."
                : $"Instância encontrada ({GetEvolutionStatusLabel(info.Status)}).";
        }

        await OnValidSubmit.InvokeAsync(Model);
    }

    private async Task ConfirmAndCreateInstance()
    {
        if (ChannelService == null) return;

        _instanceCreating = true;
        _instanceCreateError = null;
        StateHasChanged();

        try
        {
            EnsureNonOfficialDefaults();
            var result = await ChannelService.EnsureInstanceCreatedAsync(
                Model.InstanceName!,
                Model.ApiUrl ?? string.Empty);
            if (result.Success)
            {
                _showInstanceConfirmDialog = false;
                await OnValidSubmit.InvokeAsync(Model);
            }
            else
            {
                _instanceCreateError = result.Error ?? "Não foi possível criar a instância. Verifique as configurações e tente novamente.";
            }
        }
        catch (Exception)
        {
            _instanceCreateError = "Erro ao criar a instância. Verifique as configurações e tente novamente.";
        }
        finally
        {
            _instanceCreating = false;
            StateHasChanged();
        }
    }

    private void CancelInstanceCreate()
    {
        _showInstanceConfirmDialog = false;
        _instanceCreateError = null;
    }

    private async Task GenerateQrCodeAsync()
    {
        if (!CanGenerateQrCode || ChannelService == null)
            return;

        EnsureNonOfficialDefaults();
        _loadingQrCode = true;
        _qrCodeError = null;
        _qrCodeImageUrl = null;
        _qrCodeImageDataUrl = null;
        _showQrCodeDialog = false;
        StateHasChanged();

        var ensureResult = await ChannelService.EnsureInstanceCreatedAsync(
            Model.InstanceName!,
            Model.ApiUrl ?? string.Empty);

        if (ensureResult.Success && ensureResult.AlreadyExists)
        {
            _loadingQrCode = false;
            _showInstanceExistsDialog = true;
            _instanceExistsDialogError = null;
            StateHasChanged();
            return;
        }

        if (!ensureResult.Success)
        {
            _loadingQrCode = false;
            _qrCodeError = ensureResult.Error ?? "Falha ao preparar a instância na Evolution.";
            _showQrCodeDialog = true;
            StateHasChanged();
            return;
        }

        await GenerateQrCodeFromCurrentInstanceAsync();
    }

    private async Task GenerateQrCodeFromCurrentInstanceAsync()
    {
        if (ChannelService == null || string.IsNullOrWhiteSpace(Model.InstanceName))
        {
            _loadingQrCode = false;
            StateHasChanged();
            return;
        }

        // Show the dialog immediately with a loading indicator, instead of leaving the
        // user without any feedback while the QR Code is being fetched/retried.
        _loadingQrCode = true;
        _qrCodeError = null;
        _qrCodeImageUrl = null;
        _qrCodeImageDataUrl = null;
        _showQrCodeDialog = true;
        StateHasChanged();

        // The QR Code may not be immediately available after a fresh instance create
        // (especially in the "Remover e Criar" flow, where Evolution needs a few extra
        // seconds to establish the Baileys connection before a QR Code can be issued).
        // Retry several times with a short delay before showing an error to the user
        // (8 attempts × 1.5s delay = up to ~12s total wait before giving up; the user
        // can also use "Recarregar QR Code" to retry manually afterwards).
        QrCodeResult qrResult = new() { Success = false };
        const int maxAttempts = 8;
        Logger.LogInformation("Iniciando geração de QR Code para a instância {InstanceName}. MaxAttempts={MaxAttempts}", Model.InstanceName, maxAttempts);
        for (var attempt = 1; attempt <= maxAttempts; attempt++)
        {
            Logger.LogDebug("Solicitando QR Code da Evolution. Instância={InstanceName} Tentativa={Attempt}/{MaxAttempts}", Model.InstanceName, attempt, maxAttempts);
            qrResult = await ChannelService.GenerateQrCodeAsync(
                Model.InstanceName!,
                Model.ApiUrl ?? string.Empty,
                string.Empty);

            if (qrResult.AlreadyConnected)
                break;

            if (qrResult.Success && (!string.IsNullOrWhiteSpace(qrResult.ImageUrl) || !string.IsNullOrWhiteSpace(qrResult.Base64)))
                break;

            Logger.LogDebug(
                "QR Code ainda indisponível. Instância={InstanceName} Tentativa={Attempt}/{MaxAttempts} Erro={Error}",
                Model.InstanceName,
                attempt,
                maxAttempts,
                qrResult.Error ?? "(sem erro informado)");

            if (attempt < maxAttempts)
                await Task.Delay(1500);
        }

        _loadingQrCode = false;
        if (qrResult.AlreadyConnected)
        {
            _showQrCodeDialog = false;
            _instanceConnected = true;
            _instanceStatusMessageIntent = MessageIntent.Success;
            _instanceStatusMessage = "Instância já está conectada. Você pode salvar o canal.";
            StateHasChanged();
            return;
        }

        if (!qrResult.Success || (string.IsNullOrWhiteSpace(qrResult.ImageUrl) && string.IsNullOrWhiteSpace(qrResult.Base64)))
        {
            Logger.LogWarning(
                "Falha ao gerar QR Code para a instância {InstanceName}. Erro={Error}",
                Model.InstanceName,
                qrResult.Error ?? "(sem erro informado)");
            _qrCodeError = qrResult.Error ?? "Não foi possível gerar o QR Code.";
            _showQrCodeDialog = true;
            StateHasChanged();
            return;
        }

        _qrCodeImageUrl = qrResult.ImageUrl;
        _qrCodeImageDataUrl = string.IsNullOrWhiteSpace(_qrCodeImageUrl)
            ? ToImageDataUrl(qrResult.Base64)
            : null;
        Logger.LogInformation(
            "QR Code pronto para {InstanceName}. ImageUrl={ImageUrl} Base64Length={Base64Length}",
            Model.InstanceName,
            _qrCodeImageUrl ?? "(none)",
            qrResult.Base64?.Length ?? 0);
        _showQrCodeDialog = true;
        _instanceStatusMessageIntent = MessageIntent.Info;
        _instanceStatusMessage = "QR Code gerado. Escaneie no WhatsApp para conectar a instância.";
        StateHasChanged();
    }

