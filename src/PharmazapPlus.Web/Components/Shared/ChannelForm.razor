    private string NormalizeMetaOAuthStartMessage(string? message)
    {
        if (string.IsNullOrWhiteSpace(message))
            return "Não foi possível iniciar a conexão com a Meta.";

        if (message.Contains("AppId", StringComparison.OrdinalIgnoreCase) ||
            message.Contains("AppSecret", StringComparison.OrdinalIgnoreCase))
        {
            if (UsesOwnMetaConfig)
            {
                return "Revise o Meta App ID e o Meta App Secret informados para o app da farmácia e tente novamente.";
            }

            return $"A conexão oficial do {MetaChannelLabel} ainda não está liberada neste ambiente. Você não precisa criar aplicativo na Meta nem configurar App ID. O Pharmazap usa um app central; basta um administrador concluir essa configuração uma única vez no servidor.";
        }

        return message;
    }

