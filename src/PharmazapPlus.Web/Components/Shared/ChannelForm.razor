                _helpDialogSteps = new List<string>
                {
                    "Use o número no formato DDI + DDD + telefone (ex.: 5562998808389).",
                    "Esse identificador precisa ser único para cada número de WhatsApp cadastrado.",
                    "Ao salvar, o sistema valida se a instância já existe e permite criar se ainda não existir."
                };
                _helpDialogTip = "Recomendação: use o próprio número do WhatsApp para facilitar suporte e evitar duplicidade.";
                break;
        }

        _showHelpDialog = true;
    }

    private void CloseHelpDialog()
    {
        _showHelpDialog = false;
    }

    private void OnInstanceNameChanged(string? value)
    {
        var newValue = SanitizeInstanceIdentifier(value);
        var changed = !string.Equals(newValue, Model.InstanceName, StringComparison.Ordinal);
        Model.InstanceName = newValue;
        if (changed)
        {
            // Changing the instance identifier invalidates any previously loaded QR Code
            // and any previously validated connection status. Everything must be re-generated
            // and re-validated for the new number.
            _lastAutoValidatedInstanceName = null;
            MarkInstanceOptionsStale();
        }
    }

    private void MarkInstanceOptionsStale()
    {
        _instanceOptionsMessage = null;
        _instanceStatusMessage = null;
        _instanceExistsDialogError = null;
        _showInstanceExistsDialog = false;
        _qrCodeImageUrl = null;
        _qrCodeImageDataUrl = null;
        _qrCodeError = null;
        _showQrCodeDialog = false;
        _instanceConnected = false;
        _pairingCode = null;
        _pairingCodeError = null;
    }

    private void ResetInstanceOptions()
    {
        _instanceOptionsMessage = null;
        _instanceStatusMessage = null;
        _instanceCreateError = null;
        _qrCodeError = null;
        _qrCodeImageUrl = null;
        _qrCodeImageDataUrl = null;
        _showQrCodeDialog = false;
        _showInstanceExistsDialog = false;
        _instanceExistsDialogError = null;
        _recreatingExistingInstance = false;
        _instanceConnected = false;
        _lastAutoValidatedInstanceName = null;
        _pairingCode = null;
        _pairingCodeError = null;
        _pairingCodePhone = "";
        _qrDialogUsePairingCode = false;
    }

    private void EnsureNonOfficialDefaults()
    {
        if (string.IsNullOrWhiteSpace(Model.ApiUrl))
            Model.ApiUrl = _nonOfficialEvolutionApiUrl;

        // Never persist/echo API key from this form in non-official flow.
        Model.ApiKey = null;
    }

    private static string SanitizeInstanceIdentifier(string? value)
    {
        var digits = new string((value ?? string.Empty).Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(digits))
            return string.Empty;

        return digits.Length > 50 ? digits[..50] : digits;
    }

    private static string GetInstanceDisplayValue(string? instanceName)
    {
        if (string.IsNullOrWhiteSpace(instanceName))
            return string.Empty;

        var trimmed = instanceName.Trim();
        var digits = new string(trimmed.Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digits) ? trimmed : digits;
    }

    private static bool IsEvolutionStatusConnected(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return false;

        var normalized = status.Trim().ToUpperInvariant();
        return normalized == Consts.EvolutionGoInstance.StatusOpen ||
               normalized == Consts.EvolutionGoInstance.StatusConnected;
    }

    private static string GetEvolutionStatusLabel(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return "não informado";

        var normalized = status.Trim().ToUpperInvariant();
        return normalized switch
        {
            Consts.EvolutionGoInstance.StatusOpen or Consts.EvolutionGoInstance.StatusConnected => "conectada",
            Consts.EvolutionGoInstance.StatusClose or Consts.EvolutionGoInstance.StatusDisconnected => "desconectada",
            Consts.EvolutionGoInstance.StatusQrCode => "aguardando QR Code",
            "NOT_FOUND" => "não encontrada",
            _ => normalized
        };
    }

    private static string ToImageDataUrl(string? base64)
    {
        var payload = NormalizeQrCodePayload(base64);
        if (string.IsNullOrWhiteSpace(payload))
            return string.Empty;

        if (TryExtractQrCodeValueFromJson(payload, out var extractedQrValue))
            payload = NormalizeQrCodePayload(extractedQrValue);

        if (string.IsNullOrWhiteSpace(payload))
            return string.Empty;

        // Already a valid data URL — just strip whitespace from the base64 body
        if (payload.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
        {
            var commaIndex = payload.IndexOf(',');
            if (commaIndex > 0 && commaIndex < payload.Length - 1 &&
                payload.Contains(";base64", StringComparison.OrdinalIgnoreCase))
            {
                var prefix = payload[..(commaIndex + 1)];
                var body = payload[(commaIndex + 1)..]
                    .Replace(" ", "+")
                    .Replace("\r", "")
                    .Replace("\n", "")
                    .Replace("\t", "");
                return prefix + body;
            }
            return payload;
        }

        if (payload.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            payload.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return payload;
        }

        if (LooksLikeSvgMarkup(payload))
            return BuildSvgDataUrl(payload);

        var normalizedBase64 = NormalizeBase64Payload(payload);
        return TryBuildQrImageDataUrl(normalizedBase64, out var dataUrl)
            ? dataUrl
            : $"data:image/png;base64,{normalizedBase64}";
    }

    private static string NormalizeQrCodePayload(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var normalized = value.Trim();
        if (normalized.Length >= 2 &&
            ((normalized.StartsWith('"') && normalized.EndsWith('"')) ||
             (normalized.StartsWith('\'') && normalized.EndsWith('\''))))
        {
            normalized = normalized[1..^1].Trim();
        }

        return normalized.Replace("\\/", "/", StringComparison.Ordinal);
    }

    private static string NormalizeBase64Payload(string value)
    {
        var withPlusRestored = value.Replace(' ', '+');
        var compact = new string(withPlusRestored.Where(ch => !char.IsWhiteSpace(ch)).ToArray())
            .Replace('-', '+')
            .Replace('_', '/');

        var modulo = compact.Length % 4;
        if (modulo != 0)
            compact = compact.PadRight(compact.Length + (4 - modulo), '=');

        return compact;
    }

    private static bool TryExtractQrCodeValueFromJson(string payload, out string? value)
    {
        value = null;
        if (!(payload.StartsWith('{') || payload.StartsWith('[')))
            return false;

        try
        {
            using var doc = JsonDocument.Parse(payload);
            return TryExtractQrCodeValueFromJsonElement(doc.RootElement, out value);
        }
        catch
        {
            return false;
        }
    }

    private static bool TryExtractQrCodeValueFromJsonElement(JsonElement element, out string? value)
    {
        value = null;

        if (element.ValueKind == JsonValueKind.String)
        {
            var text = element.GetString();
            if (LooksLikeQrImagePayload(text))
            {
                value = text;
                return true;
            }

            return false;
        }

        if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray())
            {
                if (TryExtractQrCodeValueFromJsonElement(item, out value))
                    return true;
            }

            return false;
        }

        if (element.ValueKind != JsonValueKind.Object)
            return false;

        foreach (var propertyName in new[] { "base64", "qrcode", "qrCode", "qr" })
        {
            if (!TryGetJsonPropertyIgnoreCase(element, propertyName, out var property))
                continue;

            if (TryExtractQrCodeValueFromJsonElement(property, out value))
                return true;
        }

        foreach (var containerName in new[] { "data", "instance", "message", "result" })
        {
            if (!TryGetJsonPropertyIgnoreCase(element, containerName, out var nested))
                continue;

            if (TryExtractQrCodeValueFromJsonElement(nested, out value))
                return true;
        }

        return false;
    }

    private static bool TryGetJsonPropertyIgnoreCase(JsonElement element, string propertyName, out JsonElement value)
    {
        foreach (var property in element.EnumerateObject())
        {
            if (!property.Name.Equals(propertyName, StringComparison.OrdinalIgnoreCase))
                continue;

            value = property.Value;
            return true;
        }

        value = default;
        return false;
    }

    private static bool LooksLikeQrImagePayload(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        var normalized = NormalizeQrCodePayload(value);
        if (string.IsNullOrWhiteSpace(normalized))
            return false;

        if (normalized.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
            return true;

        if (normalized.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            normalized.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (LooksLikeSvgMarkup(normalized))
            return true;

        return normalized.Length >= 32;
    }

    private static bool LooksLikeSvgMarkup(string value)
    {
        var trimmed = value.TrimStart('\uFEFF', '\u0000', ' ', '\t', '\r', '\n');
        return trimmed.StartsWith("<svg", StringComparison.OrdinalIgnoreCase) ||
               (trimmed.StartsWith("<?xml", StringComparison.OrdinalIgnoreCase) &&
                trimmed.Contains("<svg", StringComparison.OrdinalIgnoreCase));
    }

    private static string BuildSvgDataUrl(string svgMarkup)
    {
        return $"data:image/svg+xml;utf8,{Uri.EscapeDataString(svgMarkup)}";
    }

    private static bool TryBuildQrImageDataUrl(string base64, out string dataUrl)
    {
        dataUrl = string.Empty;

        if (!TryDecodeBase64Payload(base64, out var bytes))
            return false;

        var mimeType = DetectImageMimeType(bytes);
        if (string.IsNullOrWhiteSpace(mimeType))
            return false;

        dataUrl = $"data:{mimeType};base64,{base64}";
        return true;
    }

    private static bool TryDecodeBase64Payload(string base64, out byte[] bytes)
    {
        try
        {
            bytes = Convert.FromBase64String(base64);
            return true;
        }
        catch
        {
            bytes = Array.Empty<byte>();
            return false;
        }
    }

    private static string? DetectImageMimeType(byte[] bytes)
    {
        if (bytes.Length >= 8 &&
            bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47 &&
            bytes[4] == 0x0D && bytes[5] == 0x0A && bytes[6] == 0x1A && bytes[7] == 0x0A)
        {
            return "image/png";
        }

        if (bytes.Length >= 3 && bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF)
            return "image/jpeg";

        if (bytes.Length >= 6)
        {
            var header = System.Text.Encoding.ASCII.GetString(bytes, 0, 6);
            if (header is "GIF87a" or "GIF89a")
                return "image/gif";
        }

        if (bytes.Length >= 12)
        {
            var riff = System.Text.Encoding.ASCII.GetString(bytes, 0, 4);
            var webp = System.Text.Encoding.ASCII.GetString(bytes, 8, 4);
            if (riff == "RIFF" && webp == "WEBP")
                return "image/webp";
        }

        var text = System.Text.Encoding.UTF8.GetString(bytes).TrimStart('\uFEFF', '\u0000', ' ', '\t', '\r', '\n');
        if (LooksLikeSvgMarkup(text))
        {
            return "image/svg+xml";
        }

        return null;
    }
}
