@using System.Text.Json
@using PharmazapPlus.Shared.Enums
@implements IAsyncDisposable
@inject IToastService ToastService
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env
@inject ILogger<ChannelForm> Logger

<EditForm Model="@Model" OnValidSubmit="HandleSubmit" class="channel-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <FluentCard Style="padding:20px; width:100%; position: relative; z-index: 10; overflow: visible; background: var(--neutral-layer-1); color: var(--neutral-foreground-rest); border: 1px solid var(--neutral-stroke-divider-rest);">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="width: 100%; overflow: visible; position: relative; z-index: 10;">
            <FluentTextField @bind-Value="Model.Name" Label="Nome do Canal *" Placeholder="Ex: WhatsApp Suporte" Style="width: 100%;" />

            <div style="display: flex; gap: 12px; width: 100%; overflow: visible; position: relative;">
                <div style="flex: 1; overflow: visible; position: relative; z-index: 40;">
                    <FluentSelect TOption="string"
                                  Label="Tipo *"
                                  Value="@_selectedType"
                                  ValueChanged="OnTypeChanged"
                                  Style="width: 100%; position: relative; z-index: 40; overflow: visible;">
                        <FluentOption Value="1">WhatsApp</FluentOption>
                        <FluentOption Value="2">Instagram</FluentOption>
                    </FluentSelect>
                </div>
                @if (Model.Type == ChannelType.WhatsApp || Model.Type == ChannelType.Instagram)
                {
                    <div style="flex: 1; overflow: visible; position: relative; z-index: 35;">
                        <FluentSelect TOption="string"
                                      Label="Integração"
                                      Value="@_isOfficial"
                                      ValueChanged="OnOfficialChanged"
                                      Disabled="@IsIntegrationSelectorDisabled"
                                      Style="width: 100%; position: relative; z-index: 35; overflow: visible;">
                            <FluentOption Value="true">Oficial (Meta)</FluentOption>
                            @if (Model.Type == ChannelType.WhatsApp)
                            {
                                <FluentOption Value="false">Não oficial</FluentOption>
                            }
                        </FluentSelect>
                    </div>
                }
            </div>

            @if (ShowMetaWizard)
            {
                <FluentCard Style="padding: 1rem 1.1rem; width: 100%; position: relative; z-index: 8; overflow: visible; background: var(--neutral-layer-1); border: 1px solid var(--neutral-stroke-divider-rest);">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="width: 100%; overflow: visible; position: relative;">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" Style="flex-wrap: wrap;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Lightbulb)" Color="Color.Accent" />
                            <FluentLabel Typo="Typography.Subject">Assistente da Meta</FluentLabel>
                            <FluentBadge Appearance="Appearance.Accent">App central do Pharmazap</FluentBadge>
                            <FluentBadge Appearance="Appearance.Neutral">Passo @(_metaWizardStep + 1) de 3</FluentBadge>
                        </FluentStack>

                        <FluentLabel Style="color: var(--neutral-foreground-hint); line-height: 1.5;">
                            Conecte a conta da farmácia para o Pharmazap buscar automaticamente os dados oficiais da Meta para <strong>@MetaChannelLabel</strong>.
                        </FluentLabel>

                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            @for (var step = 0; step < MetaWizardSteps.Length; step++)
                            {
                                var currentStep = step;
                                <FluentBadge Appearance="@(currentStep == _metaWizardStep ? Appearance.Accent : Appearance.Neutral)">
                                    @(currentStep + 1). @MetaWizardSteps[currentStep]
                                </FluentBadge>
                            }
                        </div>

                        @if (_metaWizardStep == 0)
                        {
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                                <FluentMessageBar Intent="@MessageIntent.Info" Style="width: 100%;">
                                    @MetaWizardIntroMessage
                                </FluentMessageBar>

                                <div style="max-width: 340px; overflow: visible; position: relative; z-index: 30;">
                                    <FluentSelect TOption="string"
                                                  Label="Como deseja conectar? *"
                                                  Value="@_metaConfigSource"
                                                  ValueChanged="OnMetaConfigSourceChanged"
                                                  Style="width: 100%; position: relative; z-index: 30; overflow: visible;">
                                        <FluentOption Value="1">Utilizar minhas próprias configurações da Meta</FluentOption>
                                        <FluentOption Value="2">Usar app central do Pharmazap (Em Desenvolvimento)</FluentOption>
                                    </FluentSelect>
                                </div>

                                @if (UsesCentralMetaConfig)
                                {
                                    <FluentMessageBar Intent="@MessageIntent.Success" Style="width: 100%;">
                                        Você não precisa criar aplicativo na Meta, configurar App ID ou copiar webhook manualmente. O Pharmazap usa um app central e a farmácia só precisa autorizar a própria conta.
                                    </FluentMessageBar>

                                    <div style="max-width: 260px; overflow: visible; position: relative; z-index: 30;">
                                        <FluentSelect TOption="string"
                                                      Label="Ambiente Meta *"
                                                      Value="@_metaWizardMode"
                                                      ValueChanged="OnMetaWizardModeChanged"
                                                      Style="width: 100%; position: relative; z-index: 30; overflow: visible;">
                                            <FluentOption Value="1">Teste</FluentOption>
                                            <FluentOption Value="2">Produção</FluentOption>
                                        </FluentSelect>
                                        <FluentLabel Typo="Typography.Body"
                                                     Style="color: var(--neutral-foreground-hint); margin-top: 4px; font-size: 0.8rem;">
                                            O Pharmazap resolve internamente o App ID do ambiente escolhido e salva apenas esse modo no canal.
                                        </FluentLabel>
                                    </div>
                                }
                                else
                                {
                                    <FluentMessageBar Intent="@MessageIntent.Warning" Style="width: 100%;">
                                        Informe o App ID e o App Secret do app Meta da farmácia. O botão de conexão usará essas credenciais para abrir o OAuth do cliente.
                                    </FluentMessageBar>

                                    <div style="position: relative; z-index: 1; width: 100%;">
                                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6" Style="flex-wrap: wrap;">
                                            <FluentLabel>Meta App ID *</FluentLabel>
                                            <FluentButton Appearance="Appearance.Stealth"
                                                          @onclick="() => OpenHelpDialog(HelpTopic.MetaAppId)"
                                                          tabindex="0"
                                                          aria-label="Como obter Meta App ID"
                                                          Title="Como obter Meta App ID"
                                                          Style="padding: 0; min-width: 24px; height: 24px;">
                                                <FluentIcon Icon="@(Icons.Regular.Size16.QuestionCircle)" />
                                            </FluentButton>
                                            <a href="@MetaAppDashboardUrl" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem;">
                                                Crie um ?
                                            </a>
                                        </FluentStack>
                                        <FluentTextField @bind-Value="Model.MetaAppId" Placeholder="Ex: 123456789012345" Style="width: 100%;" />
                                    </div>

                                    <div style="position: relative; z-index: 1; width: 100%;">
                                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6" Style="flex-wrap: wrap;">
                                            <FluentLabel>Meta App Secret *</FluentLabel>
                                            <FluentButton Appearance="Appearance.Stealth"
                                                          @onclick="() => OpenHelpDialog(HelpTopic.MetaAppSecret)"
                                                          tabindex="0"
                                                          aria-label="Como obter Meta App Secret"
                                                          Title="Como obter Meta App Secret"
                                                          Style="padding: 0; min-width: 24px; height: 24px;">
                                                <FluentIcon Icon="@(Icons.Regular.Size16.QuestionCircle)" />
                                            </FluentButton>
                                            <a href="@MetaAppDashboardUrl" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem;">
                                                Crie um ?
                                            </a>
                                        </FluentStack>
                                        <FluentTextField @bind-Value="Model.MetaAppSecret"
                                                         Placeholder="Informe o segredo do app"
                                                         TextFieldType="TextFieldType.Password"
                                                         Style="width: 100%;" />
                                        <FluentLabel Typo="Typography.Body"
                                                     Style="color: var(--neutral-foreground-hint); margin-top: 4px; font-size: 0.8rem;">
                                            @(Model.HasPersistedMetaAppSecret
                                                ? "O segredo atual já está salvo no servidor. Deixe em branco para reutilizá-lo."
                                                : "Se você ainda não tiver um app, use o link 'Crie um ?' para abrir o Meta Dashboard.")
                                        </FluentLabel>
                                    </div>
                                }

                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="flex-wrap: wrap;">
                                    @* O popup precisa ser preparado no clique do navegador antes do round-trip do Blazor Server para evitar bloqueio pelo browser. *@
                                    <span class="meta-oauth-launch-wrapper" onclick="window.metaOAuthInterop?.preparePopup();">
                                        <FluentButton Appearance="Appearance.Accent"
                                                      Type="ButtonType.Button"
                                                      Class="meta-oauth-launch-button"
                                                      Disabled="@_metaOAuthInProgress"
                                                      @onclick="BeginMetaOAuthAsync">
                                            @if (_metaOAuthInProgress)
                                            {
                                                <FluentProgressRing Style="width: 14px; height: 14px; margin-right: 6px;" />
                                                <span>Conectando...</span>
                                            }
                                            else
                                            {
                                                <span class="meta-oauth-facebook-icon" aria-hidden="true">
                                                    <svg viewBox="0 0 16 16" class="meta-oauth-facebook-icon-svg" focusable="false">
                                                        <path d="M9.134 15V8.62h2.141l.321-2.486H9.134V4.547c0-.72.2-1.21 1.233-1.21H11.7V1.113C11.469 1.082 10.675 1 9.75 1 7.818 1 6.496 2.18 6.496 4.346v1.788H4.346V8.62h2.15V15h2.638Z" />
                                                    </svg>
                                                </span>
                                                <span>Conectar com Facebook</span>
                                            }
                                        </FluentButton>
                                    </span>
                                    <FluentButton Appearance="Appearance.Outline"
                                                  Type="ButtonType.Button"
                                                  @onclick="NextMetaWizardStep">
                                        Prefiro preencher os dados manualmente
                                    </FluentButton>
                                </FluentStack>

                                @if (!string.IsNullOrWhiteSpace(_metaOAuthMessage))
                                {
                                    <FluentMessageBar Intent="@_metaOAuthMessageIntent" Style="width: 100%;">
                                        @_metaOAuthMessage
                                    </FluentMessageBar>
                                }

                                <ul style="margin: 0; padding-left: 1.2rem; line-height: 1.6;">
                                    @foreach (var item in GetMetaWizardIntroSteps())
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </FluentStack>
                        }
                        else
                        {
                            <FluentMessageBar Intent="@MetaStepMessageIntent" Style="width: 100%;">
                                @MetaStepMessage
                            </FluentMessageBar>

                            <ul style="margin: 0; padding-left: 1.2rem; line-height: 1.6;">
                                @foreach (var item in GetMetaWizardReviewSteps())
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    </FluentStack>
                </FluentCard>
            }

            @if (Model.Type == ChannelType.WhatsApp)
            {
                @if (Model.IsOfficial)
                {
                    @if (!ShowMetaWizard || _metaWizardStep == 1)
                    {
                    // WhatsApp Oficial (Meta)
                    <div style="position: relative; z-index: 1; width: 100%;">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4">
                            <FluentLabel>Número conectado (Phone Number ID) *</FluentLabel>
                            <FluentButton Appearance="Appearance.Stealth"
                                          @onclick="() => OpenHelpDialog(HelpTopic.PhoneNumberId)"
                                          tabindex="0"
                                          aria-label="Como obter Phone Number ID"
                                          Title="Como obter Phone Number ID"
                                          Style="padding: 0; min-width: 24px; height: 24px;">
                                <FluentIcon Icon="@(Icons.Regular.Size16.QuestionCircle)" />
                            </FluentButton>
                        </FluentStack>
                        <FluentTextField @bind-Value="Model.PhoneNumberId" Placeholder="Ex: 123456789" Style="width: 100%;" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-top: 4px; font-size: 0.8rem;">
                            Esse identificador costuma ser preenchido automaticamente após conectar com Facebook.
                        </FluentLabel>
                    </div>

                    <div style="position: relative; z-index: 1; width: 100%;">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4">
                            <FluentLabel>Conta do WhatsApp Business (WABA ID)</FluentLabel>
                            <FluentButton Appearance="Appearance.Stealth"
                                          @onclick="() => OpenHelpDialog(HelpTopic.BusinessAccountId)"
                                          tabindex="0"
                                          aria-label="Como obter Business Account ID"
                                          Title="Como obter Business Account ID"
                                          Style="padding: 0; min-width: 24px; height: 24px;">
                                <FluentIcon Icon="@(Icons.Regular.Size16.QuestionCircle)" />
                            </FluentButton>
                        </FluentStack>
                        <FluentTextField @bind-Value="Model.BusinessAccountId" Placeholder="Ex: 987654321" Style="width: 100%;" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-top: 4px; font-size: 0.8rem;">
                            Se a conexão oficial localizar a conta correta, este campo será preenchido automaticamente.
                        </FluentLabel>
                    </div>
                    }
                }
                else
                {
                    // WhatsApp Não Oficial (Evolution API, Baileys, etc)
                    <div style="position: relative; z-index: 30; width: 100%; overflow: visible;">
                        <FluentSelect TOption="string"
                                      Label="Farmácia"
                                      Value="@SelectedFarmaciaValue"
                                      Disabled="true"
                                      Style="width: 100%; position: relative; z-index: 30; overflow: visible;">
                            <FluentOption Value="@SelectedFarmaciaValue">@SelectedFarmaciaLabel</FluentOption>
                        </FluentSelect>
                    </div>

                    <div style="position: relative; z-index: 1; width: 100%;">
                        <FluentMessageBar Intent="@MessageIntent.Info" Style="width: 100%;">
                            Por segurança, a URL da Evolution e a API Key são gerenciadas no servidor e não ficam visíveis neste formulário.
                        </FluentMessageBar>
                    </div>

                    <div style="position: relative; z-index: 1; width: 100%;">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4">
                            <FluentLabel>Identificador da Instância *</FluentLabel>
                            <FluentButton Appearance="Appearance.Stealth"
                                          @onclick="() => OpenHelpDialog(HelpTopic.InstanceName)"
                                          tabindex="0"
                                          aria-label="O que é o nome da instância"
                                           Title="O que é o nome da instância"
                                           Style="padding: 0; min-width: 24px; height: 24px;">
                                <FluentIcon Icon="@(Icons.Regular.Size16.QuestionCircle)" />
                            </FluentButton>
                        </FluentStack>

                        <FluentTextField Value="@GetInstanceDisplayValue(Model.InstanceName)"
                                         ValueChanged="OnInstanceNameChanged"
                                         Immediate="true"
                                         Placeholder="Ex: 5562998808389"
                                         Style="width: 100%;" />
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-top: 4px; font-size: 0.8rem;">
                            Use o telefone (DDI + DDD + número), por exemplo <strong>5562998808389</strong>.
                        </FluentLabel>

                        @if (!string.IsNullOrWhiteSpace(_instanceOptionsMessage))
                        {
                            <FluentMessageBar Intent="@_instanceOptionsMessageIntent" Style="margin-top: 8px;">
                                @_instanceOptionsMessage
                            </FluentMessageBar>
                        }
                    </div>

                    <div style="position: relative; z-index: 1; width: 100%;">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="flex-wrap: wrap;">
                            <FluentButton Appearance="Appearance.Accent"
                                          Type="ButtonType.Button"
                                          @onclick="GenerateQrCodeAsync"
                                          Disabled="@(!CanGenerateQrCode || _loadingQrCode)">
                                @if (_loadingQrCode)
                                {
                                    <FluentProgressRing Style="width: 14px; height: 14px; margin-right: 6px;" />
                                }
                                Gerar QR Code
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline"
                                          Type="ButtonType.Button"
                                          @onclick="ValidateInstanceStatusAsync"
                                          Disabled="@(!CanReloadInstanceOptions || _validatingInstanceStatus)">
                                @if (_validatingInstanceStatus)
                                {
                                    <FluentProgressRing Style="width: 14px; height: 14px; margin-right: 6px;" />
                                }
                                Validar status
                            </FluentButton>
                        </FluentStack>

                        @if (!string.IsNullOrWhiteSpace(_instanceStatusMessage))
                        {
                            <FluentMessageBar Intent="@_instanceStatusMessageIntent" Style="margin-top: 8px;">
                                @_instanceStatusMessage
                            </FluentMessageBar>
                        }
                    </div>

                    <div style="position: relative; z-index: 1; width: 100%;">
                        <FluentMessageBar Intent="@MessageIntent.Info" Style="margin-top: 8px;">
                            Use APIs como Evolution API, Baileys ou similar. Acesse /tests para testar a conexão.
                        </FluentMessageBar>
                    </div>

                }
            }

            @if (Model.Type == ChannelType.Instagram)
            {
                @if (!ShowMetaWizard || _metaWizardStep == 1)
                {
                <FluentMessageBar Intent="@MetaCredentialsMessageIntent" Style="width: 100%;">
                    @MetaCredentialsMessage
                </FluentMessageBar>

                <div style="position: relative; z-index: 1; width: 100%;">
                    <FluentStack Orientation="Orientation.Horizontal"
                                 VerticalAlignment="VerticalAlignment.Center"
                                 HorizontalGap="4"
                                 Style="justify-content: flex-end; margin-bottom: 4px;">
                        <FluentButton Appearance="Appearance.Stealth"
                                      @onclick="() => OpenHelpDialog(HelpTopic.InstagramBusinessId)"
                                      tabindex="0"
                                      aria-label="Como informar Instagram Business ID"
                                      Title="Como informar Instagram Business ID"
                                      Style="padding: 0; min-width: 24px; height: 24px;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.QuestionCircle)" />
                        </FluentButton>
                    </FluentStack>
                    <FluentTextField @bind-Value="Model.InstagramBusinessId" Label="Instagram Business ID *" Placeholder="Ex: 17841400000000000" Style="width: 100%;" />
                    <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-top: 4px; font-size: 0.8rem;">
                        Normalmente preenchido automaticamente depois de clicar em <strong>Conectar com Facebook</strong>.
                    </FluentLabel>
                </div>

                <div style="position: relative; z-index: 1; width: 100%;">
                    <FluentTextField @bind-Value="Model.AccessToken" Label="Access Token da Meta *" Placeholder="Informe o token da Meta" TextFieldType="TextFieldType.Password" Style="width: 100%;" />
                    <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-top: 4px; font-size: 0.8rem;">
                        O token costuma ser importado automaticamente pela conexão oficial.
                    </FluentLabel>
                </div>
                }
            }

            @if (Model.Type == ChannelType.WhatsApp && Model.IsOfficial)
            {
                @if (!ShowMetaWizard || _metaWizardStep == 1)
                {
                <FluentMessageBar Intent="@MetaCredentialsMessageIntent" Style="width: 100%;">
                    @MetaCredentialsMessage
                </FluentMessageBar>

                <div style="position: relative; z-index: 1; width: 100%;">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4">
                        <FluentLabel>Access Token da Meta @(IsAccessTokenRequired ? "*" : "")</FluentLabel>
                        <FluentButton Appearance="Appearance.Stealth"
                                      @onclick="() => OpenHelpDialog(HelpTopic.AccessToken)"
                                      tabindex="0"
                                      aria-label="Como obter Access Token"
                                      Title="Como obter Access Token"
                                      Style="padding: 0; min-width: 24px; height: 24px;">
                            <FluentIcon Icon="@(Icons.Regular.Size16.QuestionCircle)" />
                        </FluentButton>
                    </FluentStack>
                    <FluentTextField @bind-Value="Model.AccessToken"
                                     Placeholder="Informe o token"
                                     TextFieldType="TextFieldType.Password"
                                     Style="width: 100%;" />
                    <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); margin-top: 4px; font-size: 0.8rem;">
                        O token costuma ser preenchido automaticamente após a autorização no Facebook.
                    </FluentLabel>
                </div>
                }
            }

            @if (ShowMetaWizard)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="justify-content: flex-end; width: 100%;">
                    @if (_metaWizardStep > 0)
                    {
                        <FluentButton Appearance="Appearance.Neutral" Type="ButtonType.Button" @onclick="PreviousMetaWizardStep">
                            Voltar
                        </FluentButton>
                    }

                    @if (_metaWizardStep < MetaWizardSteps.Length - 1)
                    {
                        <FluentButton Appearance="Appearance.Outline" Type="ButtonType.Button" @onclick="NextMetaWizardStep">
                            Continuar
                        </FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Disabled="@(IsSubmitting || _instanceValidating)">
                            @if (IsSubmitting || _instanceValidating)
                            {
                                <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 6px;" />
                                <span>@(IsSubmitting ? "Salvando..." : "Verificando instância...")</span>
                            }
                            else
                            {
                                <span>Salvar</span>
                            }
                        </FluentButton>
                    }
                </FluentStack>
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4" HorizontalAlignment="HorizontalAlignment.End">
                    <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit"
                                  Disabled="@(IsSubmitting || _instanceValidating || !CanSubmitNonOfficialWhatsApp)">
                        @if (IsSubmitting || _instanceValidating)
                        {
                            <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 6px;" />
                            <span>@(IsSubmitting ? "Salvando..." : "Verificando instância...")</span>
                        }
                        else
                        {
                            <span>Salvar</span>
                        }
                    </FluentButton>
                    @if (RequiresInstanceConnection && !_instanceConnected && !IsSubmitting && !_instanceValidating)
                    {
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); font-size: 0.8rem;">
                            Gere o QR Code, escaneie no WhatsApp e clique em <strong>Validar status</strong> para habilitar o botão Salvar.
                        </FluentLabel>
                    }
                </FluentStack>
            }
        </FluentStack>
    </FluentCard>
</EditForm>

<FluentDialog Modal="true" Hidden="@(!_showQrCodeDialog)" TrapFocus="true"
              @ondialogdismiss="CloseQrCodeDialog"
              Style="max-width: 520px; width: 95%; background: var(--neutral-layer-1); color: var(--neutral-foreground-rest);">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.Link)" />
                <FluentLabel Typo="Typography.Subject">Conectar Instância WhatsApp</FluentLabel>
            </FluentStack>
            <div style="margin-left: auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseQrCodeDialog" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding: 0.5rem 0;">
            @* Mode selector *@
            <div style="display: flex; gap: 0; border: 1px solid var(--neutral-stroke-rest); border-radius: 6px; overflow: hidden; width: 100%;">
                <button type="button"
                        style="flex: 1; padding: 8px 12px; border: none; cursor: pointer; font-size: 0.85rem; font-weight: 500;
                               background: @(_qrDialogUsePairingCode ? "var(--neutral-layer-2)" : "var(--accent-fill-rest)");
                               color: @(_qrDialogUsePairingCode ? "var(--neutral-foreground-rest)" : "var(--foreground-on-accent-rest)");"
                        @onclick="@(() => SwitchQrDialogMode(false))">
                    📷 QR Code
                </button>
                <button type="button"
                        style="flex: 1; padding: 8px 12px; border: none; cursor: pointer; font-size: 0.85rem; font-weight: 500;
                               background: @(_qrDialogUsePairingCode ? "var(--accent-fill-rest)" : "var(--neutral-layer-2)");
                               color: @(_qrDialogUsePairingCode ? "var(--foreground-on-accent-rest)" : "var(--neutral-foreground-rest)");"
                        @onclick="@(() => SwitchQrDialogMode(true))">
                    🔢 Código de Pareamento
                </button>
            </div>

            @if (!_qrDialogUsePairingCode)
            {
                @* QR Code mode *@
                @if (_loadingQrCode)
                {
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="8" Style="width: 100%; padding: 1rem 0;">
                        <FluentProgressRing Style="width: 32px; height: 32px;" />
                        <FluentLabel Style="color: var(--neutral-foreground-hint);">Gerando QR Code, aguarde...</FluentLabel>
                    </FluentStack>
                }
                else if (!string.IsNullOrWhiteSpace(_qrCodeError))
                {
                    <FluentMessageBar Intent="@MessageIntent.Error" Style="width: 100%;">
                        @_qrCodeError
                    </FluentMessageBar>
                }
                else if (!string.IsNullOrWhiteSpace(_qrCodeImageUrl) || !string.IsNullOrWhiteSpace(_qrCodeImageDataUrl))
                {
                    <FluentMessageBar Intent="@MessageIntent.Info" Style="width: 100%;">
                        Escaneie este QR Code no WhatsApp para conectar a instância.
                    </FluentMessageBar>
                    <div style="display: flex; justify-content: center; width: 100%;">
                        <img id="qr-code-img"
                             alt="QR Code WhatsApp"
                             src="@(_qrCodeImageUrl ?? _qrCodeImageDataUrl ?? string.Empty)"
                             style="width: min(300px, 100%); height: auto; border-radius: 8px; border: 1px solid var(--neutral-stroke-divider-rest);" />
                    </div>
                }
                else
                {
                    <FluentMessageBar Intent="@MessageIntent.Warning" Style="width: 100%;">
                        Não foi possível gerar o QR Code. Tente recarregar ou use o Código de Pareamento.
                    </FluentMessageBar>
                }
            }
            else
            {
                @* Pairing code mode *@
                <FluentMessageBar Intent="@MessageIntent.Info" Style="width: 100%;">
                    Insira seu número e clique em "Gerar código". Depois abra o WhatsApp →
                    Configurações → Aparelhos conectados → Conectar com número.
                </FluentMessageBar>

                <FluentTextField Value="@_pairingCodePhone"
                                 ValueChanged="OnPairingCodePhoneChanged"
                                 Immediate="true"
                                 Label="Número de telefone *"
                                 Placeholder="+55 (62) 99988-0839"
                                 Style="width: 100%;"
                                 Disabled="@_loadingPairingCode" />

                @if (!string.IsNullOrWhiteSpace(_pairingCodeError))
                {
                    <FluentMessageBar Intent="@MessageIntent.Error" Style="width: 100%;">
                        @_pairingCodeError
                    </FluentMessageBar>
                }

                @if (!string.IsNullOrWhiteSpace(_pairingCode))
                {
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="8"
                                 Style="width: 100%; padding: 1rem; background: var(--neutral-layer-2); border-radius: 8px; text-align: center;">
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); font-size: 0.85rem;">
                            Código de pareamento:
                        </FluentLabel>
                        <FluentLabel Typo="Typography.H3"
                                     Style="font-size: 2rem; font-weight: 700; letter-spacing: 0.25rem; color: var(--accent-fill-rest); font-family: monospace;">
                            @_pairingCode
                        </FluentLabel>
                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); font-size: 0.8rem;">
                            Digite este código no WhatsApp. O código expira em alguns minutos.
                        </FluentLabel>
                    </FluentStack>
                }

                <FluentButton Appearance="Appearance.Accent"
                              @onclick="GeneratePairingCodeAsync"
                              Disabled="@(_loadingPairingCode || string.IsNullOrWhiteSpace(_pairingCodePhone))"
                              Style="width: 100%;">
                    @if (_loadingPairingCode)
                    {
                        <FluentProgressRing Style="width: 14px; height: 14px; margin-right: 6px;" />
                        <span>Gerando...</span>
                    }
                    else
                    {
                        <span>Gerar código</span>
                    }
                </FluentButton>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        @if (!_qrDialogUsePairingCode)
        {
            <FluentButton Appearance="Appearance.Outline" @onclick="ReloadQrCodeAsync" Disabled="@_loadingQrCode">
                @if (_loadingQrCode)
                {
                    <FluentProgressRing Style="width: 14px; height: 14px; margin-right: 6px;" />
                }
                Recarregar QR Code
            </FluentButton>
        }
        <FluentButton Appearance="Appearance.Accent" @onclick="CloseQrCodeDialog">
            Fechar
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog Modal="true" Hidden="@(!_showInstanceExistsDialog)" TrapFocus="true"
              @ondialogdismiss="CancelRecreateExistingInstance"
              Style="max-width: 520px; width: 95%; background: var(--neutral-layer-1); color: var(--neutral-foreground-rest);">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size16.Warning)" />
                <FluentLabel Typo="Typography.Subject">Instância já existente</FluentLabel>
            </FluentStack>
            <div style="margin-left: auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CancelRecreateExistingInstance" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding: 0.5rem 0;">
            <FluentMessageBar Intent="@MessageIntent.Info" Style="width: 100%;">
                A instância <strong>@GetInstanceDisplayValue(Model.InstanceName)</strong> já existe na Evolution Go.
            </FluentMessageBar>
            <FluentLabel>
                Deseja usar a instância existente para gerar o QR Code agora ou remover e recriar a instância?
            </FluentLabel>
            <FluentLabel Style="font-size: 0.85em; color: var(--neutral-foreground-hint);">
                Remover e recriar pode desconectar sessões ativas e exigir novo pareamento completo.
            </FluentLabel>
