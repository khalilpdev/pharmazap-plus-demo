    private async Task GeneratePairingCodeAsync()
    {
        if (ChannelService == null || string.IsNullOrWhiteSpace(_pairingCodePhone))
            return;

        var phoneDigits = _pairingCodePhone.SanitizeDigits(13);
        if (!IsValidBrazilianPairingPhone(phoneDigits))
        {
            _pairingCodeError = "Informe o telefone completo com DDI 55, DDD e número (ex.: +55 (62) 99988-0839).";
            StateHasChanged();
            return;
        }

        EnsureNonOfficialDefaults();
        Logger.LogInformation(
            "Iniciando geração de código de pareamento para a instância {InstanceName}. PhoneLength={PhoneLength}",
            Model.InstanceName,
            phoneDigits.Length);
        _loadingPairingCode = true;
        _pairingCode = null;
        _pairingCodeError = null;
        StateHasChanged();

        var result = await ChannelService.GeneratePairingCodeAsync(
            Model.InstanceName!,
            Model.ApiUrl ?? string.Empty,
            string.Empty,
            phoneDigits);

        _loadingPairingCode = false;
        if (result.Success)
        {
            Logger.LogInformation(
                "Código de pareamento gerado para {InstanceName}. Code={Code}",
                Model.InstanceName,
                result.Code);
            _pairingCode = result.Code;
        }
        else
        {
            Logger.LogWarning(
                "Falha ao gerar código de pareamento para {InstanceName}. Erro={Error}",
                Model.InstanceName,
                result.Error ?? "(sem erro informado)");
            _pairingCodeError = result.Error ?? "Não foi possível gerar o código de pareamento.";
        }

        StateHasChanged();
    }

    private void OnPairingCodePhoneChanged(string? value)
    {
        _pairingCodePhone = FormatBrazilianPairingPhone(value);
        _pairingCodeError = null;
    }

    private static bool IsValidBrazilianPairingPhone(string digits) =>
        digits.StartsWith("55", StringComparison.Ordinal) &&
        digits.Length is 12 or 13;

    private static string FormatBrazilianPairingPhone(string? value)
    {
        var digits = new string((value ?? string.Empty).Where(char.IsDigit).Take(13).ToArray());
        if (digits.Length == 0)
            return string.Empty;

        if (digits.Length <= 2)
            return $"+{digits}";

        var countryCode = digits[..2];
        var areaCode = digits.Length <= 4 ? digits[2..] : digits.Substring(2, 2);
        var localNumber = digits.Length <= 4 ? string.Empty : digits[4..];
        if (localNumber.Length <= 5)
            return $"+{countryCode} ({areaCode}) {localNumber}".TrimEnd();

        return $"+{countryCode} ({areaCode}) {localNumber[..5]}-{localNumber[5..]}";
    }

