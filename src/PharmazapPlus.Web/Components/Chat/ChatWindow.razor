    /// <summary>
    /// Interpreta o valor digitado como moeda brasileira.
    /// Delega para StringExtension.ParseBrCurrency centralizado no Shared.
    /// Se não contiver ponto nem vírgula, trata como valor inteiro em reais (ex: "15" → 15,00).
    /// Se contiver separador, usa ponto como milhar e vírgula como decimal (ex: "1.500,50" → 1500,50).
    /// </summary>
    private static decimal ParseValorMonetario(string? input) =>
        input.ParseBrCurrency() ?? 0m;

    private static bool IsImageMedia(Mensagem mensagem) =>
        NormalizeMediaKind(mensagem) is Consts.Midia.Image or Consts.Midia.Sticker;

    private static bool IsMediaMessage(Mensagem mensagem) =>
        mensagem.HasMedia ||
        !string.IsNullOrWhiteSpace(mensagem.MediaType) ||
        mensagem.Type is PharmazapPlus.Shared.Models.Mensagens.MessageType.Image
            or PharmazapPlus.Shared.Models.Mensagens.MessageType.Sticker
            or PharmazapPlus.Shared.Models.Mensagens.MessageType.Video
            or PharmazapPlus.Shared.Models.Mensagens.MessageType.Audio
            or PharmazapPlus.Shared.Models.Mensagens.MessageType.Document;

    private static bool IsVideoMedia(Mensagem mensagem) =>
        NormalizeMediaKind(mensagem) == Consts.Midia.Video;

    private static bool IsAudioMedia(Mensagem mensagem) =>
        NormalizeMediaKind(mensagem) == Consts.Midia.Audio;

    private static string NormalizeMediaKind(Mensagem mensagem)
    {
        var mediaType = (mensagem.MediaType ?? string.Empty).Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(mediaType))
        {
            if (mediaType.Contains(Consts.Midia.Image) || mediaType.Contains(Consts.Midia.Sticker)) return Consts.Midia.Image;
            if (mediaType.Contains(Consts.Midia.Video)) return Consts.Midia.Video;
            if (mediaType.Contains(Consts.Midia.Audio)) return Consts.Midia.Audio;
            if (mediaType.Contains(Consts.Midia.Document)) return Consts.Midia.Document;
        }

        return mensagem.Type switch
        {
            PharmazapPlus.Shared.Models.Mensagens.MessageType.Image => Consts.Midia.Image,
            PharmazapPlus.Shared.Models.Mensagens.MessageType.Sticker => Consts.Midia.Sticker,
            PharmazapPlus.Shared.Models.Mensagens.MessageType.Video => Consts.Midia.Video,
            PharmazapPlus.Shared.Models.Mensagens.MessageType.Audio => Consts.Midia.Audio,
            PharmazapPlus.Shared.Models.Mensagens.MessageType.Document => Consts.Midia.Document,
            _ => Consts.Midia.Document
        };
    }

    private static string GetMediaMimeType(Mensagem mensagem, string fallback)
    {
        var mediaType = mensagem.MediaType?.Trim();
        return !string.IsNullOrWhiteSpace(mediaType) && mediaType.Contains("/")
            ? mediaType
            : fallback;
    }

    private static string GetMediaFileName(Mensagem mensagem)
    {
        var caption = mensagem.MediaCaption?.Trim();
        if (!string.IsNullOrWhiteSpace(caption))
            return caption;

        var text = mensagem.Text?.Trim();
        if (!string.IsNullOrWhiteSpace(text) && text != "[Documento]")
            return text;

        var mediaUrl = mensagem.MediaUrl?.Trim();
        if (!string.IsNullOrWhiteSpace(mediaUrl) &&
            Uri.TryCreate(mediaUrl, UriKind.Absolute, out var uri))
        {
            var fileName = Path.GetFileName(uri.LocalPath);
            if (!string.IsNullOrWhiteSpace(fileName))
                return Uri.UnescapeDataString(fileName);
        }

        return "documento";
    }

    private static string BuildMediaFileName(Mensagem mensagem, string? contentType)
    {
        var fileName = GetMediaFileName(mensagem);
        if (Path.HasExtension(fileName))
            return fileName;

        // Try to resolve extension from the HTTP response content type first.
        var extension = GetExtensionFromContentType(contentType);
        if (!string.IsNullOrWhiteSpace(extension))
            return $"{fileName}.{extension}";

        // Fallback: use the MediaType field stored on the message (MIME hint from the webhook).
        // This handles the common case where the file was stored as .bin (application/octet-stream)
        // but the original MIME type is known from the webhook payload (e.g. application/pdf).
        extension = GetExtensionFromContentType(mensagem.MediaType);
        if (!string.IsNullOrWhiteSpace(extension))
            return $"{fileName}.{extension}";

        // Last resort: images default to .jpg, everything else to .bin.
        return $"{fileName}.{(IsImageMedia(mensagem) ? "jpg" : "bin")}";
    }

    private static string? GetExtensionFromContentType(string? contentType)
    {
        var normalized = contentType?.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(normalized))
            return null;

        // Strip parameters such as "; codecs=opus".
        var semicolon = normalized.IndexOf(';');
        if (semicolon > 0)
            normalized = normalized[..semicolon].Trim();

        return normalized switch
        {
            "image/jpeg" or "image/jpg" => "jpg",
            "image/png" => "png",
            "image/webp" => "webp",
            "image/gif" => "gif",
            "image/bmp" => "bmp",
            "application/pdf" => "pdf",
            "application/msword" => "doc",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "docx",
            "application/vnd.ms-excel" => "xls",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "xlsx",
            "text/plain" => "txt",
            "audio/ogg" => "ogg",
            "audio/mpeg" or "audio/mp3" => "mp3",
            "audio/mp4" or "audio/m4a" or "audio/x-m4a" or "audio/aac" => "m4a",
            "audio/wav" or "audio/x-wav" => "wav",
            "video/mp4" => "mp4",
            "video/webm" => "webm",
            _ => null
        };
    }

    private static bool IsAllowedImageContentType(string? contentType)
    {
        var normalized = contentType?.Trim().ToLowerInvariant();
        var semicolon = normalized?.IndexOf(';') ?? -1;
        if (semicolon >= 0)
            normalized = normalized![..semicolon].Trim();

        return normalized is "image/jpeg"
            or "image/jpg"
            or "image/png"
            or "image/webp"
            or "image/gif"
            or "image/bmp";
    }

    private static string? GetSafeMediaUrl(string? mediaUrl)
    {
        if (string.IsNullOrWhiteSpace(mediaUrl))
            return null;

        var trimmedUrl = mediaUrl.Trim();
        if (trimmedUrl.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase) ||
            trimmedUrl.StartsWith("/media/", StringComparison.OrdinalIgnoreCase))
            return trimmedUrl;

        return Uri.TryCreate(trimmedUrl, UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? trimmedUrl
            : null;
    }

    /// <summary>
    /// Returns the URL to use as the &lt;img&gt;/&lt;audio&gt;/&lt;video&gt; src in the browser.
    /// For locally stored files (/uploads/media/...), routes through the Web app's
    /// /media-proxy endpoint so the browser fetches from the same origin as the Web
    /// app (avoids CORS and dev-cert issues when API and Web run on different origins).
    /// For external HTTP(S) URLs, returns the URL directly.
    /// </summary>
    private static string? GetMediaDisplayUrl(Mensagem mensagem)
    {
        var safe = GetSafeMediaUrl(mensagem.MediaUrl);
        if (safe is null) return null;

        var contentTypeQuery = BuildMediaProxyContentTypeQuery(mensagem.MediaType);

        if (safe.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase))
            return "/media-proxy" + safe + contentTypeQuery;

        if (safe.StartsWith("/media/", StringComparison.OrdinalIgnoreCase))
            return "/media-proxy/uploads" + safe + contentTypeQuery;

        if (IsProxyableExternalMediaUrl(safe))
            return $"/media-proxy/fetch?url={Uri.EscapeDataString(safe)}{BuildMediaProxyContentTypeQuery(mensagem.MediaType, hasQuery: true)}";

        return safe;
    }

    private static string BuildMediaProxyContentTypeQuery(string? contentType, bool hasQuery = false)
    {
        var normalized = contentType.NormalizeAllowedMediaContentType();
        return string.IsNullOrWhiteSpace(normalized)
            ? string.Empty
            : $"{(hasQuery ? "&" : "?")}contentType={Uri.EscapeDataString(normalized)}";
    }

    private static bool IsProxyableExternalMediaUrl(string mediaUrl)
    {
        return PharmazapPlus.Web.Services.PharmazapApiService.IsWhatsAppCdnUrl(mediaUrl, out _) ||
               PharmazapPlus.Web.Services.PharmazapApiService.IsBlobMediaUrl(mediaUrl, out _);
    }

    private static MarkupString FormatMessageContent(string? content)
    {
        if (string.IsNullOrEmpty(content))
            return new MarkupString(string.Empty);

        var builder = new System.Text.StringBuilder();
        var matches = System.Text.RegularExpressions.Regex.Matches(
            content,
            @"https?://[^\s<]+",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        var lastIndex = 0;
        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            if (match.Index > lastIndex)
            {
                AppendEncodedMessageFragment(builder, content[lastIndex..match.Index]);
            }

            var (cleanUrl, trailingPunctuation) = SplitUrlSuffix(match.Value);
            if (Uri.TryCreate(cleanUrl, UriKind.Absolute, out var uri) &&
                (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
            {
                builder.Append("<a href=\"")
                    .Append(System.Net.WebUtility.HtmlEncode(cleanUrl))
                    .Append("\" target=\"_blank\" rel=\"noopener noreferrer\">")
                    .Append(System.Net.WebUtility.HtmlEncode(cleanUrl))
                    .Append("</a>");
            }
            else
            {
                AppendEncodedMessageFragment(builder, match.Value);
                trailingPunctuation = string.Empty;
            }

            if (!string.IsNullOrEmpty(trailingPunctuation))
            {
                AppendEncodedMessageFragment(builder, trailingPunctuation);
            }

            lastIndex = match.Index + match.Length;
        }

        if (lastIndex < content.Length)
        {
            AppendEncodedMessageFragment(builder, content[lastIndex..]);
        }

        return new MarkupString(builder.ToString());
    }

    private static void AppendEncodedMessageFragment(System.Text.StringBuilder builder, string value)
    {
        if (string.IsNullOrEmpty(value))
            return;

        builder.Append(System.Net.WebUtility.HtmlEncode(value)
            .Replace("\r\n", "<br />", StringComparison.Ordinal)
            .Replace("\n", "<br />", StringComparison.Ordinal)
            .Replace("\r", "<br />", StringComparison.Ordinal));
    }

    private static (string CleanUrl, string TrailingPunctuation) SplitUrlSuffix(string url)
    {
        var end = url.Length;
        while (end > 0 && ".,;:!?)]}".IndexOf(url[end - 1]) >= 0)
        {
            end--;
        }

        return end == url.Length
            ? (url, string.Empty)
            : (url[..end], url[end..]);
    }
}

