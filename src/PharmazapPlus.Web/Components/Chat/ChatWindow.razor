    private void EditarCliente()
    {
        if (CurrentAtendimento?.Cliente == null)
        {
            ToastService.ShowWarning("Cliente não disponível para edição.");
            return;
        }

        _editingCliente = CurrentAtendimento.Cliente;
        _showClienteFormDialog = true;
    }

    private async Task OnClienteFormVisibleChanged(bool visible)
    {
        _showClienteFormDialog = visible;
        if (!visible)
            _editingCliente = null;

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleClienteFormSave((bool IsNew, CreateClienteDto? Create, UpdateClienteDto? Update) args)
    {
        if (args.IsNew)
        {
            Logger.LogWarning("Fluxo de criação de cliente não é suportado em ChatWindow.");
            ToastService.ShowWarning("Este fluxo permite apenas editar clientes existentes.");
            return;
        }

        if (args.Update == null || _editingCliente == null)
        {
            _showClienteFormDialog = false;
            _editingCliente = null;
            return;
        }

        var (success, message) = await PharmazapApiService.UpdateClienteAsync(_editingCliente.Id, args.Update);
        if (!success)
        {
            ToastService.ShowError($"Erro ao atualizar cliente: {message}");
            return;
        }

        ToastService.ShowSuccess("Cliente atualizado com sucesso!");
        _showClienteFormDialog = false;
        _editingCliente = null;
        if (OnClienteUpdated.HasDelegate)
            await OnClienteUpdated.InvokeAsync();
    }

    private async Task VerHistorico()
    {
        if (CurrentAtendimento?.ClienteId is not int clienteId || clienteId <= 0)
        {
            ToastService.ShowWarning("Cliente não identificado para abrir histórico.");
            return;
        }

        var nomeCliente = CurrentAtendimento.Cliente?.Nome;
        var targetUrl = $"/clientes/{clienteId}/historico";
        if (!string.IsNullOrWhiteSpace(nomeCliente))
            targetUrl += $"?nome={Uri.EscapeDataString(nomeCliente)}";

        await JSRuntime.InvokeVoidAsync("open", targetUrl, "_blank");
    }

