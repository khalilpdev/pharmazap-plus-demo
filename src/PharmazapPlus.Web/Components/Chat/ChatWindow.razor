<!-- Mensagens pré-definidas dialog -->
<FluentDialog @ref="_mensagensPreDefDialog"
              Hidden="@(!_showMensagensPreDef)"
              @ondialogdismiss="CloseMensagensPreDefinidas"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              Style="width: 480px;">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size20.Flash)" Style="color: #f0a500;" />
                <FluentLabel Typo="Typography.Subject">Mensagens Pré-Definidas</FluentLabel>
            </FluentStack>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseMensagensPreDefinidas" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        @if (_isLoadingMensagensPreDef)
        {
            <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 2rem;">
                <FluentProgressRing />
            </FluentStack>
        }
        else if (!_mensagensPreDef.Any())
        {
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                         VerticalGap="8" Style="padding: 2rem;">
                <FluentIcon Icon="@(Icons.Regular.Size24.ChatMultiple)" Style="color: var(--neutral-foreground-hint);" />
                <FluentLabel Style="color: var(--neutral-foreground-hint); text-align: center;">
                    Nenhuma mensagem pré-definida cadastrada.<br />
                    Acesse <strong>Configurações &gt; Mensagens Pré-Definidas</strong> para criar.
                </FluentLabel>
            </FluentStack>
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="padding: 0.5rem 0;">
                @foreach (var msg in _mensagensPreDef.OrderBy(m => m.Ordem).ThenBy(m => m.Titulo))
                {
                    <div style="padding: 12px; border: 1px solid var(--neutral-stroke-rest); border-radius: 6px; cursor: pointer; transition: background 0.15s;"
                         @onclick="@(() => SelectMensagemPreDefinida(msg))"
                         @onmouseover="@(e => {})"
                         title="Clique para usar esta mensagem">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                            <FluentLabel Weight="FontWeight.Bold" Style="font-size: 0.875rem;">@msg.Titulo</FluentLabel>
                            <FluentLabel Style="color: var(--neutral-foreground-hint); font-size: 0.8rem; white-space: pre-wrap; word-break: break-word;">@msg.Texto</FluentLabel>
                        </FluentStack>
                    </div>
                }
            </FluentStack>
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" @onclick="CloseMensagensPreDefinidas">
            Fechar
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- Encerramento reason dialog -->
<FluentDialog @ref="_encerramentoDialog"
              Hidden="@(!_showEncerramentoDialog)"
              @ondialogdismiss="CancelEncerramento"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              Style="width: 440px;">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentIcon Icon="@(Icons.Regular.Size20.CallEnd)" Color="Color.Error" />
                <FluentLabel Typo="Typography.Subject">Encerrar atendimento</FluentLabel>
            </FluentStack>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CancelEncerramento" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="overflow: visible; position: relative; z-index: 30;">
            @if (_isLoadingMotivos)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                    <FluentProgressRing Style="width: 16px; height: 16px;" />
                    <FluentLabel>Carregando motivos...</FluentLabel>
                </FluentStack>
            }
            else
            {
                <FluentLabel>Selecione o motivo do encerramento:</FluentLabel>
                <div style="position: relative; z-index: 30; overflow: visible;">
                    <FluentSelect TOption="string"
                                  Value="@_motivoEncerramentoIdStr"
                                  ValueChanged="@OnMotivoChanged"
                                  Style="width: 100%; position: relative; z-index: 30; overflow: visible;">
                        <FluentOption TOption="string" Value="">Selecione um motivo...</FluentOption>
                        @foreach (var motivo in _motivosDisponiveis)
                        {
                            <FluentOption TOption="string" Value="@motivo.Id.ToString()">@motivo.Nome</FluentOption>
                        }
                    </FluentSelect>
                </div>

                @if (_selectedMotivo?.ExigeValorVenda == true)
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentLabel>Valor da venda *:</FluentLabel>
                        <FluentTextField Value="@_valorVendaStr"
                                         ValueChanged="@OnValorVendaInput"
                                         Immediate="true"
                                         Placeholder="R$ 0,00"
                                         Style="width: 100%;"
                                         MaxLength="15" />
                        <FluentLabel Style="color: var(--neutral-foreground-hint); font-size: 0.75rem;">
                            Obrigatório: informe o valor da venda realizada neste atendimento.
                        </FluentLabel>
                    </FluentStack>
                }
                else
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentLabel>Valor da venda (opcional):</FluentLabel>
                        <FluentTextField Value="@_valorVendaStr"
                                         ValueChanged="@OnValorVendaInput"
                                         Immediate="true"
                                         Placeholder="R$ 0,00"
                                         Style="width: 100%;"
                                         MaxLength="15" />
                        <FluentLabel Style="color: var(--neutral-foreground-hint); font-size: 0.75rem;">
                            Informe o valor da venda realizada neste atendimento, se houver.
                        </FluentLabel>
                    </FluentStack>
                }

                @if (_selectedMotivo?.ExigeComprovante == true)
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentLabel>Comprovante (imagem) *:</FluentLabel>
                        <InputFile OnChange="HandleComprovanteUpload" accept="image/*" style="width: 100%;" />
                        @if (_comprovanteFile != null)
                        {
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                                <FluentIcon Icon="@(Icons.Regular.Size16.Image)" />
                                <FluentLabel>@_comprovanteFile.Name (@((_comprovanteFile.Size / 1024).ToString("N0")) KB)</FluentLabel>
                                <FluentButton Appearance="Appearance.Stealth" @onclick="ClearComprovante" Title="Remover">
                                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                                </FluentButton>
                            </FluentStack>
                        }
                        <FluentLabel Style="color: var(--neutral-foreground-hint); font-size: 0.75rem;">
                            Obrigatório: anexe uma imagem de comprovante (pedido, cupom fiscal, etc.). Máx: 10MB.
                        </FluentLabel>
                    </FluentStack>
                }
            }
            @if (!string.IsNullOrEmpty(_encerramentoError))
            {
                <FluentMessageBar Intent="@MessageIntent.Error">@_encerramentoError</FluentMessageBar>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" @onclick="CancelEncerramento" Disabled="@_isFinalizando">
            Cancelar
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      @onclick="ConfirmEncerramento"
                      Disabled="@(string.IsNullOrEmpty(_motivoEncerramentoIdStr) || _isFinalizando)">
            @if (_isFinalizando)
            {
                <FluentProgressRing Style="width: 16px; height: 16px;" />
                <span style="margin-left: 0.5rem;">Encerrando...</span>
            }
            else
            {
                <FluentIcon Icon="@(Icons.Regular.Size16.CallEnd)" Slot="start" Color="Color.Fill" />
                <span>Encerrar</span>
            }
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- Preview de imagem -->
<FluentDialog Hidden="@(!_showImagePreviewDialog)"
              @ondialogdismiss="CloseImagePreview"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              Style="width: min(92vw, 760px);">
    <FluentDialogHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="width:100%">
            <FluentLabel Typo="Typography.Subject">Preview da imagem</FluentLabel>
            <div style="margin-left:auto;">
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseImagePreview" aria-label="Fechar" Title="Fechar">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                </FluentButton>
            </div>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        @if (_isLoadingImagePreview)
        {
            <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 2rem;">
                <FluentProgressRing />
            </FluentStack>
        }
        else if (!string.IsNullOrWhiteSpace(_imagePreviewDataUrl))
        {
            <div class="chat-image-preview-container">
                <img src="@_imagePreviewDataUrl" alt="Preview da imagem" class="chat-image-preview" />
            </div>
        }
        else
        {
            <FluentLabel>@_imagePreviewError</FluentLabel>
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" @onclick="CloseImagePreview">
            Fechar
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      Disabled="@(_imagePreviewBytes is null || _isDownloadingImagePreview)"
                      @onclick="DownloadImagePreviewAsync">
            @if (_isDownloadingImagePreview)
            {
                <FluentProgressRing Style="width: 16px; height: 16px;" />
            }
            else
            {
                <FluentIcon Icon="@(Icons.Regular.Size16.ArrowDownload)" Slot="start" Color="Color.Fill" />
                <span>Baixar imagem</span>
            }
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    [Parameter] public Atendimento? CurrentAtendimento { get; set; }
    [Parameter] public EventCallback<Atendimento> OnAtendimentoFinalizado { get; set; }
    [Parameter] public EventCallback<Atendimento> OnEtiquetar { get; set; }
    [Parameter] public EventCallback<Atendimento> OnAssumirRequested { get; set; }
    [Parameter] public EventCallback<Atendimento> OnTransferirRequested { get; set; }
    [Parameter] public EventCallback<Atendimento> OnVoltarPendenteRequested { get; set; }
    [Parameter] public EventCallback OnClienteUpdated { get; set; }

    /// <summary>ID do usuário logado (string, como vem do UserInfo.Id).</summary>
    [Parameter] public string? CurrentUserId { get; set; }

    /// <summary>Role do usuário logado (UserRoles.Gestor / Administrador / Atendente).</summary>
    [Parameter] public string? CurrentUserRole { get; set; }

    private ElementReference messagesContainer;
    private FluentTextField? messageInput;
    private int _messageInputRenderKey = 0;

    private List<Mensagem> Mensagens = new();
    private string MessageText = "";
    private bool IsLoadingMessages = false;
    private bool IsSending = false;
    private bool IsTyping = false;
    private bool ShowClienteInfo = false;
    private bool _showClienteFormDialog;
    private Cliente? _editingCliente;
    private int? _lastAtendimentoId;
    private string? _lastAtendimentoStatus;
    private Atendimento? _lastAtendimentoRef;

    // Encerramento dialog state
    private FluentDialog? _encerramentoDialog;
    private bool _showEncerramentoDialog;
    private string _motivoEncerramentoIdStr = "";
    private MotivoEncerramentoDto? _selectedMotivo;
    private List<MotivoEncerramentoDto> _motivosDisponiveis = new();
    private bool _isLoadingMotivos;
    private string _valorVendaStr = "";
    private IBrowserFile? _comprovanteFile;
    private bool _isFinalizando;
    private string _encerramentoError = "";

    // Mensagens pré-definidas dialog state
    private FluentDialog? _mensagensPreDefDialog;
    private bool _showMensagensPreDef;
    private List<MensagemPreDefinidaDto> _mensagensPreDef = new();
    private bool _isLoadingMensagensPreDef;

    // Preview de imagem
    private bool _showImagePreviewDialog;
    private bool _isLoadingImagePreview;
    private bool _isDownloadingImagePreview;
    private byte[]? _imagePreviewBytes;
    private string? _imagePreviewContentType;
    private string? _imagePreviewDataUrl;
    private string _imagePreviewFileName = "imagem.jpg";
    private string _imagePreviewError = "Não foi possível carregar a imagem.";

    // Download de documento (server-side, para resolver Content-Type/extensão correta
    // e evitar download cross-origin do blob criptografado do CDN como `file.enc`).
    private bool _isDownloadingDocument;

    private AtendimentoStatusEnum StatusEnum =>
        Enum.TryParse<AtendimentoStatusEnum>(CurrentAtendimento?.Status, out var s) ? s : AtendimentoStatusEnum.Pendente;

    private bool IsGrupo => CurrentAtendimento?.IsGrupo == true;

    private bool IsGestor =>
        string.Equals(CurrentUserRole, UserRoles.Gestor, StringComparison.OrdinalIgnoreCase);

    private bool IsAdministrador =>
        string.Equals(CurrentUserRole, UserRoles.Administrador, StringComparison.OrdinalIgnoreCase);

    private bool IsAtendente =>
        string.Equals(CurrentUserRole, UserRoles.Atendente, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Verdadeiro quando o usuário logado é o atendente atribuído ao atendimento atual.
    /// Gestor NUNCA é considerado atendente atribuído.
    /// Administrador e Atendente só podem enviar se o AtendenteId do atendimento for o seu.
    /// </summary>
    private bool IsAssignedAttendant =>
        !IsGestor &&
        !IsGrupo &&
        int.TryParse(CurrentUserId, out var uid) &&
        CurrentAtendimento?.AtendenteId == uid;

    private bool CanSendMessage => !string.IsNullOrWhiteSpace(MessageText) &&
                                    CurrentAtendimento != null &&
                                    !IsGrupo &&
                                    StatusEnum == AtendimentoStatusEnum.EmAndamento &&
                                    IsAssignedAttendant &&
                                    !IsSending;

    private bool CanShowInlineActions =>
        CurrentAtendimento != null &&
        !IsGrupo &&
        StatusEnum == AtendimentoStatusEnum.EmAndamento &&
        IsAssignedAttendant;

    private bool CanShowInlineTransfer => CanShowInlineActions && IsAdministrador;

    private bool CanShowInlineVoltarPendente => CanShowInlineActions && IsAtendente;

    private bool CanShowInlineEncerrar => CanShowInlineActions && IsAdministrador;

    private bool CanShowEncerrarInMenu => CanShowInlineActions && IsAtendente;

    private string HeaderDisplayName =>
        IsGrupo
            ? (string.IsNullOrWhiteSpace(CurrentAtendimento?.GrupoNome) ? "Grupo WhatsApp" : CurrentAtendimento.GrupoNome)
            : CurrentAtendimento?.Cliente?.Nome
                ?? CurrentAtendimento?.WhatsAppId.FormatContactId(CurrentAtendimento?.CanalEnum ?? CanalEnum.WhatsApp)
                ?? "Desconhecido";

    protected override async Task OnInitializedAsync()
    {
        if (CurrentAtendimento != null)
        {
            UpdateLastAtendimentoState();
            await LoadMessages();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var idChanged = CurrentAtendimento?.Id != _lastAtendimentoId;
        var statusChanged = CurrentAtendimento?.Status != _lastAtendimentoStatus;
        var referenceChanged = !ReferenceEquals(CurrentAtendimento, _lastAtendimentoRef);

        if (idChanged || statusChanged || referenceChanged)
        {
            UpdateLastAtendimentoState();

            if (CurrentAtendimento != null)
            {
                await LoadMessages();
            }
            else
            {
                Mensagens.Clear();
            }
        }
    }

    private void UpdateLastAtendimentoState()
    {
        _lastAtendimentoId = CurrentAtendimento?.Id;
        _lastAtendimentoStatus = CurrentAtendimento?.Status;
        _lastAtendimentoRef = CurrentAtendimento;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (CurrentAtendimento != null && Mensagens.Any())
        {
            await ScrollToBottom();
        }
    }

    private async Task LoadMessages()
    {
        IsLoadingMessages = true;
        StateHasChanged();

        try
        {
            if (CurrentAtendimento != null)
            {
                var messages = await PharmazapApiService.GetMensagensAtendimentoAsync(CurrentAtendimento.Id);
                Mensagens = messages.OrderBy(m => m.ReceivedAt).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Erro ao carregar mensagens do atendimento {CurrentAtendimento?.Id} [{ex.Message}]");
            ToastService.ShowError("Não foi possível carregar as mensagens. Tente novamente em instantes.");
        }
        finally
        {
            IsLoadingMessages = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (!CanSendMessage) return;

        IsSending = true;
        var text = MessageText.Trim();
        MessageText = "";
        _messageInputRenderKey++;
        StateHasChanged();
        await Task.Yield();

        try
        {
            if (CurrentAtendimento != null)
            {
                var (success, message) = await PharmazapApiService.EnviarMensagemAsync(CurrentAtendimento.Id, text);
                if (success)
                {
                    await LoadMessages();
                    ToastService.ShowSuccess("Mensagem enviada com sucesso!");
                }
                else
                {
                    Logger.LogWarning("Failed to send message in atendimento {Id}", CurrentAtendimento.Id);
                    MessageText = text; // Restore text on failure
                    ToastService.ShowError(message);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending message");
            MessageText = text; // Restore text on exception
        }
        finally
        {
            IsSending = false;
            StateHasChanged();
            if (messageInput != null)
            {
                messageInput.FocusAsync();
            }
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !IsSending)
        {
            await SendMessage();
        }
    }

    private async Task InitiateFinalizarAtendimento()
    {
        _motivoEncerramentoIdStr = "";
        _selectedMotivo = null;
        _valorVendaStr = "";
        _comprovanteFile = null;
        _encerramentoError = "";
        _showEncerramentoDialog = true;
        _isLoadingMotivos = true;
        StateHasChanged();

        try
        {
            _motivosDisponiveis = await PharmazapApiService.GetMotivosEncerramentoAsync(ativo: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading motivos encerramento");
            _motivosDisponiveis = new();
        }
        finally
        {
            _isLoadingMotivos = false;
            StateHasChanged();
        }
    }

    private void OnMotivoChanged(string value)
    {
        _motivoEncerramentoIdStr = value;
        _selectedMotivo = int.TryParse(value, out var id)
            ? _motivosDisponiveis.FirstOrDefault(m => m.Id == id)
            : null;

        // Clear comprovante if motivo doesn't require it
        if (_selectedMotivo?.ExigeComprovante != true)
            _comprovanteFile = null;
    }

    private void HandleComprovanteUpload(InputFileChangeEventArgs e)
    {
        _comprovanteFile = e.File;
        _encerramentoError = "";
    }

    private void ClearComprovante()
    {
        _comprovanteFile = null;
    }

    private void CancelEncerramento()
    {
        _showEncerramentoDialog = false;
        _motivoEncerramentoIdStr = "";
        _selectedMotivo = null;
        _valorVendaStr = "";
        _comprovanteFile = null;
        _encerramentoError = "";
    }

    private async Task ConfirmEncerramento()
    {
        if (string.IsNullOrEmpty(_motivoEncerramentoIdStr)) return;
        if (CurrentAtendimento == null) return;
        if (_selectedMotivo == null) return;

        // Client-side validation based on motivo rules
        var valorVenda = ParseValorMonetario(_valorVendaStr);

        if (_selectedMotivo.ExigeValorVenda && valorVenda <= 0)
        {
            _encerramentoError = "O motivo selecionado exige que o valor da venda seja informado.";
            return;
        }

        if (_selectedMotivo.ExigeComprovante && _comprovanteFile == null)
        {
            _encerramentoError = "O motivo selecionado exige que um comprovante (imagem) seja anexado.";
            return;
        }

        _isFinalizando = true;
        _encerramentoError = "";

        try
        {
            // Upload comprovante if provided
            string? comprovanteUrl = null;
            if (_comprovanteFile != null)
            {
                using var stream = _comprovanteFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var (uploadSuccess, url, uploadMessage) = await PharmazapApiService.UploadComprovanteAsync(
                    CurrentAtendimento.Id, stream, _comprovanteFile.Name, _comprovanteFile.ContentType);

                if (!uploadSuccess)
                {
                    _encerramentoError = $"Erro ao enviar comprovante: {uploadMessage}";
                    return;
                }
                comprovanteUrl = url;
            }

            var (success, message) = await PharmazapApiService.FinalizarAtendimentoAsync(
                CurrentAtendimento.Id,
                motivo: _selectedMotivo.Nome,
                valorVenda: valorVenda > 0 ? valorVenda : null,
                motivoEncerramentoId: _selectedMotivo.Id,
                comprovanteUrl: comprovanteUrl);

            if (success)
            {
                _showEncerramentoDialog = false;
                ToastService.ShowSuccess("Atendimento encerrado com sucesso.");
                CurrentAtendimento.Finalizar();
                UpdateLastAtendimentoState();
                var atendimento = CurrentAtendimento;
                CurrentAtendimento = default;
                await OnAtendimentoFinalizado.InvokeAsync(atendimento);
            }
            else
            {
                Logger.LogWarning("Falha ao finalizar atendimento {Id}: {Message}", CurrentAtendimento.Id, message);
                _encerramentoError = message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Erro ao finalizar atendimento {CurrentAtendimento?.Id} [{ex.Message}]");
            _encerramentoError = "Erro ao encerrar atendimento. Tente novamente.";
            ToastService.ShowError("Erro ao encerrar atendimento. Tente novamente.");
        }
        finally
        {
            _isFinalizando = false;
        }
    }

    private void ToggleClienteInfo() => ShowClienteInfo = !ShowClienteInfo;

    private async Task OpenMensagensPreDefinidas()
    {
        _showMensagensPreDef = true;
        _isLoadingMensagensPreDef = true;
        StateHasChanged();
        try
        {
            _mensagensPreDef = await PharmazapApiService.GetMensagensPreDefinidasAsync(ativo: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading mensagens pré-definidas");
            ToastService.ShowError("Erro ao carregar mensagens pré-definidas.");
        }
        finally
        {
            _isLoadingMensagensPreDef = false;
            StateHasChanged();
        }
    }

    private async Task SelectMensagemPreDefinida(MensagemPreDefinidaDto mensagem)
    {
        MessageText = mensagem.Texto;
        _showMensagensPreDef = false;
        StateHasChanged();
        await SendMessage();
    }

    private void CloseMensagensPreDefinidas()
    {
        _showMensagensPreDef = false;
        StateHasChanged();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.CompletedTask;
        }
        catch { }
    }

    private async Task UploadImage() { await Task.CompletedTask; }
    private void InsertEmoji(string emoji)
    {
        MessageText = (MessageText ?? "") + emoji;
    }

    private async Task TransferirAtendimento()
    {
        if (CurrentAtendimento != null)
        {
            await OnTransferirRequested.InvokeAsync(CurrentAtendimento);
        }
    }

    private async Task EtiquetarAtendimento()
    {
        if (CurrentAtendimento != null)
            await OnEtiquetar.InvokeAsync(CurrentAtendimento);
    }

    private async Task OpenMediaImageAsync(Mensagem mensagem)
    {
        var mediaUrl = GetSafeMediaUrl(mensagem.MediaUrl);
        if (string.IsNullOrWhiteSpace(mediaUrl))
        {
            ToastService.ShowError("A imagem não possui uma URL válida.");
            return;
        }

        _showImagePreviewDialog = true;
        _isLoadingImagePreview = true;
        _imagePreviewError = "Não foi possível carregar a imagem.";
        _imagePreviewBytes = null;
        _imagePreviewDataUrl = null;
        StateHasChanged();

        try
        {
            var (success, content, contentType, message) = await PharmazapApiService.DownloadMediaAsync(mediaUrl, mensagem.MediaType);
            if (!success || content is null || content.Length == 0)
            {
                _imagePreviewError = string.IsNullOrWhiteSpace(message)
                    ? "Não foi possível baixar a imagem."
                    : message;
                return;
            }

            var resolvedContentType = !string.IsNullOrWhiteSpace(contentType) ? contentType : "image/jpeg";
            if (!IsAllowedImageContentType(resolvedContentType))
            {
                _imagePreviewError = "Tipo de conteúdo da imagem não permitido.";
                return;
            }

            _imagePreviewBytes = content;
            _imagePreviewContentType = resolvedContentType;
            _imagePreviewDataUrl = $"data:{_imagePreviewContentType};base64,{Convert.ToBase64String(content)}";
            _imagePreviewFileName = BuildMediaFileName(mensagem, _imagePreviewContentType);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar preview da imagem");
            _imagePreviewError = "Erro ao carregar a imagem.";
        }
        finally
        {
            _isLoadingImagePreview = false;
            StateHasChanged();
        }
    }

    private async Task DownloadImagePreviewAsync()
    {
        if (_imagePreviewBytes is null || _imagePreviewBytes.Length == 0)
            return;

        _isDownloadingImagePreview = true;
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "relatoriosInterop.downloadFileFromBytes",
                _imagePreviewFileName,
                _imagePreviewContentType ?? "image/jpeg",
                _imagePreviewBytes);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao baixar imagem");
            ToastService.ShowError("Não foi possível baixar a imagem.");
        }
        finally
        {
            _isDownloadingImagePreview = false;
        }
    }

    private void CloseImagePreview()
    {
        _showImagePreviewDialog = false;
        _isLoadingImagePreview = false;
        _isDownloadingImagePreview = false;
        _imagePreviewBytes = null;
        _imagePreviewContentType = null;
        _imagePreviewDataUrl = null;
    }

    /// <summary>
    /// Baixa um documento via servidor (API) com Content-Type real, resolve nome/extensão
    /// corretos e dispara o download no navegador via JS interop. Substitui o link direto
    /// &lt;a href=&quot;...&quot; download&gt; que (1) é ignorado pelo browser em URLs cross-origin
    /// e (2) baixa o blob criptografado (file.enc) quando o MediaUrl ainda aponta para o
    /// CDN do WhatsApp.
    /// </summary>
    private async Task DownloadDocumentAsync(Mensagem mensagem)
    {
        if (_isDownloadingDocument) return;

        var mediaUrl = GetSafeMediaUrl(mensagem.MediaUrl);
        if (string.IsNullOrWhiteSpace(mediaUrl))
        {
            ToastService.ShowError("O documento não possui uma URL válida.");
            return;
        }

        _isDownloadingDocument = true;
        try
        {
            var (success, content, contentType, message) = await PharmazapApiService.DownloadMediaAsync(mediaUrl, mensagem.MediaType);
            if (!success || content is null || content.Length == 0)
            {
                ToastService.ShowError(string.IsNullOrWhiteSpace(message)
                    ? "Não foi possível baixar o documento."
                    : message);
                return;
            }

            // When the stored file has no recognised MIME (application/octet-stream or .bin),
            // use the MediaType field stored on the message (MIME hint from the original webhook)
            // so the file gets the correct extension (e.g. .pdf instead of .bin).
            var resolvedContentType = !string.IsNullOrWhiteSpace(contentType)
                ? contentType
                : (mensagem.MediaType ?? "application/octet-stream");

            var fileName = BuildMediaFileName(mensagem, resolvedContentType);

            await JSRuntime.InvokeVoidAsync(
                "relatoriosInterop.downloadFileFromBytes",
                fileName,
                resolvedContentType,
                content);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao baixar documento");
            ToastService.ShowError("Não foi possível baixar o documento.");
        }
        finally
        {
            _isDownloadingDocument = false;
        }
    }

