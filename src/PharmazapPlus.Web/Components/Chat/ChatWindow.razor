@using PharmazapPlus.Shared.Extensions
@using PharmazapPlus.Web.Components.Pages
@implements IAsyncDisposable
@inject IWhatsAppClient WhatsAppClient
@inject IPharmazapApiService PharmazapApiService
@inject ILogger<ChatWindow> Logger
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<FluentCard Style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden;">

    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                 Style="padding: 6px 10px; border-bottom: 1px solid var(--neutral-stroke-rest); flex-shrink: 0;">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                      Style="flex: 1;">
            @if (CurrentAtendimento != null)
            {
                <span class="chat-header__channel-icon" title="@CurrentAtendimento.Canal">
                    <ChannelIcon Canal="@CurrentAtendimento.CanalEnum" Size="20" />
                </span>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="margin-left: 8px; min-width: 0; overflow: hidden; flex: 1;">
                    <div class="chat-header__summary-row">
                        <FluentLabel Typo="Typography.Subject"
                                     Class="chat-header__name"
                                     Title="@HeaderDisplayName">
                            @HeaderDisplayName
                        </FluentLabel>
                        @if (CanShowInlineActions)
                        {
                            <div class="chat-header__actions-row">
                                <div class="chat-header__actions">
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Title="Etiquetar atendimento"
                                                  Class="chat-header__action-btn"
                                                  @onclick="EtiquetarAtendimento">
                                        <FluentIcon Icon="@(Icons.Regular.Size16.Tag)" Slot="start" />
                                        Etiquetar
                                        @if (CurrentAtendimento?.EtiquetaId.HasValue == true)
                                        {
                                            <FluentBadge Appearance="Appearance.Accent" Style="margin-left: 4px;">✓</FluentBadge>
                                        }
                                    </FluentButton>

                                    @if (CanShowInlineTransfer)
                                    {
                                        <FluentButton Appearance="Appearance.Stealth"
                                                      Title="Transferir atendimento"
                                                      Class="chat-header__action-btn"
                                                      @onclick="TransferirAtendimento">
                                            <FluentIcon Icon="@(Icons.Regular.Size16.PeopleCommunity)" Slot="start" />
                                            Transferir
                                        </FluentButton>
                                    }

                                    @if (CanShowInlineVoltarPendente)
                                    {
                                        <FluentButton Appearance="Appearance.Stealth"
                                                      Title="Voltar atendimento para pendente"
                                                      Class="chat-header__action-btn"
                                                      @onclick="@(() => OnVoltarPendenteRequested.InvokeAsync(CurrentAtendimento))">
                                            <FluentIcon Icon="@(Icons.Regular.Size16.ArrowUndo)" Slot="start" />
                                            Voltar
                                        </FluentButton>
                                    }

                                    @if (CanShowInlineEncerrar)
                                    {
                                        <FluentButton Appearance="Appearance.Accent"
                                                      Title="Encerrar atendimento"
                                                      Class="chat-header__action-btn chat-header__action-btn--danger"
                                                      @onclick="InitiateFinalizarAtendimento">
                                            <FluentIcon Icon="@(Icons.Regular.Size16.CallEnd)" Slot="start" Color="Color.Fill" />
                                            Encerrar
                                        </FluentButton>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </FluentStack>
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                             Style="padding: 16px; width: 100%;" VerticalGap="4">
                    <FluentIcon Icon="@(Icons.Regular.Size24.Chat)" Color="Color.Lightweight" />
                    <FluentLabel Color="Color.Lightweight">Selecione um atendimento para começar</FluentLabel>
                </FluentStack>
            }
        </FluentStack>

        @if (CurrentAtendimento != null)
        {
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4" VerticalAlignment="VerticalAlignment.Center">
                @if (!IsGrupo)
                {
                    <FluentButton Appearance="Appearance.Stealth" Title="Informacoes do cliente"
                                 @onclick="ToggleClienteInfo">
                        <FluentIcon Icon="@(Icons.Regular.Size16.Info)" />
                    </FluentButton>
                }

                @if (!IsGrupo)
                {
                <FluentMenu>
                    <FluentButton Appearance="Appearance.Stealth" Title="Mais opcoes">
                        <FluentIcon Icon="@(Icons.Regular.Size16.MoreVertical)" />
                    </FluentButton>
                    @if (StatusEnum == AtendimentoStatusEnum.EmAndamento)
                    {
                        <FluentMenuItem @onclick="TransferirAtendimento">
                            <FluentIcon Icon="@(Icons.Regular.Size16.PeopleCommunity)" Slot="start" />
                            Transferir atendimento
                        </FluentMenuItem>
                        @if (CanShowEncerrarInMenu)
                        {
                            <FluentMenuItem @onclick="InitiateFinalizarAtendimento">
                                <FluentIcon Icon="@(Icons.Regular.Size16.CallEnd)" Slot="start" />
                                Encerrar atendimento
                            </FluentMenuItem>
                        }
                    }
                    <FluentMenuItem @onclick="EtiquetarAtendimento">
                        <FluentIcon Icon="@(Icons.Regular.Size16.Tag)" Slot="start" />
                        Etiquetar atendimento
                    </FluentMenuItem>
                    <FluentMenuItem @onclick="CriarAgendamento">
                        <FluentIcon Icon="@(Icons.Regular.Size16.CalendarAdd)" Slot="start" />
                        Criar agendamento
                    </FluentMenuItem>
                    <FluentMenuItem @onclick="ExportarConversa">
                        <FluentIcon Icon="@(Icons.Regular.Size16.ArrowDownload)" Slot="start" />
                        Exportar conversa
                    </FluentMenuItem>
                </FluentMenu>
                }
            </FluentStack>
        }
    </FluentStack>

    @if (CurrentAtendimento != null)
    {
        <div class="chat-messages" @ref="messagesContainer">
            @if (IsLoadingMessages)
            {
                <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 24px;">
                    <FluentProgressRing />
                </FluentStack>
            }
            else if (Mensagens.Any())
            {
                @foreach (var messageGroup in Mensagens.GroupBy(m => ToBrazilTime(m.ReceivedAt).Date))
                {
                    <div class="message-date-divider">
                        <span>@messageGroup.Key.ToString("dd/MM/yyyy")</span>
                    </div>

                    @foreach (var mensagem in messageGroup.OrderBy(m => m.ReceivedAt))
                    {
                        @* Skip blank messages (e.g. reactions saved before the webhook fix) *@
                        @if (IsMediaMessage(mensagem) || !string.IsNullOrEmpty(mensagem.Text))
                        {
                        <div class="message @(mensagem.IsFromCustomer ? "message-inbound" : "message-outbound")
                                    @(mensagem.IsTemplate ? "message-template" : "")">

                            @if (IsGrupo && mensagem.IsFromCustomer && !string.IsNullOrWhiteSpace(mensagem.SenderName))
                            {
                                <div class="message-sender-name">@mensagem.SenderName</div>
                            }

                             @if (IsMediaMessage(mensagem))
                             {
                                      <div class="message-media">
                                      @{
                                          var mediaUrl = GetSafeMediaUrl(mensagem.MediaUrl);
                                          var displayUrl = GetMediaDisplayUrl(mensagem);
                                      }
                                     @if (string.IsNullOrEmpty(mediaUrl))
                                     {
                                         <FluentLabel Style="opacity: 0.8;">Mídia indisponível.</FluentLabel>
                                     }
                                      else if (IsImageMedia(mensagem))
                                      {
                                          <button type="button" class="message-media-preview-button" title="Visualizar e baixar imagem"
                                                  @onclick="() => OpenMediaImageAsync(mensagem)">
                                              <img src="@displayUrl"
                                                   alt="@mensagem.MediaCaption" />
                                          </button>
                                      }
                                     else if (IsVideoMedia(mensagem))
                                     {
                                         <video controls preload="metadata" playsinline>
                                             <source src="@displayUrl" type="@GetMediaMimeType(mensagem, Consts.Midia.MimeVideoDefault)">
                                         </video>
                                     }
                                     else if (IsAudioMedia(mensagem))
                                     {
                                         <audio controls preload="metadata">
                                             <source src="@displayUrl" type="@GetMediaMimeType(mensagem, Consts.Midia.MimeAudioDefault)">
                                         </audio>
                                     }
                                     else
                                     {
                                         var mediaFileName = GetMediaFileName(mensagem);
                                         <FluentStack Orientation="Orientation.Horizontal"
                                                      VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8"
                                                      Style="padding: 8px; background: rgba(0,0,0,0.05); border-radius: 8px;">
                                             <FluentIcon Icon="@(Icons.Regular.Size24.Document)" />
                                              <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                                                  <FluentLabel Weight="FontWeight.Bold">Documento</FluentLabel>
                                                  <FluentLabel>@mediaFileName</FluentLabel>
                                              </FluentStack>
                                              <FluentButton Appearance="Appearance.Stealth"
                                                            Disabled="@_isDownloadingDocument"
                                                            @onclick="() => DownloadDocumentAsync(mensagem)"
                                                            class="message-media-download"
                                                            Title="Baixar arquivo">
                                                  @if (_isDownloadingDocument)
                                                  {
                                                      <FluentProgressRing Style="width: 16px; height: 16px;" />
                                                  }
                                                  else
                                                  {
                                                      <FluentIcon Icon="@(Icons.Regular.Size16.ArrowDownload)" />
                                                  }
                                              </FluentButton>
                                          </FluentStack>
                                      }

                                     @if (!string.IsNullOrEmpty(mensagem.MediaCaption))
                                     {
                                         <div class="media-caption">@FormatMessageContent(mensagem.MediaCaption)</div>
                                     }
                                 </div>
                             }

                            @if (!string.IsNullOrEmpty(mensagem.Text))
                            {
                                <div class="message-text">
                                    @if (mensagem.IsTemplate)
                                     {
                                         <FluentStack Orientation="Orientation.Horizontal"
                                                      VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4"
                                                      Style="margin-bottom: 4px; opacity: 0.8;">
                                            <FluentIcon Icon="@(Icons.Regular.Size12.Headphones)" />
                                             <FluentLabel Typo="Typography.Body" Style="opacity: 0.8;">Template: @mensagem.TemplateName</FluentLabel>
                                         </FluentStack>
                                     }
                                     @FormatMessageContent(mensagem.Text)
                                 </div>
                             }

                            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right"
                                         VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4"
                                         Class="message-time"
                                         Style="opacity: 0.8; margin-top: 4px;">
                                <FluentLabel Typo="Typography.Body" Style="opacity: 0.8;">@ToBrazilTime(mensagem.ReceivedAt).ToString("HH:mm")</FluentLabel>
                                @if (mensagem.IsToCustomer)
                                {
                                    @switch (mensagem.Status)
                                    {
                                        case MessageStatus.Enviada:
                                            <FluentIcon Icon="@(Icons.Regular.Size16.Checkmark)" Title="Enviada" />
                                            break;
                                        case MessageStatus.Entregue:
                                            <FluentIcon Icon="@(Icons.Regular.Size16.Send)" Title="Entregue" />
                                            break;
                                        case MessageStatus.Lida:
                                            <FluentIcon Icon="@(Icons.Regular.Size16.Send)" Title="Lida" />
                                            break;
                                        case MessageStatus.Falha:
                                            <FluentIcon Icon="@(Icons.Regular.Size16.DismissCircle)" Class="status-error" Title="Falha" />
                                            break;
                                    }
                                }
                            </FluentStack>
                        </div>
                        }
                    }
                }
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalAlignment="VerticalAlignment.Center" Style="flex-grow: 1;" VerticalGap="8">
                    <FluentIcon Icon="@(Icons.Regular.Size48.Chat)" Color="Color.Lightweight" />
                    <FluentLabel Color="Color.Lightweight">Nenhuma mensagem ainda</FluentLabel>
                    <FluentLabel Color="Color.Lightweight">Inicie a conversa enviando uma mensagem abaixo</FluentLabel>
                </FluentStack>
            }

            @if (IsTyping && CurrentAtendimento?.Cliente != null)
            {
                <div class="typing-indicator">
                    <div class="typing-dots">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <FluentLabel>@CurrentAtendimento.Cliente.Nome esta digitando...</FluentLabel>
                </div>
            }
        </div>

        @if (StatusEnum == AtendimentoStatusEnum.Finalizado)
        {
            <div class="finalizado-banner">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6">
                    <FluentIcon Icon="@(Icons.Regular.Size16.CheckmarkCircle)" Style="color: var(--colorStatusSuccessBorderActive, #107c10);" />
                    <FluentLabel Weight="FontWeight.Bold" Style="color: var(--colorStatusSuccessBorderActive, #107c10);">Atendimento encerrado</FluentLabel>
                </FluentStack>
                @if (CurrentAtendimento!.DataFim.HasValue)
                {
                    var dataFimBr = ToBrazilTime(CurrentAtendimento.DataFim.Value);
                    <FluentLabel>Encerrado em @dataFimBr.ToString("dd/MM/yyyy") às @dataFimBr.ToString("HH:mm")</FluentLabel>
                }
                @if (!string.IsNullOrEmpty(CurrentAtendimento!.ComentarioAvaliacao))
                {
                    <FluentLabel>Motivo: @CurrentAtendimento.ComentarioAvaliacao</FluentLabel>
                }
                @if (CurrentAtendimento!.ValorVenda.HasValue)
                {
                    <FluentLabel>Valor da venda: @CurrentAtendimento.ValorVenda.Value.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</FluentLabel>
                }
                @if (!string.IsNullOrEmpty(CurrentAtendimento!.ComprovanteUrl))
                {
                    <a href="@CurrentAtendimento.ComprovanteUrl" target="_blank" rel="noopener noreferrer"
                       class="comprovante-link">
                        <FluentIcon Icon="@(Icons.Regular.Size16.Image)" />
                        Ver comprovante
                    </a>
                }
            </div>
        }

        @if (IsGrupo)
        {
            <div class="pending-banner">
                <FluentIcon Icon="@(Icons.Regular.Size16.Info)" />
                <FluentLabel Style="flex: 1;">
                    Mensagem de grupo disponível apenas para visualização. Ela não gera cliente potencial nem entra no fluxo de atendimento.
                </FluentLabel>
            </div>
        }
        else if (StatusEnum == AtendimentoStatusEnum.Pendente)
        {
            <div class="pending-banner">
                <FluentIcon Icon="@(Icons.Regular.Size16.Info)" />
                <FluentLabel Style="flex: 1;">
                    @(IsGestor
                        ? "Gestores não podem assumir atendimentos. Transfira para um atendente."
                        : "Este atendimento ainda não foi assumido. Assuma-o para poder responder.")
                </FluentLabel>
                @if (!IsGestor)
                {
                    <FluentButton Appearance="Appearance.Accent"
                                  @onclick="@(() => OnAssumirRequested.InvokeAsync(CurrentAtendimento))">
                        <FluentIcon Icon="@(Icons.Regular.Size16.Headphones)" Slot="start" Color="Color.Fill" />
                        Assumir
                    </FluentButton>
                }
            </div>
        }

        @if (StatusEnum == AtendimentoStatusEnum.EmAndamento)
        {
            @if (!IsAssignedAttendant)
            {
                <div class="locked-banner">
                    <FluentIcon Icon="@(Icons.Regular.Size16.LockClosed)" />
                    <FluentLabel Style="flex: 1;">
                        @if (IsGestor)
                        {
                            @:Gestores não podem enviar mensagens. Transfira o atendimento para um atendente.
                        }
                        else
                        {
                            @:Este atendimento está em andamento por outro atendente. Assuma-o para poder responder.
                        }
                    </FluentLabel>
                    @if (IsAdministrador)
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      @onclick="@(() => OnAssumirRequested.InvokeAsync(CurrentAtendimento))">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Headphones)" Slot="start" />
                            Assumir para mim
                        </FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      @onclick="@(() => OnTransferirRequested.InvokeAsync(CurrentAtendimento))">
                            <FluentIcon Icon="@(Icons.Regular.Size16.ArrowSwap)" Slot="start" />
                            Transferir
                        </FluentButton>
                    }
                </div>
            }
            else
            {
            <div class="chat-input-bar">
                <div style="display: flex; gap: 4px; flex-shrink: 0; align-items: center;">
                    <FluentMenu>
                        <FluentButton Appearance="Appearance.Stealth" Title="Anexar arquivo">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Attach)" />
                        </FluentButton>
                        <FluentMenuItem @onclick="UploadImage">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Image)" Slot="start" />
                            Imagem
                        </FluentMenuItem>
                        <FluentMenuItem @onclick="UploadDocument">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Document)" Slot="start" />
                            Documento
                        </FluentMenuItem>
                        <FluentMenuItem @onclick="SendLocationRequest">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Location)" Slot="start" />
                            Solicitar localizacao
                        </FluentMenuItem>
                    </FluentMenu>

                    <FluentMenu>
                        <FluentButton Appearance="Appearance.Stealth" Title="Inserir emoji">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Emoji)" />
                        </FluentButton>
                        <FluentMenuItem @onclick='() => InsertEmoji("😊")'>
                            <span style="font-size: 18px;">😊</span> Smile
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("👍")'>
                            <span style="font-size: 18px;">👍</span> OK
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("✅")'>
                            <span style="font-size: 18px;">✅</span> Check
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("❌")'>
                            <span style="font-size: 18px;">❌</span> X
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("❤️")'>
                            <span style="font-size: 18px;">❤️</span> Heart
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("🙏")'>
                            <span style="font-size: 18px;">🙏</span> Thanks
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("💊")'>
                            <span style="font-size: 18px;">💊</span> Medicine
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("🧬")'>
                            <span style="font-size: 18px;">🧬</span> RX
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("📍")'>
                            <span style="font-size: 18px;">📍</span> Location
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("📷")'>
                            <span style="font-size: 18px;">📷</span> Camera
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("💰")'>
                            <span style="font-size: 18px;">💰</span> Money
                        </FluentMenuItem>
                        <FluentMenuItem @onclick='() => InsertEmoji("⏰")'>
                            <span style="font-size: 18px;">⏰</span> Time
                        </FluentMenuItem>
                    </FluentMenu>
                </div>

                <FluentTextField @key="@_messageInputRenderKey"
                                @ref="messageInput"
                                @bind-Value="MessageText"
                                Immediate="true"
                                Placeholder="Digite sua mensagem..."
                                Style="flex: 1; min-width: 0;"
                                @onkeypress="HandleKeyPress">
                </FluentTextField>

                <FluentButton Appearance="Appearance.Stealth"
                             Title="Mensagens pré-definidas"
                             Style="flex-shrink: 0; align-self: center; color: #f0a500;"
                             @onclick="OpenMensagensPreDefinidas">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Flash)" Style="color: #f0a500;" />
                </FluentButton>

                <FluentButton Appearance="Appearance.Accent"
                             Title="Enviar mensagem"
                             Disabled="@(!CanSendMessage || IsSending)"
                             Style="flex-shrink: 0; align-self: center;"
                             @onclick="SendMessage">
                    @if (IsSending)
                    {
                        <FluentProgressRing Style="width: 16px; height: 16px;" />
                    }
                    else
                    {
                        <FluentIcon Icon="@(Icons.Regular.Size16.Send)" Color="Color.Fill" />
                    }
                </FluentButton>
            </div>
            }
        }

        @if (ShowClienteInfo && CurrentAtendimento?.Cliente != null)
        {
            <FluentCard Class="cliente-info-panel">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                             Style="padding: 12px 16px; border-bottom: 1px solid var(--neutral-stroke-rest); flex-shrink: 0;">
                    <FluentLabel Typo="Typography.Subject" Style="flex: 1;">Informações do Cliente</FluentLabel>
                    <FluentButton Appearance="Appearance.Stealth" @onclick="ToggleClienteInfo">
                        <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" />
                    </FluentButton>
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16"
                             Style="padding: 16px; overflow-y: auto; flex-grow: 1;">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentLabel Weight="FontWeight.Bold">Contato</FluentLabel>
                        <FluentLabel><strong>@(CurrentAtendimento.CanalEnum.ToString()):</strong> @CurrentAtendimento.Cliente.WhatsAppId.FormatContactId(CurrentAtendimento.CanalEnum)</FluentLabel>
                        <FluentLabel><strong>Telefone:</strong> @CurrentAtendimento.Cliente.Telefone.FormatTelefone()</FluentLabel>
                        <FluentLabel><strong>Email:</strong> @CurrentAtendimento.Cliente.Email</FluentLabel>
                    </FluentStack>

                    @if (!string.IsNullOrEmpty(CurrentAtendimento.Cliente.Endereco))
                    {
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                            <FluentLabel Weight="FontWeight.Bold">Endereco</FluentLabel>
                            <FluentLabel>@CurrentAtendimento.Cliente.Endereco</FluentLabel>
                            <FluentLabel>@CurrentAtendimento.Cliente.Cidade - @CurrentAtendimento.Cliente.Estado</FluentLabel>
                            <FluentLabel>CEP: @CurrentAtendimento.Cliente.Cep</FluentLabel>
                        </FluentStack>
                    }

                    @if (CurrentAtendimento.Cliente.UsoContinuo)
                    {
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                            <FluentLabel Weight="FontWeight.Bold">Medicamentos Continuos</FluentLabel>
                            <FluentLabel>@CurrentAtendimento.Cliente.MedicamentosContinuos</FluentLabel>
                        </FluentStack>
                    }

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentLabel Weight="FontWeight.Bold">Estatisticas</FluentLabel>
                        <FluentLabel><strong>Total de atendimentos:</strong> @CurrentAtendimento.Cliente.TotalAtendimentos</FluentLabel>
                        <FluentLabel><strong>Ultimo contato:</strong> @CurrentAtendimento.Cliente.UltimoContato?.ToString("dd/MM/yyyy HH:mm")</FluentLabel>
                        <FluentLabel><strong>Data de cadastro:</strong> @CurrentAtendimento.Cliente.DataCadastro.ToString("dd/MM/yyyy")</FluentLabel>
                    </FluentStack>

                    @if (StatusEnum == AtendimentoStatusEnum.Finalizado)
                    {
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4"
                                     Style="padding: 10px 12px; background: var(--colorStatusSuccessBackground2, rgba(0,128,0,0.08)); border-left: 3px solid var(--colorStatusSuccessBorderActive, #107c10); border-radius: 4px;">
                            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="6">
                                <FluentIcon Icon="@(Icons.Regular.Size16.CheckmarkCircle)" Style="color: var(--colorStatusSuccessBorderActive, #107c10);" />
                                <FluentLabel Weight="FontWeight.Bold" Style="color: var(--colorStatusSuccessBorderActive, #107c10);">Encerramento</FluentLabel>
                            </FluentStack>
                            @if (CurrentAtendimento.DataFim.HasValue)
                            {
                                <FluentLabel><strong>Data/hora:</strong> @ToBrazilTime(CurrentAtendimento.DataFim.Value).ToString("dd/MM/yyyy HH:mm")</FluentLabel>
                            }
                            @if (!string.IsNullOrEmpty(CurrentAtendimento.ComentarioAvaliacao))
                            {
                                <FluentLabel><strong>Motivo:</strong> @CurrentAtendimento.ComentarioAvaliacao</FluentLabel>
                            }
                            @if (CurrentAtendimento.ValorVenda.HasValue)
                            {
                                <FluentLabel><strong>Valor da venda:</strong> @CurrentAtendimento.ValorVenda.Value.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</FluentLabel>
                            }
                            @if (!string.IsNullOrEmpty(CurrentAtendimento.ComprovanteUrl))
                            {
                                <a href="@CurrentAtendimento.ComprovanteUrl" target="_blank" rel="noopener noreferrer"
                                   class="comprovante-link">
                                    <FluentIcon Icon="@(Icons.Regular.Size16.Image)" />
                                    Ver comprovante
                                </a>
                            }
                        </FluentStack>
                    }

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        <FluentButton Appearance="Appearance.Outline" @onclick="EditarCliente">
                            <FluentIcon Icon="@(Icons.Regular.Size16.Edit)" Slot="start" />
                            Editar Cliente
                        </FluentButton>
