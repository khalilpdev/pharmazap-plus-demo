// PharmazapPlus.API/appsettings.json (Produção)
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    // Defina via variável de ambiente: ConnectionStrings__DefaultConnection
    "DefaultConnection": "",
    "Redis": "redis:6379,abortConnect=false"
  },
  "WhatsApp": {
    "UseRealApi": false,
    "PhoneNumberId": "",
    "AccessToken": "",
    "ApiVersion": "v18.0",
    "ApiBaseUrl": "https://graph.facebook.com",
    "NonOfficialApiUrl": "http://localhost:8080",
    // Defina via variável de ambiente: WhatsApp__WebhookVerifyToken
    "WebhookVerifyToken": "",
    "DevelopmentMode": false,
    "MockMessages": false,
    "Templates": {
      "welcome": "bemvindo_farmacia",
      "appointment_reminder": "lembrete_consulta",
      "medicine_ready": "medicamento_pronto",
      "promotion": "promocao_farmacia",
      "payment_reminder": "lembrete_pagamento"
    }
  },
  "MessageQueue": {
    "ProcessingInterval": 5000,
    "MaxBatchSize": 10,
    "RetryAttempts": 3,
    "Queues": [ "new-messages", "notifications", "agendamentos", "webhooks" ]
  },
  "SignalR": {
    "KeepAliveInterval": 15,
    "ClientTimeoutInterval": 30,
    "MaxMessageSize": 1048576
  },
  "Application": {
    "Name": "Pharmazap Plus",
    "Version": "1.0.0",
    "Environment": "Production",
    "BaseUrl": "https://api.pharmazapplus.com",
    "WebUrl": "https://app.pharmazapplus.com",
    "WebhookUrl": "https://webhook.pharmazapplus.com"
  },
  "HealthMonitor": {
    "Enabled": true,
    "CheckIntervalSeconds": 60,
    "FailureThreshold": 3,
    "AlertCooldownMinutes": 30,
    "NotifyViaWhatsApp": true,
    "NotifyViaEmail": true,
    "AdminWhatsAppNumbers": [],
    "AdminEmails": [],
    "FetchAdminsFromDatabase": true,
    "ServerName": "PharmazapPlus API",
    "SystemFarmaciaId": "0"
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "alerts@pharmazapplus.com",
    "FromName": "PharmazapPlus Monitor"
  },
  "AllowedHosts": "*",
  "Encryption": {
    "Key": ""
  }
}
