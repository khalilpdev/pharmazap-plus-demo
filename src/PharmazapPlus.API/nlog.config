<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <targets>
    <target name="coloredConsole" xsi:type="ColoredConsole" useDefaultRowHighlightingRules="false"
        layout="${longdate}|${pad:padding=5:inner=${level:uppercase=true}}|${logger:shortName=true}|${message}" >
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="DarkGray" />
      <highlight-row condition="level == LogLevel.Info" foregroundColor="Green" />
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
    </target>

    <target name="logFile" xsi:type="File"
            layout="${longdate} ${pad:padding=5:inner=${level:uppercase=true}} ${logger:shortName=true} ${message}${onexception:inner= ${exception:format=tostring}}"
            fileName="${gdc:item=LogDirectory}/pharmazapplus-${shortdate}.log"
            keepFileOpen="false"
            concurrentWrites="true"
            createDirs="true"
            encoding="utf-8" />
  </targets>

  <rules>
    <!-- Reduzir verbosidade dos logs do Microsoft/System no arquivo -->
    <logger name="Microsoft.*" minlevel="Warning" writeTo="logFile" final="true" />
    <logger name="System.*" minlevel="Warning" writeTo="logFile" final="true" />

    <!-- Todos os loggers: Debug+ para console, Info+ para arquivo -->
    <logger name="*" minlevel="Debug" writeTo="coloredConsole" />
    <logger name="*" minlevel="Info" writeTo="logFile" />
  </rules>
</nlog>
